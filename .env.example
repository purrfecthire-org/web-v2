# Purrfect Hire V2 — environment variables (copy to .env; never commit .env)
# All PUBLIC_* vars are exposed to the client bundle at build time.

# Base URL of the ATS backend logging API. When set, Layout.astro's client-side
# error reporter POSTs uncaught errors to {PUBLIC_LOG_ENDPOINT}/logs/client.
# Leave unset/empty (the default) to disable the reporter entirely — the site
# then makes no logging requests. Public roles use their separately configured API.
# PUBLIC_LOG_ENDPOINT=https://api.purrfecthire.com

# Base URL of the ATS backend API (e.g. https://api.purrfecthire.com, or
# http://localhost:8000 in dev). When set, it drives:
#   • the Offer Acceleration apply form → POST {}/public/oa/applications
#   • the /roles list + /roles/<slug> detail pages, fetched at build time
#     (GET {}/public/roles, GET {}/public/roles/{slug}) and refreshed
#     client-side, plus the apply form → POST {}/public/roles/{slug}/applications
# With an API configured, a build-time fetch failure stops deployment so an
# outage cannot remove existing role pages. A valid empty list shows no openings.
# Leave unset/empty (the local default) to disable this API — the OA
# form uses its fallback branch and the roles list shows its empty state.
# PUBLIC_API_ENDPOINT=https://ats-backend-mu.vercel.app

# Analytics. Set PUBLIC_ANALYTICS_SRC to turn measurement on; leave it unset
# (the default) and no analytics requests or analytics cookies are added.
#
# Plausible issues a snippet per site: copy the script URL from Site
# Installation › General in the account. It is not the same for every site, so
# it cannot be hardcoded. The newer per-site script needs no data-domain; the
# older shared script does. Set PUBLIC_ANALYTICS_DOMAIN only if the snippet in
# your account includes data-domain.
#
# plausible.init() is called automatically on script load when the script
# exposes it, and skipped when it does not.
#
# Pageviews come from the script; CTA clicks are sent as a "cta" event carrying
# only data-cta and data-journey, never personal data.
#   PUBLIC_ANALYTICS_SRC=https://plausible.io/js/<your-site-snippet>.js
#   PUBLIC_ANALYTICS_DOMAIN=purrfecthire.com
#   PUBLIC_ANALYTICS_NAME=Plausible Analytics
# The privacy policy's measurement section is driven by the same flag, so the
# site cannot measure while the policy says it does not.

# B2B intake: a public server adapter endpoint, once its contract is deployed.
# Do not reuse /public/oa/leads. No endpoint is assumed by this branch.
# Without this value, /search-read offers the working founders calendar.
# See docs/search-read-integration.md for the required request/response.
# PUBLIC_B2B_LEAD_ENDPOINT=
