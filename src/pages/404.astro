---
import Shell from '../components/v2/Shell.astro';
import CatIllustration from '../components/v2/CatIllustration.astro';
---

<Shell
  title="Page not available | Purrfect Hire"
  description="Find current openings or choose the right path at Purrfect Hire."
  canonicalUrl="https://purrfecthire.com/404.html"
  theme="light"
  noindex
>
  <section class="h3-hero not-found h3-surface h3-editorial-hero" aria-labelledby="not-found-title">
    <div class="h3-wrap not-found__layout">
      <div class="not-found__copy">
      <p class="h3-eyebrow">404</p>
      <h1 class="h3-hero__h1" id="not-found-title">Page not available.</h1>
      <p class="h3-hero__sub">This page may have moved or is no longer available. Find current openings or choose the right path below.</p>
      <nav class="h3-hero__cta not-found__paths" aria-label="Continue browsing">
        <a class="h3-btn" href="/roles/">View open roles<span aria-hidden="true">→</span></a>
        <a class="h3-link" href="/for-companies/">For companies<span aria-hidden="true">→</span></a>
        <a class="h3-link" href="/for-talent/">For talent<span aria-hidden="true">→</span></a>
      </nav>
      </div>
      <CatIllustration pose="rest" />
    </div>
  </section>
</Shell>

<style>
  .not-found { min-height: calc(100svh - var(--space-section)); box-sizing: border-box; }
  .not-found__layout { display: grid; gap: var(--space-grid); align-items: center; }
  .not-found__copy { min-width: 0; }
  .not-found__paths { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-stack); }
  @media (min-width: 56rem) {
    .not-found__layout { grid-template-columns: minmax(0, 1fr) minmax(0, calc(var(--space-8) * 4)); }
  }
</style>
