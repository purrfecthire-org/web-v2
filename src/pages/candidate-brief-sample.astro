---
import Shell from '../components/v2/Shell.astro';
import { getCandidateBriefSample, SEARCH_CALIBRATION_CTA } from '../content/searchCalibration';

const t = getCandidateBriefSample('en');
---

<Shell
  lang="en"
  title={t.meta.title}
  description={t.meta.description}
  theme="light"
  navCta={{ label: t.close.cta, href: SEARCH_CALIBRATION_CTA }}
  journey="companies"
>
  <div class="cb-page" data-product="candidate-brief-sample">
    <section class="h3-hero cb-hero" aria-labelledby="cb-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1 cb-hero__title" id="cb-title">{t.hero.headline}</h1>
        <p class="h3-hero__sub cb-hero__body">{t.hero.body}</p>
        <p class="cb-disclosure">{t.hero.disclosure}</p>
      </div>
    </section>

    <section class="cb-example" aria-labelledby="cb-document-title">
      <div class="h3-wrap">
        <article class="cb-document">
          <header class="cb-document__header">
            <p class="h3-eyebrow">{t.document.label}</p>
            <h2 id="cb-document-title">{t.document.title}</h2>
            <dl class="cb-facts">
              {t.document.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
            </dl>
          </header>
          <div class="cb-document__sections">
            {t.document.sections.map((section) => <section><h3>{section.title}</h3><p>{section.body}</p></section>)}
          </div>
          <p class="cb-document__footer">{t.document.footer}</p>
        </article>
      </div>
    </section>

    <section class="cb-close" aria-labelledby="cb-close-title">
      <div class="h3-wrap">
        <h2 class="h3-h2 cb-close__title" id="cb-close-title">{t.close.headline}</h2>
        <p class="h3-body cb-close__body">{t.close.body}</p>
        <a href={SEARCH_CALIBRATION_CTA} data-cta="candidate-brief-search-read" class="h3-btn h3-btn--ink cb-close__cta">
          {t.close.cta}<span class="h3-arrow" aria-hidden="true">→</span>
        </a>
        <a href={t.close.backHref} data-cta="candidate-brief-search-calibration" class="h3-link cb-close__back">
          {t.close.back}<span class="h3-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Shell>

<style lang="scss">
  .cb-hero__title { max-width: 18ch; }
  .cb-hero__body { max-width: 43rem; }
  .cb-disclosure { margin-top: 1.75rem; max-width: 48rem; padding: 1rem 1.25rem; background: var(--stone); border: 1px solid var(--line); border-radius: 10px; font-size: 0.9375rem; font-weight: 500; line-height: 1.65; }
  .cb-example { padding: 0 0 clamp(3.5rem, 6vw, 6.5rem); }
  .cb-document { max-width: 64rem; background: var(--white); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .cb-document__header { padding: clamp(1.5rem, 4vw, 3rem); border-bottom: 1px solid var(--line); }
  .cb-document__header h2 { margin: 0.9rem 0 0; font-family: var(--h-serif); font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 400; line-height: 1.1; letter-spacing: -0.015em; }
  .cb-facts { display: grid; gap: 1.25rem 2rem; margin: 2rem 0 0; }
  .cb-facts dt { font-size: 0.75rem; color: var(--muted); font-weight: 500; }
  .cb-facts dd { margin: 0.35rem 0 0; font-size: 0.9375rem; line-height: 1.5; }
  .cb-document__sections { display: grid; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); }
  .cb-document__sections section { min-width: 0; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .cb-document__sections h3 { margin: 0; font-size: 1.0625rem; font-weight: 500; line-height: 1.4; }
  .cb-document__sections p { margin-top: 0.75rem; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .cb-document__sections section:last-child { grid-column: 1 / -1; padding: 1.5rem; border-top: 0; border-radius: 10px; background: var(--sand); }
  .cb-document__footer { padding: 0 clamp(1.5rem, 4vw, 3rem) 2rem; color: var(--muted); font-size: 0.8125rem; line-height: 1.65; }
  .cb-close { padding-block: clamp(3.5rem, 6vw, 6.5rem); border-top: 1px solid var(--line); background: var(--stone); }
  .cb-close__title { max-width: 27ch; }
  .cb-close__body { margin-top: 1.5rem; max-width: 40rem; }
  .cb-close__cta { margin-top: 2rem; max-width: 100%; text-align: center; line-height: 1.35; }
  .cb-close__back { display: flex; width: fit-content; margin-top: 1.5rem; max-width: 100%; }
  @media (min-width: 48rem) {
    .cb-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cb-document__sections { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media print {
    @page { size: A4; margin: 12mm; }
    :global(.h3-nav), :global(.h3-footer) { display: none !important; }
    .cb-hero { padding: 0 0 0.6rem; }
    .cb-hero__title { max-width: none; font-size: 20pt; }
    .cb-hero__body { display: none; }
    .cb-disclosure { margin-top: 0.6rem; padding: 0.5rem; font-size: 8pt; }
    .cb-example { padding: 0; }
    .cb-example > div, .cb-hero > div { max-width: none; padding: 0; }
    .cb-document { max-width: none; border-radius: 0; }
    .cb-document__header { padding: 0.75rem; }
    .cb-document__header h2 { margin-top: 0.4rem; font-size: 17pt; }
    .cb-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 0.75rem; gap: 1rem; }
    .cb-facts dt, .cb-facts dd { font-size: 8pt; }
    .cb-document__sections { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem 1.25rem; padding: 0.75rem; }
    .cb-document__sections section { break-inside: avoid; padding-top: 0.5rem; }
    .cb-document__sections h3 { font-size: 9pt; }
    .cb-document__sections p { margin-top: 0.3rem; font-size: 8pt; line-height: 1.45; }
    .cb-document__sections section:last-child { padding: 0.65rem; }
    .cb-document__footer { padding: 0 0.75rem 0.75rem; font-size: 7pt; }
    .cb-close { display: none; }
  }
</style>
