---
import Shell from '../../components/v2/Shell.astro';
import RoleDetailV2 from '../../components/roles-v2/RoleDetailV2.astro';
import { getRolesSnapshot } from '../../components/roles-v2/snapshot';
import type { PublicRoleDetail } from '../../lib/roles';

export async function getStaticPaths() {
  const { roles } = await getRolesSnapshot();
  return roles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

interface Props { role: PublicRoleDetail }
const { role } = Astro.props;
const excerpt = role.public_description
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/[#>*_~`|]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const description = excerpt.length > 180 ? `${excerpt.slice(0, 177).trimEnd()}…` : excerpt;
---

<Shell title={`${role.title} | Purrfect Hire`} description={description || `Read the requirements and apply for ${role.title} through Purrfect Hire.`} theme="light" journey="talent">
  <RoleDetailV2 role={role} />
</Shell>
