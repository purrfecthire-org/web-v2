---
// ── /offer-acceleration/preguntas · OA lead-capture variant A ────────────
// "Las cinco preguntas": the questions a recruiter answers about a candidate
// from the profile alone, before ever writing to them. Every question must
// stay answerable from a LinkedIn profile — that constraint is the whole
// premise, so do not add questions about salary expectations or referrals.
//
// NOINDEX and intentionally unlinked from the nav: the audience arrives from
// a specific LinkedIn post (see `audience` in the content file).
import OALeadShell from '../../components/oa-lead/OALeadShell.astro';
import { oaPreguntas as c } from '../../content/oaLeadForms';
---

<OALeadShell
  variant={c.variant}
  meta={c.meta}
  hero={c.hero}
  apply={c.apply}
  form={c.form}
  footer={c.footer}
>
  <section class="pre">
    <ol class="pre__list">
      {c.questions.map((item, i) => (
        <li class="pre__item reveal">
          <span class="pre__num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="pre__q">{item.q}</h2>
            <p class="pre__body">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</OALeadShell>

<style lang="scss">
  @use '../../styles/breakpoints.scss' as *;

  .pre {
    padding: 2.5rem 0 0;
    border-top: 1px solid var(--line);

    &__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1rem;
    }

    &__item {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg);
      padding: 1.25rem 1.4rem;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1rem;

      @include max-sm {
        grid-template-columns: 1fr;
        gap: 0.25rem;
      }
    }

    &__num {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      padding-top: 0.2rem;
    }

    /* The question is what a scanner reads: larger and in ink, with the
       explanation demoted to small muted text. Weight stays at 500, the
       heaviest the design system loads. */
    &__q {
      font-size: 1.2rem;
      font-weight: 500;
      line-height: 1.35;
      letter-spacing: -0.01em;
      margin: 0 0 0.4rem;
      color: var(--ink);
      text-wrap: balance;
    }

    &__body {
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--muted);
      margin: 0;
    }
  }
</style>
