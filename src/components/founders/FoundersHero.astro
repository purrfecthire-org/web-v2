---
// ── For Founders — Hero ──────────────────────────────────────────────────
// Isolated design test. Mirrors the V6 visual language (warm-cream canvas,
// purple accent, glass cards, pill CTAs) but is self-contained under the
// `ff-` (for-founders) prefix so nothing here leaks into the shared system.
//
// The first second has to land the proof, not the pitch: founders arriving
// from the main site are busy operators. Proof only counts with a name on
// it, so the hero cards are real client quotes with name, role and company;
// anonymous outcome claims were dropped.
const BOOKING_URL = 'https://calendly.com/purrfecthire/5';

const proof = [
  {
    headline: 'Hired for culture fit. Promoted for it.',
    quote:
      'The people we\'ve hired through Purrfect Hire didn\'t just continue working. They were promoted to roles of greater responsibility because of how well they adapted to our culture.',
    name: 'Micaela Crosta',
    role: 'Head of Customer Operations, OutDo (US)',
  },
  {
    headline: 'A search partner, not a pipeline.',
    quote:
      'Purrfect Hire adapted to our processes and to each specific role. They\'re a real search partner, not just a pipeline.',
    name: 'Fabián Torres',
    role: 'CEO, Trébol (CO)',
  },
];
---

<section id="hero" data-section="hero" class="ff-hero">
  <div class="ff-hero__container">

    <header class="ff-hero__head">
      <h1 class="ff-hero__headline">
        You need hires that stay.
      </h1>
      <p class="ff-hero__sub body1">
        Senior LATAM talent at YC, a16z and Sequoia backed startups.
      </p>
    </header>

    <!-- Two named client quotes, sized to read in under a second -->
    <div class="ff-hero__proof">
      {proof.map((p) => (
        <article class="ff-hero__card">
          <h2 class="ff-hero__card-headline">{p.headline}</h2>
          <blockquote class="ff-hero__card-quote">"{p.quote}"</blockquote>
          <div class="ff-hero__card-foot">
            <span class="ff-hero__card-name">{p.name}</span>
            <span class="ff-hero__card-role">{p.role}</span>
          </div>
        </article>
      ))}
    </div>

    <div class="ff-hero__ctas">
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="ff-hero__cta ff-hero__cta--primary">
        Talk to our team →
      </a>
      <a href="#metrics" class="ff-hero__cta ff-hero__cta--ghost">See the numbers</a>
    </div>

  </div>
</section>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  $accent: #29285F;

  .ff-fade {
    opacity: 0;
    transform: translateY(24px);
    animation: ff-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .ff-hero {
    position: relative;
    z-index: 1;
    padding-top: 9rem;
    padding-bottom: 5rem;
    min-height: 100svh;
    display: flex;
    align-items: center;

    @include max-md {
      padding-top: 7rem;
      padding-bottom: 3.5rem;
      min-height: auto;
    }

    &__container {
      width: 100%;
      max-width: 68rem;
      margin-inline: auto;
      padding-inline: 2rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;

      @include max-lg { padding-inline: 1.5rem; }
      @include max-sm { padding-inline: 1rem; gap: 2.25rem; }
    }

    &__head {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 46rem;

      // Phase 1 — header settles in first
      opacity: 0;
      animation: ff-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    }

    &__tag {
      align-self: flex-start;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fff;
      background: $accent;
      padding: 5px 14px;
      border-radius: var(--radius);
    }

    &__headline {
      font-size: clamp(2.4rem, 5.5vw, 4.25rem);
      font-weight: 800;
      line-height: 1.04;
      letter-spacing: -0.03em;
      color: var(--ink);
      margin: 0;
    }

    &__headline-accent {
      display: block;
      color: $accent;
    }

    &__sub {
      max-width: 40rem;
    }

    // ── Proof cards ──────────────────────────────────────────
    &__proof {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;

      @include max-md { grid-template-columns: 1fr; }
    }

    &__card {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      padding: 2.25rem;
      border: 1px solid var(--line);
      border-top: 4px solid $accent;
      border-radius: var(--radius);
      background: var(--bg-soft);

      // Phase 2 — proof cards rise after the header
      opacity: 0;
      animation: ff-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;

      &:nth-child(1) { animation-delay: 0.35s; }
      &:nth-child(2) { animation-delay: 0.5s; }

      @include max-sm { padding: 1.75rem; }
    }

    &__card-headline {
      font-size: 1.375rem;
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.015em;
      color: $accent;
      margin: 0;
    }

    &__card-quote {
      font-size: 0.9375rem;
      line-height: 1.6;
      font-style: italic;
      color: var(--color-text);
      margin: 0;
    }

    &__card-foot {
      margin-top: auto;
      padding-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      border-top: 1px solid var(--color-border);
    }

    &__card-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-text);
    }

    &__card-role {
      font-size: 0.8125rem;
      color: var(--color-muted);
    }

    // ── CTAs ─────────────────────────────────────────────────
    &__ctas {
      display: flex;
      align-items: center;
      gap: 1rem;
      opacity: 0;
      animation: ff-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;

      @include max-sm { flex-direction: column; align-items: stretch; }
    }

    &__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      font-size: 0.9375rem;
      font-weight: 500;
      border-radius: var(--radius);
      text-decoration: none;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;

      &--primary {
        background: $accent;
        color: #fff;
        &:hover { background: #1E1D47; }
      }

      &--ghost {
        background: transparent;
        color: var(--color-text);
        border: 1.5px solid var(--line);
        &:hover { background: $accent; color: #fff; border-color: $accent; }
      }
    }
  }

  @keyframes ff-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ff-hero__head,
    .ff-hero__card,
    .ff-hero__ctas {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
