---
// ── For Talent ───────────────────────────────────────────────────────────
// Talent entry: compare paid advisory paths or find free client searches.
// Ivory hero and a single Midnight testimonial moment. Purple for Talent
// actions; the founder journey uses its own conversion in the shared shell.
import Shell from '../v2/Shell.astro';
import ClientPortrait from '../v2/ClientPortrait.astro';
import type { Lang } from '../../content/index';
import { getTalentV2 } from '../../content/talentV2';
import { PAGE_OFFER } from '../../content/links';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getTalentV2(lang);
---

<Shell
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  theme="light"
  navCta={{ label: t.hero.cta, href: t.hero.href }}
  journey="talent"
>

      <!-- Hero -->
      <section class="h3-hero">
        <div class="h3-wrap h3-hero__grid">
          <div class="h3-hero__copy">
            <p class="h3-eyebrow">{t.hero.eyebrow}</p>
            <h1 class="h3-hero__h1 tv-h1">{t.hero.headline}</h1>
            <p class="h3-hero__sub">{t.hero.sub}</p>
            <p class="tv-audience">{t.hero.audience}</p>
            <a href={t.hero.href} data-cta="talent-hero-offer" class="h3-btn tv-hero__cta">
              {t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span>
            </a>
            <a href={t.hero.secondary.href} data-cta="talent-hero-compounding" class="h3-link tv-hero__secondary">{t.hero.secondary.label} <span aria-hidden="true">→</span></a>
            <a href={t.paths.free.href} class="tv-hero__free" data-cta="talent-hero-roles">{t.paths.free.cta} <span aria-hidden="true">→</span></a>
          </div>
          <figure class="h3-hero__media" style={{ "--photo-desktop": "4 / 3", "--photo-mobile": "4 / 3" }}>
<picture>
              <source media="(max-width: 55.99rem)" type="image/webp" srcset="/photos/web/talent-mobile.webp" />
              <source media="(max-width: 55.99rem)" srcset="/photos/web/talent-mobile.png" />
              <source type="image/webp" srcset="/photos/web/talent-desktop.webp" />
              <img src="/photos/web/talent-desktop.png" alt="Two people having a conversation at a desk." width="1200" height="900" decoding="async" fetchpriority="high" />
            </picture>
          </figure>
        </div>
      </section>

      <!-- Paths -->
      <section class="tv-paths" id="ways-in">
        <div class="h3-wrap">
          <p class="h3-eyebrow">{t.paths.eyebrow}</p>
          <h2 class="h3-h2 tv-paths__h2">{t.paths.headline}</h2>
          <ul class="tv-paths__list">
            {t.paths.items.map((i, idx) => (
              <li class={idx === 0 ? 'tv-path tv-path--flagship' : 'tv-path'}>
                <h3 class="tv-path__name">{i.name}</h3>
                {i.price && <p class="tv-path__price">{i.price}</p>}
                <p class="tv-path__body">{i.body}</p>
                <a href={i.href} data-cta={`talent-path-${idx}`} class="h3-link tv-path__cta">{i.cta} <span class="h3-arrow" aria-hidden="true">→</span></a>
                {i.note && <p class="tv-path__note">{i.note}</p>}
              </li>
            ))}
          </ul>
          <div class="tv-free">
            <p>{t.paths.free.body}</p>
            <a href={t.paths.free.href} data-cta="talent-free" class="h3-link tv-free__cta">
              {t.paths.free.cta} <span class="h3-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>


      <!-- Problem + what changes, one ivory surface -->
      <section class="tv-main">
        <div class="h3-wrap">
          <div class="tv-problem">
            <div class="tv-problem__head">
              <p class="h3-eyebrow">{t.problem.eyebrow}</p>
              <h2 class="h3-h2">
                {t.problem.headline}<span class="h3-dot h3-dot--end" aria-hidden="true"></span>
              </h2>
            </div>
            <p class="h3-body tv-problem__body">{t.problem.body}</p>
          </div>

          <div class="tv-work">
            <p class="h3-eyebrow">{t.work.eyebrow}</p>
            <h2 class="h3-h2 tv-work__h2">{t.work.headline}</h2>
            <ol class="tv-work__list">
              {t.work.items.map((i) => (
                <li>
                  <span class="h3-dot" aria-hidden="true"></span>
                  <div>
                    <h3 class="tv-work__title">{i.title}</h3>
                    <p class="tv-work__body">{i.body}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="tv-work__note">{t.work.note}</p>
            <a href={PAGE_OFFER} class="h3-link tv-work__cta">{t.work.cta} <span class="h3-arrow" aria-hidden="true">→</span></a>

            <aside class="tv-exercise" aria-labelledby="tv-exercise-title">
              <p class="h3-eyebrow">{t.work.example.label}</p>
              <h3 id="tv-exercise-title">{t.work.example.headline}</h3>
              <dl>
                {t.work.example.steps.map((step) => (
                  <div><dt>{step.title}</dt><dd>{step.body}</dd></div>
                ))}
              </dl>
            </aside>
          </div>

          <!-- Firewall, right after Create access -->
          <aside class="fw" aria-labelledby="tv-firewall-h">
            <h2 class="fw__h" id="tv-firewall-h">{t.firewall.headline}</h2>
            <p class="fw__lead">{t.firewall.lead}</p>
            <details class="fw__more">
              <summary>{t.firewall.more}</summary>
              <div>{t.firewall.body.map((b) => <p>{b}</p>)}</div>
            </details>
          </aside>
        </div>
      </section>

      <!-- Proof, the weighted dark moment. Daniel's words carry it on their
           own: the three outcome cases are out of this release until the
           facts and the written permissions are in. -->
      <section class="tv-proof">
        <div class="h3-wrap">
          <p class="h3-eyebrow h3-eyebrow--on-dark">{t.proof.eyebrow}</p>
          <h2 class="h3-h2 h3-h2--on-dark tv-proof__h2">{t.proof.headline}</h2>

          <figure class="tv-voice tv-voice--solo">
            <ClientPortrait alt={t.proof.voice.name} />
            <div class="tv-voice__copy">
            <blockquote>“{t.proof.voice.quote}”</blockquote>
            <figcaption>
              <span class="tv-voice__name">{t.proof.voice.name}</span>
              <span class="tv-voice__role">{t.proof.voice.role}</span>
            </figcaption>
            </div>
          </figure>
        </div>
      </section>

      <!-- Close -->
      <section class="tv-close">
        <div class="h3-wrap">
          <h2 class="h3-h2 tv-close__h2">{t.close.headline}</h2>
          <p class="h3-body tv-close__body">{t.close.body}</p>
          <a href={t.close.href} data-cta="talent-close-offer" class="h3-btn tv-close__cta">{t.close.cta}</a>
        </div>
      </section>

    </Shell>

<style lang="scss" is:global>
  /* ── Page-specific ───────────────────────────────────────────────── */
  .tv-h1 { margin-top: 1rem; }
  .tv-audience {
    margin-top: 1.5rem; font-size: 0.9375rem; color: var(--muted);
    max-width: 30rem; padding-top: 1.25rem; border-top: 1px solid var(--line);
  }
  .tv-hero__cta { margin-top: 2rem; }
  .tv-hero__secondary { margin-top: 1.25rem; font-size: 0.875rem; max-width: 31rem; line-height: 1.6; }
  .tv-path__price { margin-top: 0.75rem; font-size: 1.0625rem; font-weight: 500; color: var(--text); }

  /* One ivory surface carries problem, the four things, and the firewall. */
  .tv-main { background: var(--sand); padding: 5rem 0 6rem; }
  @media (min-width: 56rem) { .tv-main { padding: 6rem 0 7.5rem; } }
  .tv-problem { display: grid; gap: 1.75rem; align-items: start; }
  @media (min-width: 56rem) { .tv-problem { grid-template-columns: 1.05fr 1fr; gap: 4rem; } }
  .tv-problem__head { min-width: 0; }
  .tv-problem__head .h3-h2 { max-width: 16ch; }
  .tv-problem__body { max-width: 34rem; font-size: 1.1875rem; color: var(--text); }
  @media (min-width: 56rem) { .tv-problem__body { padding-top: 1.9rem; } }

  .tv-work { margin-top: 5rem; }
  @media (min-width: 56rem) { .tv-work { margin-top: 7rem; } }
  .tv-work__h2 { max-width: 34ch; }
  .tv-work__list {
    margin-top: 2.5rem; display: grid; gap: 0 3.5rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 56rem) { .tv-work__list { grid-template-columns: 1fr 1fr; } }
  .tv-work__list li {
    display: flex; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line);
  }
  .tv-work__title { font-size: 1.125rem; font-weight: 500; line-height: 1.3; }
  .tv-work__body { margin-top: 0.4rem; color: var(--muted); max-width: 36rem; }
  .tv-work__note { margin-top: 1.75rem; font-size: 0.9375rem; color: var(--muted); }
  .tv-work__cta { display: inline-block; margin-top: 1.5rem; }
  .tv-exercise { margin-top: 2.5rem; padding: 1.75rem; border: 1px solid var(--line); border-radius: 12px; background: var(--white); }
  .tv-exercise h3 { margin-top: 0.75rem; font-family: var(--h-serif); font-weight: 400; font-size: 1.75rem; line-height: 1.2; }
  .tv-exercise dl { margin: 1.5rem 0 0; display: grid; gap: 1.25rem; }
  .tv-exercise dl > div { padding-top: 1rem; border-top: 1px solid var(--line); min-width: 0; }
  .tv-exercise dt { font-size: 0.8125rem; font-weight: 500; }
  .tv-exercise dd { margin: 0.5rem 0 0; font-size: 1rem; line-height: 1.65; color: var(--muted); }
  @media (min-width: 56rem) { .tv-exercise dl { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }

  /* Easy to find, short to read, with the detail one click away. */
  .fw { margin-top: 4rem; max-width: 44rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .fw__h { font-size: 1.0625rem; font-weight: 500; letter-spacing: -0.005em; color: var(--text); }
  .fw__lead { margin-top: 0.75rem; font-size: 1.0625rem; line-height: 1.6; color: var(--text); }
  .fw__more { margin-top: 1rem; }
  .fw__more > summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.9375rem; font-weight: 500; color: var(--text);
    border-bottom: 1px solid var(--line); padding-bottom: 2px;
  }
  .fw__more > summary::-webkit-details-marker { display: none; }
  .fw__more > summary::after { content: '+'; font-size: 1rem; line-height: 1; color: var(--purple); }
  .fw__more[open] > summary::after { content: '–'; }
  .fw__more > summary:hover { border-color: var(--text); }
  .fw__more > div { margin-top: 1rem; display: grid; gap: 0.85rem; }
  .fw__more p { font-size: 1rem; line-height: 1.7; color: var(--muted); }

  .tv-proof { background: var(--midnight); color: var(--on-dark); padding: 5rem 0; }
  @media (min-width: 56rem) { .tv-proof { padding: 7rem 0; } }
  .tv-proof__h2 { max-width: 32ch; }
  .tv-voice { margin-top: 3rem; max-width: 44rem; }
  .tv-voice--solo {
    margin-top: 2.5rem; padding-top: 2.25rem; max-width: 46rem;
    border-top: 1px solid var(--line-dark);
  }
  .tv-voice--solo .client-portrait { margin-bottom: 1.5rem; max-width: 32rem; }
  @media (min-width: 56rem) {
    .tv-voice--solo { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr); align-items: center; gap: 3rem; max-width: none; }
    .tv-voice--solo .client-portrait { margin-bottom: 0; }
    .tv-voice__copy { min-width: 0; }
  }
  .tv-voice--solo blockquote { font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.32; }
  .tv-voice blockquote {
    margin-top: 0.85rem; font-family: var(--h-serif);
    font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.3; color: var(--on-dark);
  }
  .tv-voice figcaption { margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.9375rem; }
  .tv-voice__name { font-weight: 500; color: var(--on-dark); }
  .tv-voice__role { color: var(--on-dark-muted); }

  .tv-hero__free { display: block; width: fit-content; margin-top: 1rem; font-size: .875rem; color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 3px; }
  .tv-paths { background: var(--stone); padding: 4.5rem 0 5rem; scroll-margin-top: 5rem; }
  @media (min-width: 56rem) { .tv-paths { padding: 6.5rem 0 7rem; } }
  .tv-paths__h2 { max-width: 32ch; }
  .tv-paths__list { margin-top: 2.5rem; display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .tv-paths__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; align-items: stretch; } }
  .tv-path {
    display: flex; flex-direction: column; height: 100%;
    background: var(--sand); border: 1px solid var(--line); border-radius: 14px;
    padding: 1.75rem; min-width: 0;
  }
  .tv-path--flagship { background: var(--white); border-color: rgba(99, 102, 241, 0.4); }
  .tv-path__name { font-size: 1.125rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.005em; }
  .tv-path__body { margin-top: 0.75rem; font-size: 1rem; line-height: 1.6; color: var(--muted); }
  .tv-path__body { flex: 1; }
  .tv-path__cta { align-self: flex-start; margin-top: 1.75rem; font-size: 0.9375rem; }
  .tv-path__note { margin-top: 0.9rem; font-size: 0.8125rem; line-height: 1.55; color: var(--muted); }

  .tv-close { background: var(--sand); padding: 5rem 0 6rem; }
  @media (min-width: 56rem) { .tv-close { padding: 7rem 0 8rem; } }
  .tv-close__h2 { max-width: 34ch; }
  .tv-close__body { margin-top: 1.25rem; font-size: 1.25rem; }
  .tv-close__cta { margin-top: 2rem; }

  @media (prefers-reduced-motion: reduce) { .h3 *, .tv-main * { transition: none !important; } }

  .tv-path__note, .tv-path__note a { overflow-wrap: anywhere; }

  /* Free applications have their own destination, independent of advisory. */
  .tv-free { margin-top: 2rem; max-width: 44rem; }
  .tv-free p { font-size: 0.9375rem; line-height: 1.7; color: var(--muted); }
  .tv-free__cta { margin-top: 0.9rem; font-size: 0.9375rem; color: var(--text); }
</style>
