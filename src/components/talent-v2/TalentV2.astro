---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getTalentV2 } from '../../content/talentV2';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getTalentV2(lang);
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="light"
  navCta={{ label: t.hero.cta, href: t.hero.href }} journey="talent">
  <section class="h3-hero">
    <div class="h3-wrap tv-entry">
      <div class="h3-hero__copy tv-entry__copy">
        <p class="h3-eyebrow">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1">{t.hero.headline}</h1>
        <p class="h3-hero__sub">{t.hero.sub}</p>
        <p class="tv-audience">{t.hero.audience}</p>
      </div>

      <div class="tv-paths" id="ways-in" aria-labelledby="tv-paths-title">
        <h2 class="h3-eyebrow" id="tv-paths-title">{t.paths.eyebrow}</h2>
        <ul class="tv-paths__list">
          {t.paths.items.map((item, index) => (
            <li class="tv-path">
              <h3 class="tv-path__name">{item.name}</h3>
              <p class="tv-path__price">{item.price}</p>
              <p class="tv-path__body">{item.body}</p>
              <div class="tv-path__action">
                <a href={item.href} data-cta={"talent-path-" + index} class="h3-link">{item.cta}<span aria-hidden="true">→</span></a>
                {item.proof && <a href={item.proof.href} data-cta="talent-participant-voices" class="tv-path__proof">{item.proof.label}<span aria-hidden="true">→</span></a>}
                {item.note && <p class="tv-path__note">{item.note}</p>}
              </div>
            </li>
          ))}
        </ul>
        <div class="tv-free">
          <p>{t.paths.free.body}</p>
          <a href={t.paths.free.href} data-cta="talent-free" class="h3-link">{t.paths.free.cta}<span aria-hidden="true">→</span></a>
        </div>
      </div>

    </div>
  </section>

  <aside class="tv-principle" aria-label={t.firewall.headline}>
    <div class="h3-wrap">
      <p><strong>{t.firewall.headline}</strong> {t.firewall.lead}</p>
    </div>
  </aside>
</Shell>

<style lang="scss" is:global>
  .tv-entry { display: grid; gap: var(--space-grid); }
  .tv-entry__copy { max-width: 48rem; }
  .tv-paths { scroll-margin-top: var(--space-hero-top); }
  .tv-audience { margin-top: var(--space-3); max-width: 34rem; font-size: var(--type-ui); line-height: 1.5; color: var(--muted); }
  .tv-paths__list { margin-top: var(--space-3); }
  .tv-path { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: var(--space-stack); row-gap: var(--space-2); min-width: 0; padding-block: var(--space-stack); border-top: 1px solid var(--line); }
  .tv-path:last-child { border-bottom: 1px solid var(--line); }
  .tv-path__name { min-width: 0; font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .tv-path__price { margin: 0; font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; color: var(--text); font-variant-numeric: tabular-nums; }
  .tv-path__body { grid-column: 1 / -1; min-width: 0; font-size: var(--type-body); line-height: 1.7; color: var(--muted); max-width: 34rem; }
  .tv-path__action { grid-column: 1 / -1; min-width: 0; }
  .tv-path__action .h3-link { font-size: var(--type-ui); line-height: 1.5; }
  .tv-path__proof { display: inline-flex; align-items: baseline; gap: var(--space-1); margin-top: var(--space-2); font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .tv-path__proof:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tv-path__note { margin-top: var(--space-2); font-size: var(--type-caption); line-height: 1.5; color: var(--muted); max-width: 26ch; }
  .tv-free { margin-top: var(--space-4); max-width: 44rem; }
  .tv-free p { font-size: var(--type-ui); line-height: 1.5; color: var(--muted); }
  .tv-free .h3-link { margin-top: var(--space-2); font-size: var(--type-ui); line-height: 1.5; }
  .tv-principle { padding-block: var(--space-4); border-top: 1px solid var(--line); background: var(--sand); }
  .tv-principle p { max-width: 64rem; font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .tv-principle strong { font-weight: 500; color: var(--text); }
  @media (max-width: 55.99rem) { .tv-path__action .h3-link { min-height: var(--space-6); align-items: center; } }
  @media (min-width: 56rem) {
    .tv-path { grid-template-columns: minmax(0, 1fr) minmax(0, .6fr) minmax(0, 1.4fr) minmax(0, 1fr); column-gap: var(--space-stack); }
    .tv-path__body, .tv-path__action { grid-column: auto; }
  }
</style>
