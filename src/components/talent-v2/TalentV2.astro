---
// ── For Talent v2 · rebrand prototype ────────────────────────────────────
// Same system as the home: Midnight for the hero and one weighted moment,
// Ivory as the main surface, Stone for transitions, purple for action and
// signal only. Entry point, not the Offer Accelerator product page.
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../content/index';
import { getTalentV2 } from '../../content/talentV2';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getTalentV2(lang);
---

<Layout title={t.meta.title} description={t.meta.description} lang={lang} noindex>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="h3">
    <header class="h3-nav">
      <div class="h3-nav__in">
        <a href="/" class="h3-nav__logo" aria-label="Purrfect Hire">
          <picture>
            <source srcset="/logos/logo-desktop.webp" type="image/webp" />
            <img src="/logos/logo-desktop.png" alt="Purrfect Hire" />
          </picture>
        </a>
        <nav class="h3-nav__links" aria-label="Main">
          <a href="/for-founders">For companies</a>
          <a href="/for-talent">For talent</a>
          <a href="/roles">Open roles</a>
          <a href="/kate">Kate</a>
        </nav>
        <a href="/offer-acceleration" class="h3-btn h3-btn--sm">Apply</a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="h3-hero">
        <div class="h3-wrap h3-hero__grid">
          <div class="h3-hero__copy">
            <p class="h3-eyebrow h3-eyebrow--on-dark">{t.hero.eyebrow}</p>
            <h1 class="h3-hero__h1 tv-h1">{t.hero.headline}</h1>
            <p class="h3-hero__sub">{t.hero.sub}</p>
            <p class="tv-audience">{t.hero.audience}</p>
            <a href="/offer-acceleration" class="h3-btn tv-hero__cta">{t.hero.cta}</a>
          </div>
          <figure class="h3-ph h3-ph--hero h3-ph--on-dark">
            <figcaption>{t.hero.photoNote}</figcaption>
          </figure>
        </div>
      </section>

      <!-- Problem + what changes, one ivory surface -->
      <section class="tv-main">
        <div class="h3-wrap">
          <div class="tv-problem">
            <p class="h3-eyebrow">{t.problem.eyebrow}</p>
            <h2 class="h3-h2">{t.problem.headline}</h2>
            <p class="h3-body tv-problem__body">{t.problem.body}</p>
          </div>

          <div class="tv-work">
            <p class="h3-eyebrow">{t.work.eyebrow}</p>
            <h2 class="h3-h2 tv-work__h2">{t.work.headline}</h2>
            <ol class="tv-work__list">
              {t.work.items.map((i) => (
                <li>
                  <span class="h3-dot" aria-hidden="true"></span>
                  <div>
                    <h3 class="tv-work__title">{i.title}</h3>
                    <p class="tv-work__body">{i.body}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="tv-work__note">{t.work.note}</p>
            <a href="/offer-acceleration" class="h3-link tv-work__cta">{t.work.cta} <span aria-hidden="true">→</span></a>
          </div>

          <!-- Firewall, right after Create access -->
          <aside class="tv-firewall" aria-labelledby="tv-firewall-h">
            <h2 class="tv-firewall__h" id="tv-firewall-h">{t.firewall.headline}</h2>
            {t.firewall.body.map((b) => <p class="tv-firewall__p">{b}</p>)}
            <p class="tv-firewall__status">{t.firewall.status}</p>
          </aside>
        </div>
      </section>

      <!-- Proof, the weighted dark moment -->
      <section class="tv-proof">
        <div class="h3-wrap">
          <p class="h3-eyebrow h3-eyebrow--on-dark">{t.proof.eyebrow}</p>
          <h2 class="h3-h2 h3-h2--on-dark tv-proof__h2">{t.proof.headline}</h2>
          <div class="tv-proof__grid">
            {t.proof.slots.map((slot) => (
              <figure class="h3-ph h3-ph--proof h3-ph--on-dark">
                <figcaption>{slot}</figcaption>
              </figure>
            ))}
          </div>
          <p class="tv-proof__note">{t.proof.note}</p>
        </div>
      </section>

      <!-- Paths -->
      <section class="tv-paths">
        <div class="h3-wrap">
          <p class="h3-eyebrow">{t.paths.eyebrow}</p>
          <h2 class="h3-h2 tv-paths__h2">{t.paths.headline}</h2>
          <ul class="tv-paths__list">
            {t.paths.items.map((i, idx) => (
              <li class={idx === 0 ? 'tv-path tv-path--flagship' : 'tv-path'}>
                <h3 class="tv-path__name">{i.name}</h3>
                <p class="tv-path__body">{i.body}</p>
                <a href={i.href} class="h3-link tv-path__cta">{i.cta} <span aria-hidden="true">→</span></a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Close -->
      <section class="tv-close">
        <div class="h3-wrap">
          <h2 class="h3-h2 tv-close__h2">{t.close.headline}</h2>
          <p class="h3-body tv-close__body">{t.close.body}</p>
          <a href="/offer-acceleration" class="h3-btn tv-close__cta">{t.close.cta}</a>
        </div>
      </section>
    </main>

    <footer class="h3-footer">
      <div class="h3-wrap h3-footer__in">
        <span>© 2026 Purrfect Hire</span>
        <nav aria-label="Footer">
          <a href="/privacy-policy">Privacy</a>
          <a href="https://www.linkedin.com/company/purrfect-hire" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="mailto:hiring@purrfecthire.com">hiring@purrfecthire.com</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<style lang="scss" is:global>
  /* Shared tokens and primitives: same system as the home prototype. */
  .h3 {
    --midnight: #0a0b14;
    --ivory: #f7f6f3;
    --stone: #e9ebf0;
    --sand: #efece5;
    --text: #14161f;
    --muted: #63656f;
    --on-dark: #e8e7e3;
    --on-dark-muted: #9b9ca6;
    --line: rgba(20, 22, 31, 0.1);
    --line-dark: rgba(232, 231, 227, 0.14);
    --purple: #6366f1;
    --purple-deep: #4f46e5;
    --h-serif: 'Instrument Serif', 'Canela', Georgia, serif;
    --h-sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--ivory); color: var(--text);
    font-family: var(--h-sans); line-height: 1.6; -webkit-font-smoothing: antialiased;
  }
  body:has(.h3) { background: #0a0b14; }
  :where(.h3) a { color: inherit; text-decoration: none; }
  :where(.h3) :where(p, h1, h2, h3, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
  :where(.h3) :where(ul, ol) { list-style: none; }
  .h3 a:focus-visible { outline: 2px solid var(--purple); outline-offset: 4px; border-radius: 3px; }

  .h3-wrap { max-width: 80rem; margin-inline: auto; padding-inline: 1.5rem; }
  @media (min-width: 64rem) { .h3-wrap { padding-inline: 3rem; } }

  .h3-eyebrow {
    font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted);
  }
  .h3-eyebrow--on-dark { color: var(--on-dark-muted); }
  .h3-dot {
    display: inline-block; width: 6px; height: 6px; border-radius: 50%;
    background: var(--purple); margin-top: 0.7rem; flex: none;
  }
  .h3-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.9rem 1.6rem; border-radius: 999px;
    background: var(--purple); color: #fff !important;
    font-size: 0.9375rem; font-weight: 500; line-height: 1;
    transition: background-color 0.2s ease;
  }
  .h3-btn:hover { background: var(--purple-deep); }
  .h3-btn--sm { padding: 0.6rem 1.1rem; font-size: 0.875rem; }
  .h3-link {
    font-size: 1rem; font-weight: 500;
    border-bottom: 1px solid var(--line); padding-bottom: 2px;
  }
  .h3-link:hover { border-color: currentColor; }
  .h3-h2 {
    font-family: var(--h-serif); font-weight: 400;
    font-size: clamp(1.875rem, 3.6vw, 3.5rem); line-height: 1.06;
    letter-spacing: -0.014em; margin-top: 0.9rem; text-wrap: balance;
  }
  .h3-h2--on-dark { color: var(--on-dark); }
  .h3-body { font-size: 1.125rem; line-height: 1.7; color: var(--muted); max-width: 34rem; }

  .h3-ph {
    display: flex; align-items: flex-end; border-radius: 14px;
    background: var(--sand); border: 1px dashed rgba(20, 22, 31, 0.22);
    padding: 1rem; max-width: 100%;
  }
  .h3-ph figcaption {
    font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted); line-height: 1.5;
  }
  .h3-ph--on-dark { background: #161825; border-color: var(--line-dark); }
  .h3-ph--on-dark figcaption { color: var(--on-dark-muted); }
  .h3-ph--hero { aspect-ratio: 4 / 5; }
  .h3-ph--proof { aspect-ratio: 4 / 5; }

  .h3-nav {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: rgba(10, 11, 20, 0.86); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line-dark);
  }
  .h3-nav__in {
    max-width: 80rem; margin-inline: auto; padding: 0.9rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  }
  @media (min-width: 64rem) { .h3-nav__in { padding-inline: 3rem; } }
  .h3-nav__logo img { height: 1.9rem; width: auto; display: block; filter: brightness(0) invert(1); }
  .h3-nav__links { display: none; gap: 2rem; font-size: 0.9375rem; color: var(--on-dark-muted); }
  .h3-nav__links a:hover { color: var(--on-dark); }
  @media (min-width: 56rem) { .h3-nav__links { display: flex; } }

  .h3-hero { background: var(--midnight); color: var(--on-dark); padding: 4.5rem 0 5rem; }
  @media (min-width: 56rem) { .h3-hero { padding: 6.5rem 0 7.5rem; } }
  .h3-hero__grid { display: grid; gap: 3.5rem; align-items: center; }
  @media (min-width: 56rem) { .h3-hero__grid { grid-template-columns: 1.35fr 1fr; gap: 5rem; } }
  .h3-hero__copy { min-width: 0; }
  .h3-hero__h1 {
    font-family: var(--h-serif); font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 1.02;
    letter-spacing: -0.02em; max-width: 15ch; text-wrap: balance;
  }
  .h3-hero__sub {
    margin-top: 2rem; max-width: 36rem; font-size: 1.1875rem;
    line-height: 1.65; color: var(--on-dark-muted);
  }
  .h3-footer {
    background: var(--midnight); color: var(--on-dark-muted);
    border-top: 1px solid var(--line-dark); padding: 2rem 0 2.5rem; font-size: 0.8125rem;
  }
  .h3-footer__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .h3-footer nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .h3-footer a:hover { color: var(--on-dark); }

  /* ── Page-specific ───────────────────────────────────────────────── */
  .tv-h1 { margin-top: 1rem; }
  .tv-audience {
    margin-top: 1.5rem; font-size: 0.9375rem; color: var(--on-dark-muted);
    max-width: 30rem; padding-top: 1.25rem; border-top: 1px solid var(--line-dark);
  }
  .tv-hero__cta { margin-top: 2rem; }

  /* One ivory surface carries problem, the four things, and the firewall. */
  .tv-main { background: var(--ivory); padding: 5rem 0 6rem; }
  @media (min-width: 56rem) { .tv-main { padding: 7.5rem 0 8rem; } }
  .tv-problem__body { margin-top: 1.5rem; max-width: 38rem; font-size: 1.25rem; color: var(--text); }

  .tv-work { margin-top: 5rem; }
  @media (min-width: 56rem) { .tv-work { margin-top: 7rem; } }
  .tv-work__h2 { max-width: 18ch; }
  .tv-work__list {
    margin-top: 2.5rem; display: grid; gap: 0; border-top: 1px solid var(--line);
    max-width: 48rem;
  }
  .tv-work__list li {
    display: flex; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line);
  }
  .tv-work__title { font-size: 1.125rem; font-weight: 500; line-height: 1.3; }
  .tv-work__body { margin-top: 0.4rem; color: var(--muted); max-width: 36rem; }
  .tv-work__note { margin-top: 1.75rem; font-size: 0.9375rem; color: var(--muted); }
  .tv-work__cta { display: inline-block; margin-top: 1.5rem; }

  .tv-firewall {
    margin-top: 3.5rem; max-width: 46rem; background: #fff;
    border: 1px solid var(--line); border-left: 3px solid var(--purple);
    border-radius: 14px; padding: 2rem 2.25rem;
  }
  @media (max-width: 40rem) { .tv-firewall { padding: 1.5rem; } }
  .tv-firewall__h {
    font-family: var(--h-serif); font-weight: 400; font-size: 1.75rem; line-height: 1.15;
  }
  .tv-firewall__p { margin-top: 1rem; font-size: 1rem; line-height: 1.65; color: var(--muted); }
  .tv-firewall__status {
    margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--line);
    font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }

  .tv-proof { background: var(--midnight); color: var(--on-dark); padding: 5rem 0; }
  @media (min-width: 56rem) { .tv-proof { padding: 7rem 0; } }
  .tv-proof__h2 { max-width: 16ch; }
  .tv-proof__grid { margin-top: 3rem; display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .tv-proof__grid { grid-template-columns: repeat(3, 1fr); } }
  .tv-proof__note {
    margin-top: 2rem; font-size: 0.9375rem; line-height: 1.6;
    color: var(--on-dark-muted); max-width: 42rem;
  }

  .tv-paths { background: var(--stone); padding: 4.5rem 0 5rem; }
  @media (min-width: 56rem) { .tv-paths { padding: 6.5rem 0 7rem; } }
  .tv-paths__h2 { max-width: 16ch; }
  .tv-paths__list { margin-top: 2.5rem; display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .tv-paths__list { grid-template-columns: 1.4fr 1fr 1fr; align-items: start; } }
  .tv-path {
    background: var(--ivory); border: 1px solid var(--line); border-radius: 14px;
    padding: 1.75rem; min-width: 0;
  }
  .tv-path--flagship { background: #fff; border-color: rgba(99, 102, 241, 0.35); }
  .tv-path__name { font-family: var(--h-serif); font-weight: 400; font-size: 1.5rem; line-height: 1.15; }
  .tv-path__body { margin-top: 0.75rem; font-size: 1rem; line-height: 1.6; color: var(--muted); }
  .tv-path__cta { display: inline-block; margin-top: 1.5rem; font-size: 0.9375rem; }

  .tv-close { background: var(--ivory); padding: 5rem 0 6rem; }
  @media (min-width: 56rem) { .tv-close { padding: 7rem 0 8rem; } }
  .tv-close__h2 { max-width: 20ch; }
  .tv-close__body { margin-top: 1.25rem; font-size: 1.25rem; }
  .tv-close__cta { margin-top: 2rem; }

  @media (prefers-reduced-motion: reduce) { .h3 *, .tv-main * { transition: none !important; } }
</style>
