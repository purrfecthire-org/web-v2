---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getInvestorsV2, INVESTORS_SEARCH_READ } from '../../content/investorsV2';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getInvestorsV2(lang);
---

<Shell
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  theme="light"
  navCta={{ label: t.hero.cta, href: INVESTORS_SEARCH_READ }}
  journey="companies"
>
  <div class="iv-page" data-audience="investors">
    <section class="h3-hero iv-hero" aria-labelledby="iv-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1 iv-hero__title" id="iv-title">{t.hero.headline}</h1>
        <p class="h3-hero__sub iv-hero__body">{t.hero.body}</p>
        <a href={INVESTORS_SEARCH_READ} data-cta="investors-hero-search-read" class="h3-btn h3-btn--ink iv-hero__cta">
          {t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span>
        </a>
        <p class="iv-note">{t.hero.note}</p>
      </div>
    </section>

    <section class="iv-section iv-support" aria-labelledby="iv-support-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.support.eyebrow}</p>
        <h2 class="h3-h2 iv-wide-title" id="iv-support-title">{t.support.headline}</h2>
        <ol class="iv-support__list">
          {t.support.areas.map((area) => (
            <li class="iv-area">
              <span class="iv-area__id" aria-hidden="true">{area.id}</span>
              <div><h3>{area.title}</h3><p>{area.body}</p></div>
              <div class="iv-area__outcome">
                <p class="iv-area__label">{area.outcomeLabel}</p>
                <p>{area.outcome}</p>
                {area.id === '03' && <details class="iv-format">
                  <summary>{t.officeHours.detailLabel}<span aria-hidden="true">+</span></summary>
                  <ul>{t.officeHours.points.map((point) => <li>{point}</li>)}</ul>
                  <p class="iv-note">{t.officeHours.note}</p>
                </details>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="iv-section iv-agreement" aria-labelledby="iv-agreement-title">
      <div class="h3-wrap iv-split">
        <div>
          <p class="h3-eyebrow">{t.approach.eyebrow}</p>
          <h2 class="h3-h2 iv-wide-title" id="iv-agreement-title">{t.approach.headline}</h2>
          <ol class="iv-approach__list">
            {t.approach.steps.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
          </ol>
        </div>
        <div class="iv-questions__list">
          {t.questions.items.map((item) => (
            <details class="iv-question">
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="iv-section iv-evidence" aria-labelledby="iv-evidence-title">
      <div class="h3-wrap iv-split">
        <div>
          <p class="h3-eyebrow">{t.evidence.eyebrow}</p>
          <h2 class="h3-h2 iv-wide-title" id="iv-evidence-title">{t.evidence.headline}</h2>
        </div>
        <div class="iv-evidence__links">
          {t.evidence.links.map((link) => (
            <a href={link.href} data-cta={link.ctaId} class="iv-evidence__link">
              <span><span class="iv-evidence__label">{link.title}</span><span class="iv-evidence__body">{link.body}</span></span>
              <span class="h3-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="iv-section iv-close" aria-labelledby="iv-close-title">
      <div class="h3-wrap">
        <h2 class="h3-h2 iv-wide-title" id="iv-close-title">{t.close.headline}</h2>
        <p class="h3-body iv-section__body">{t.close.body}</p>
        <a href={INVESTORS_SEARCH_READ} data-cta="investors-close-search-read" class="h3-btn h3-btn--ink iv-close__cta">
          {t.close.cta}<span class="h3-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Shell>

<style lang="scss">
  .iv-section { padding-block: var(--space-section); }
  .iv-hero__title { max-width: 23ch; }
  .iv-hero__body { max-width: 43rem; }
  .iv-hero__cta, .iv-close__cta { margin-top: var(--space-stack); max-width: 100%; text-align: center; line-height: 1.4; }
  .iv-note { margin-top: var(--space-2); max-width: 34rem; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }
  .iv-wide-title { max-width: 26ch; }
  .iv-section__body { margin-top: var(--space-stack); max-width: 42rem; }
  .iv-support__list { margin-top: var(--space-grid); border-top: 1px solid var(--line); }
  .iv-area { display: grid; gap: var(--space-stack); padding-block: var(--space-stack); border-bottom: 1px solid var(--line); }
  .iv-area > div { min-width: 0; }
  .iv-area__id { font-size: var(--type-caption); line-height: 1.5; color: var(--muted); font-variant-numeric: tabular-nums; }
  .iv-area h3, .iv-approach__list h3 { font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .iv-area p:not(.iv-area__label), .iv-approach__list p, .iv-format li { margin-top: var(--space-1); max-width: 40rem; color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .iv-area .iv-area__outcome > p { font-size: var(--type-ui); line-height: 1.5; }
  .iv-area__label { font-weight: 500; }
  .iv-format { margin-top: var(--space-stack); }
  .iv-format summary { display: flex; justify-content: space-between; gap: var(--space-2); padding-block: var(--space-1); font-size: var(--type-ui); line-height: 1.5; cursor: pointer; list-style: none; }
  .iv-format summary::-webkit-details-marker { display: none; }
  .iv-format ul { margin-top: var(--space-2); padding-left: var(--space-stack); list-style: disc; }
  .iv-format .iv-note { font-size: var(--type-caption); line-height: 1.5; }
  .iv-split { display: grid; gap: var(--space-grid); align-items: start; }
  .iv-approach__list { display: grid; gap: var(--space-stack); margin-top: var(--space-stack); }
  .iv-questions__list { min-width: 0; border-top: 1px solid var(--line); }
  .iv-question { border-bottom: 1px solid var(--line); }
  .iv-question summary { display: flex; justify-content: space-between; gap: var(--space-2); align-items: baseline; padding-block: var(--space-stack); list-style: none; cursor: pointer; font-size: var(--type-body); font-weight: 500; line-height: 1.7; }
  .iv-question summary::-webkit-details-marker { display: none; }
  .iv-question summary span { flex-shrink: 0; }
  .iv-question[open] summary span, .iv-format[open] summary span { transform: rotate(45deg); }
  .iv-question p { padding-bottom: var(--space-stack); max-width: 36rem; color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .iv-evidence__links { border-top: 1px solid var(--line); }
  .iv-evidence__link { display: flex; justify-content: space-between; gap: var(--space-stack); padding-block: var(--space-stack); border-bottom: 1px solid var(--line); }
  .iv-evidence__label { display: block; font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .iv-evidence__body { display: block; margin-top: var(--space-1); color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .iv-evidence__link:hover .iv-evidence__label { text-decoration: underline; text-underline-offset: 4px; }
  .iv-close { border-top: 1px solid var(--line); }
  @media (min-width: 56rem) {
    .iv-area { grid-template-columns: var(--space-4) minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-grid); }
    .iv-split { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
