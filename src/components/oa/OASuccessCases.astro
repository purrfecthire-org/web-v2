---
// ── OA success cases — anonymous outcome proof ───────────────────────────
// Sits right after the investment tier table: that table promises an
// abstract "salto realista" per seniority, these are four real jumps that
// already happened. Each case is laid out as the transformation itself:
// the starting state, an arrow, and the outcome, with the intervention as
// the connecting caption underneath, so the jump reads without prose.
// Named proof lives in OATestimonials.astro (Alejandro); these clients
// asked to stay anonymous, hence the closing disclaimer.
import { oaContent as c } from '../../content/offerAcceleration';

const cs = c.cases;
---

<section class="oac" id="casos">
  <div class="oac-head reveal">
    <h2 class="oac-title">{cs.title}</h2>
    <p class="oac-intro">{cs.intro}</p>
  </div>

  <div class="oac-cases">
    {cs.items.map((item, i) => (
      <article class="oac-case reveal">
        <header class="oac-case__head">
          <span class="oac-case__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="oac-case__role">{item.role}</h3>
        </header>

        <div class="oac-case__jump">
          <div class="oac-case__state">
            <span class="oac-label">{cs.labels.before}</span>
            <p class="oac-case__before">{item.problem}</p>
          </div>

          <span class="oac-case__arrow" aria-hidden="true">→</span>

          <div class="oac-case__state oac-case__state--after">
            <span class="oac-label">{cs.labels.after}</span>
            <p class="oac-case__result">{item.result}</p>
            <p class="oac-case__note">{item.resultNote}</p>
          </div>
        </div>

        <p class="oac-case__how">
          <span class="oac-case__how-label">{cs.labels.action}:</span> {item.action}
        </p>
      </article>
    ))}
  </div>

  <aside class="oac-disclaimer reveal">
    <svg class="oac-disclaimer__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4" y="10" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.6" />
      <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <p class="oac-disclaimer__text">{cs.disclaimer}</p>
  </aside>
</section>

<style lang="scss">
  $ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

  // Same box as .oa5-chapter on the parent page, so this section shares the
  // page's single content column instead of running wider.
  .oac {
    --oac-ink: var(--ink, #29285f);
    --oac-text: var(--text, #1c1c1c);
    --oac-muted: var(--muted, #6b6b6b);
    --oac-border: var(--line, rgba(0, 0, 0, 0.08));
    --oac-bg: var(--bg, #ffffff);
    --oac-bg-soft: var(--bg-soft, #fcfcfb);
    --oac-radius: var(--radius, 12px);

    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    font-family: 'Schibsted Grotesk', Arial, sans-serif;
    border-top: 1px solid var(--oac-border);
    padding: clamp(48px, 7vw, 80px) clamp(1.5rem, 5vw, 2rem);
  }

  .oac-head {
    margin-bottom: 3rem;
  }

  .oac-title {
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.875rem, 3.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: var(--oac-ink);
    max-width: 22ch;
  }

  .oac-intro {
    max-width: 46rem;
    margin: 1.25rem 0 0;
    color: var(--oac-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  // Micro-label above each state (Antes / Después)
  .oac-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oac-muted);
    margin-bottom: 0.5rem;
  }

  // ── Cases: borderless rows split by hairlines ──────────────────────────
  .oac-case {
    padding: 2.25rem 0;
    border-top: 1px solid var(--oac-border);

    &:first-child { border-top: none; padding-top: 0; }

    &__head {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
      margin-bottom: 1.5rem;
    }

    &__num {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--oac-ink);
      font-variant-numeric: tabular-nums;
    }

    &__role {
      margin: 0;
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--oac-text);
    }

    // The transformation as layout: state A → state B.
    &__jump {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: center;

      @media (max-width: 720px) {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
    }

    &__arrow {
      font-size: 1.75rem;
      color: var(--oac-ink);
      line-height: 1;

      @media (max-width: 720px) {
        transform: rotate(90deg);
        justify-self: start;
        margin-left: 0.25rem;
      }
    }

    &__before {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.65;
      color: var(--oac-muted);
    }

    // The outcome is the loudest thing in the row.
    &__result {
      margin: 0;
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.5rem, 2.4vw, 1.875rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--oac-ink);
    }

    &__note {
      margin: 0.625rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--oac-muted);
    }

    &__how {
      margin: 1.5rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--oac-muted);
      max-width: 56rem;
    }

    &__how-label {
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--oac-ink);
    }
  }

  // ── Confidentiality disclaimer ─────────────────────────────────────────
  .oac-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 1.125rem;
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: var(--oac-bg-soft);
    border: 1px solid var(--oac-border);
    border-radius: var(--oac-radius);

    &__icon {
      flex: 0 0 auto;
      width: 24px;
      height: 24px;
      color: var(--oac-ink);
      margin-top: 0.125rem;
    }

    &__text {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.7;
      color: var(--oac-muted);
      max-width: 60rem;
    }

    @media (max-width: 640px) {
      padding: 1.5rem;
      gap: 0.875rem;
    }
  }
</style>
