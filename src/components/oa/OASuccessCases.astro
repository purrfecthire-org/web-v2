---
// ── OA success cases — anonymous outcome proof ───────────────────────────
// Sits right after the investment tier table: that table promises an
// abstract "salto realista" per seniority, these are four real jumps that
// already happened. Each card leads with the RESULT (navy, largest type in
// the card) and keeps problem/intervention as supporting detail, so the
// outcome is readable at a glance without reading the prose.
// Named proof lives in OATestimonials.astro (Alejandro); these clients
// asked to stay anonymous, hence the per-card note + closing disclaimer.
import { oaContent as c } from '../../content/offerAcceleration';

const cs = c.cases;
---

<section class="oac" id="casos">
  <div class="oac-inner">
    <div class="oac-head reveal">
      <h2 class="oac-title">{cs.title}</h2>
      <p class="oac-intro">{cs.intro}</p>
    </div>

    <div class="oac-grid">
      {cs.items.map((item, i) => (
        <article class="oac-case reveal">
          <header class="oac-case__head">
            <span class="oac-case__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="oac-case__role">{item.role}</h3>
          </header>

          <div class="oac-case__body">
            <div class="oac-case__facts">
              <div class="oac-fact">
                <span class="oac-label">{cs.labels.problem}</span>
                <p class="oac-fact__text">{item.problem}</p>
              </div>
              <div class="oac-fact">
                <span class="oac-label">{cs.labels.action}</span>
                <p class="oac-fact__text">{item.action}</p>
              </div>
            </div>

            <div class="oac-case__result">
              <span class="oac-label">{cs.labels.result}</span>
              <p class="oac-case__value">{item.result}</p>
              <p class="oac-case__note">{item.resultNote}</p>
            </div>
          </div>

          <p class="oac-case__conf">{cs.confidential}</p>
        </article>
      ))}
    </div>

    <aside class="oac-disclaimer reveal">
      <svg class="oac-disclaimer__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.6" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <div class="oac-disclaimer__text">
        <p>{cs.disclaimer.body}</p>
        <p class="oac-disclaimer__close">{cs.disclaimer.close}</p>
      </div>
    </aside>
  </div>
</section>

<style lang="scss">
  $ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

  .oac {
    --oac-ink: var(--ink, #29285f);
    --oac-text: var(--text, #1c1c1c);
    --oac-muted: var(--muted, #6b6b6b);
    --oac-border: var(--line, rgba(0, 0, 0, 0.08));
    --oac-bg: var(--bg, #ffffff);
    --oac-bg-soft: var(--bg-soft, #fcfcfb);
    --oac-radius: var(--radius, 12px);

    // Same box as .oa5-chapter on the parent page, so this section shares
    // the page's single content column instead of running 32px wider.
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    font-family: 'Schibsted Grotesk', Arial, sans-serif;
    border-top: 1px solid var(--oac-border);
    padding: clamp(48px, 7vw, 80px) clamp(1.5rem, 5vw, 2rem);
  }

  .oac-head {
    margin-bottom: 3rem;
  }

  .oac-title {
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.875rem, 3.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: var(--oac-ink);
    max-width: 22ch;
  }

  .oac-intro {
    max-width: 46rem;
    margin: 1.25rem 0 0;
    color: var(--oac-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  // Shared micro-label above every block (Problema / Intervención / Resultado)
  .oac-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oac-muted);
    margin-bottom: 0.5rem;
  }

  .oac-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;

    @media (max-width: 900px) { grid-template-columns: 1fr; }
  }

  .oac-case {
    display: flex;
    flex-direction: column;
    background: var(--oac-bg);
    border: 1px solid var(--oac-border);
    border-radius: var(--oac-radius);
    padding: clamp(1.5rem, 2.5vw, 2rem);
    transition: border-color 0.25s $ease-expo;

    &:hover { border-color: var(--oac-ink); }

    &__head {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
      padding-bottom: 1.25rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--oac-border);
    }

    &__num {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--oac-ink);
      font-variant-numeric: tabular-nums;
    }

    &__role {
      margin: 0;
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--oac-text);
    }

    // Facts left, result right. The divider is a hairline, no fill.
    &__body {
      flex: 1;
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 1.75rem;

      @media (max-width: 1080px) { grid-template-columns: 1fr; gap: 1.5rem; }
    }

    &__facts {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    &__result {
      padding-left: 1.75rem;
      border-left: 1px solid var(--oac-border);

      @media (max-width: 1080px) {
        padding-left: 0;
        padding-top: 1.5rem;
        border-left: none;
        border-top: 1px solid var(--oac-border);
      }
    }

    // The outcome is the loudest thing in the card.
    &__value {
      margin: 0;
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.375rem, 2.1vw, 1.75rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--oac-ink);
    }

    &__note {
      margin: 0.75rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--oac-muted);
    }

    &__conf {
      margin: 1.75rem 0 0;
      padding-top: 1.25rem;
      border-top: 1px solid var(--oac-border);
      font-size: 0.8125rem;
      font-style: italic;
      color: var(--oac-muted);
    }
  }

  .oac-fact__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--oac-muted);
  }

  // ── Confidentiality disclaimer ─────────────────────────────────────────
  .oac-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 1.125rem;
    margin-top: 2rem;
    padding: 1.75rem;
    background: var(--oac-bg-soft);
    border: 1px solid var(--oac-border);
    border-radius: var(--oac-radius);

    &__icon {
      flex: 0 0 auto;
      width: 24px;
      height: 24px;
      color: var(--oac-ink);
      margin-top: 0.125rem;
    }

    &__text p {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.7;
      color: var(--oac-muted);
      max-width: 60rem;
    }

    &__close {
      margin-top: 0.75rem !important;
      font-weight: 500;
      color: var(--oac-ink) !important;
    }

    @media (max-width: 640px) {
      padding: 1.5rem;
      gap: 0.875rem;
    }
  }
</style>
