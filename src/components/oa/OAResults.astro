---
// ── OA "Resultados reales" — the single proof section ────────────────────
// Two anonymous senior cases (before → after) plus Meri's voice testimonial
// (audio-only, first name only, at her request — the audio IS the proof).
// Case selection rule: the "before" state must also read senior; see the
// comment on oaContent.results. The player is the same minimal vanilla
// implementation used by the previous testimonials section (no libraries).
import { oaContent as c } from '../../content/offerAcceleration';

const r = c.results;
const v = r.voice;

// Split a paragraph on its exact highlight substring so the markup can
// emphasize it without storing HTML in the content file.
const voiceHl = v.paragraphs.map((text, i) => {
  const hl: string | undefined = v.highlights[i];
  const at = hl ? text.indexOf(hl) : -1;
  return at >= 0
    ? { pre: text.slice(0, at), hl: hl as string, post: text.slice(at + (hl as string).length) }
    : { pre: text, hl: '', post: '' };
});

// Decorative waveform: deterministic bar heights (percent) so the SSR
// output is stable. Purely visual — seeking works on the whole strip.
const BARS = Array.from({ length: 48 }, (_, i) => {
  const wave = Math.abs(Math.sin(i * 0.55)) * 0.55 + Math.abs(Math.sin(i * 1.9 + 2)) * 0.45;
  return Math.round(18 + wave * 72);
});
---

<section class="oar" id="resultados">
  <div class="oar-inner">
    <div class="oar-head reveal">
      <h2 class="oar-title">{r.title}</h2>
    </div>

    <div class="oar-cases reveal">
      {r.cases.map((k) => (
        <article class="oar-case">
          <h3 class="oar-case__role">{k.role}</h3>
          <p class="oar-case__label">{r.labels.before}</p>
          <p class="oar-case__before">{k.before}</p>
          <span class="oar-case__arrow" aria-hidden="true">↓</span>
          <p class="oar-case__label">{r.labels.after}</p>
          <p class="oar-case__after">{k.after}</p>
          <p class="oar-case__note">{k.afterNote}</p>
        </article>
      ))}
    </div>

    <!-- ── Voice story: Meri (audio-only at her request) ─────────────── -->
    <div class="oar-voice reveal">
      <p class="oar-kicker">{v.kicker}</p>
      <blockquote class="oar-voice__quote">“{v.pull}”</blockquote>

      <div class="oar-player">
        <p class="oar-player__label">{v.audioLabel}</p>
        <audio preload="metadata" src={v.audioSrc}></audio>
        <div class="oar-player__row">
          <button class="oar-player__btn" type="button" aria-label="Reproducir el testimonio de Meri">
            <svg class="oar-player__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5-11-6.5z" />
            </svg>
            <svg class="oar-player__icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="7" y="5" width="3.5" height="14" rx="1" />
              <rect x="13.5" y="5" width="3.5" height="14" rx="1" />
            </svg>
          </button>

          <div class="oar-player__wave" role="slider" tabindex="0" aria-label="Progreso del audio"
            aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            {BARS.map((h) => (
              <span class="oar-player__bar" style={`height:${h}%`}></span>
            ))}
          </div>

          <span class="oar-player__time" data-duration={v.audioDuration}>0:00&thinsp;/&thinsp;{v.audioDuration}</span>
        </div>
      </div>

      <div class="oar-voice__person">
        <span class="oar-voice__name">{v.name}</span>
        <span class="oar-voice__role">{v.role}</span>
      </div>

      <p class="oar-voice__privacy">{v.privacyNote}</p>

      <details class="oar-expand">
        <summary>
          <span class="oar-expand__more">{v.transcriptMore}</span>
          <span class="oar-expand__less">{v.transcriptLess}</span>
        </summary>
        <div class="oar-expand__body">
          <p class="oar-voice__transcript-note">{v.transcriptNote}</p>
          {voiceHl.map((seg) => (
            <p>
              {seg.pre}{seg.hl && <strong class="oar-hl">{seg.hl}</strong>}{seg.post}
            </p>
          ))}
        </div>
      </details>
    </div>

    <p class="oar-close reveal">{r.close}</p>
    <p class="oar-disclaimer reveal">{r.disclaimer}</p>
  </div>
</section>

<style lang="scss">
  $ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

  .oar {
    --oar-ink: var(--ink, #29285f);
    --oar-text: var(--text, #1c1c1c);
    --oar-muted: var(--muted, #6b6b6b);
    --oar-border: var(--line, rgba(0, 0, 0, 0.08));
    --oar-bg: var(--bg, #ffffff);
    --oar-bg-soft: var(--bg-soft, #fcfcfb);
    --oar-radius: var(--radius, 12px);

    position: relative;
    font-family: 'Schibsted Grotesk', Arial, sans-serif;
    background: var(--oar-bg-soft);
    border-top: 1px solid var(--oar-border);
    padding: clamp(48px, 7vw, 80px) clamp(1.5rem, 5vw, 2rem);
  }

  .oar-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .oar-head { margin-bottom: 2.5rem; }

  .oar-title {
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.875rem, 3.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: var(--oar-ink);
    max-width: 22ch;
  }

  // ── Case cards ──────────────────────────────────────────────
  .oar-cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;

    @media (max-width: 767px) { grid-template-columns: 1fr; }
  }

  .oar-case {
    border: 1px solid var(--oar-border);
    border-radius: var(--oar-radius);
    background: var(--oar-bg);
    padding: 2rem;

    &__role {
      margin: 0 0 1.5rem;
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--oar-ink);
    }

    &__label {
      margin: 0 0 0.375rem;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--oar-muted);
    }

    &__before {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--oar-muted);
    }

    &__arrow {
      display: block;
      margin: 1.25rem 0;
      font-size: 1.25rem;
      color: var(--oar-ink);
    }

    &__after {
      margin: 0;
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.375rem, 2.4vw, 1.75rem);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.2;
      color: var(--oar-ink);
    }

    &__note {
      margin: 0.5rem 0 0;
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--oar-muted);
    }
  }

  // ── Voice card (Meri) ───────────────────────────────────────
  .oar-voice {
    margin-top: 1.5rem;
    border: 1px solid var(--oar-border);
    border-radius: var(--oar-radius);
    background: var(--oar-bg);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;

    &__quote {
      margin: 0 auto;
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.375rem, 2.6vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.25;
      color: var(--oar-ink);
      max-width: 28ch;
    }

    &__person {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }

    &__name {
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--oar-text);
    }

    &__role {
      font-size: 0.8125rem;
      color: var(--oar-muted);
    }

    &__privacy {
      margin: -0.25rem auto 0;
      max-width: 34rem;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--oar-muted);
    }

    &__transcript-note {
      font-size: 0.75rem !important;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--oar-muted);
    }
  }

  .oar-kicker {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oar-muted);
  }

  .oar-hl {
    font-weight: 500;
    color: var(--oar-ink);
  }

  // ── Transcript toggle (details/summary, no JS) ──────────────
  .oar-expand {
    text-align: center;

    summary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      list-style: none;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--oar-ink);

      &::-webkit-details-marker { display: none; }

      &::after {
        content: '+';
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1;
        transition: transform 0.25s $ease-expo;
      }
    }

    &[open] summary::after { transform: rotate(45deg); }

    .oar-expand__less { display: none; }
    &[open] .oar-expand__more { display: none; }
    &[open] .oar-expand__less { display: inline; }

    &__body {
      margin-top: 1.25rem;
      max-width: 42rem;
      margin-inline: auto;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 1rem;

      p {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--oar-muted);
      }
    }

    &[open] .oar-expand__body { animation: oar-fade 0.45s $ease-expo; }
  }

  @keyframes oar-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  // ── Flat player: navy play button + waveform tinted by playback ──
  .oar-player {
    width: min(100%, 34rem);
    border: 1px solid var(--oar-border);
    border-radius: var(--oar-radius);
    background: var(--oar-bg-soft);
    padding: 1.25rem 1.5rem 1.5rem;

    audio { display: none; }

    &__label {
      margin: 0 0 1rem;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--oar-ink);
      text-align: left;
    }

    &__row {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    &__btn {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 50%;
      background: var(--oar-ink);
      color: #fff;
      cursor: pointer;
      transition: background 0.25s $ease-expo;

      &:hover { background: var(--oar-text); }

      svg { width: 22px; height: 22px; }
      .oar-player__icon-pause { display: none; }
    }

    &.is-playing .oar-player__btn {
      .oar-player__icon-play { display: none; }
      .oar-player__icon-pause { display: block; }
    }

    &__wave {
      position: relative;
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      gap: 3px;
      height: 44px;
      cursor: pointer;

      &:focus-visible {
        outline: 2px solid var(--oar-ink);
        outline-offset: 4px;
        border-radius: 4px;
      }
    }

    &__bar {
      flex: 1 1 0;
      min-width: 2px;
      border-radius: 2px;
      background: rgba(41, 40, 95, 0.18);
    }

    &__time {
      flex: 0 0 auto;
      font-size: 0.8125rem;
      font-variant-numeric: tabular-nums;
      color: var(--oar-muted);
      white-space: nowrap;
    }

    @media (max-width: 480px) {
      padding: 1rem 1.125rem 1.25rem;

      &__row { gap: 0.75rem; }
      &__btn { width: 42px; height: 42px; }
      &__time { font-size: 0.75rem; }
      // Narrow screens: thinner bars and half of them hidden, so the
      // waveform's min-content width never pushes the time label out of
      // the row (progress JS counts all bars, so the fill stays accurate).
      &__wave { gap: 2px; }
      &__bar { min-width: 1px; }
      &__bar:nth-child(even) { display: none; }
    }
  }

  // Played bars are re-colored by JS toggling .is-played per bar.
  .oar-player__bar.is-played { background: var(--oar-ink); }

  // ── Section close ───────────────────────────────────────────
  .oar-close {
    margin: 3rem 0 0;
    max-width: 40rem;
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--oar-ink);
  }

  .oar-disclaimer {
    margin: 1.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--oar-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .oar-expand summary::after { transition: none; }
    .oar-expand[open] .oar-expand__body { animation: none; }
  }
</style>

<script>
  // Minimal vanilla player for the voice testimonial: play/pause, live
  // waveform tint, click/keyboard seeking. No libraries (see CLAUDE.md).
  const player = document.querySelector<HTMLElement>('.oar-player');
  const audio = player?.querySelector('audio');

  if (player && audio) {
    const btn = player.querySelector<HTMLButtonElement>('.oar-player__btn')!;
    const wave = player.querySelector<HTMLElement>('.oar-player__wave')!;
    const time = player.querySelector<HTMLElement>('.oar-player__time')!;
    const bars = [...player.querySelectorAll<HTMLElement>('.oar-player__bar')];
    const durationLabel = time.dataset.duration ?? '';

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    const paint = () => {
      const dur = audio.duration || 0;
      const pct = dur ? audio.currentTime / dur : 0;
      const lit = Math.round(pct * bars.length);
      bars.forEach((b, i) => b.classList.toggle('is-played', i < lit));
      wave.setAttribute('aria-valuenow', String(Math.round(pct * 100)));
      time.textContent = `${fmt(audio.currentTime)} / ${dur ? fmt(dur) : durationLabel}`;
    };

    btn.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));

    audio.addEventListener('play', () => {
      player.classList.add('is-playing');
      btn.setAttribute('aria-label', 'Pausar el testimonio de Meri');
    });
    audio.addEventListener('pause', () => {
      player.classList.remove('is-playing');
      btn.setAttribute('aria-label', 'Reproducir el testimonio de Meri');
    });
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('loadedmetadata', paint);
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      paint();
    });

    const seekTo = (pct: number) => {
      if (!audio.duration) return;
      audio.currentTime = Math.min(Math.max(pct, 0), 1) * audio.duration;
      paint();
    };

    wave.addEventListener('click', (e) => {
      const r = wave.getBoundingClientRect();
      seekTo((e.clientX - r.left) / r.width);
    });

    wave.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      const step = 5 / audio.duration;
      const pct = audio.currentTime / audio.duration;
      if (e.key === 'ArrowRight') { e.preventDefault(); seekTo(pct + step); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); seekTo(pct - step); }
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        audio.paused ? audio.play() : audio.pause();
      }
    });
  }
</script>
