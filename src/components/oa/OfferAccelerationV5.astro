---
// ── Offer Acceleration — v5 (the default program page) ───────────────────
// Positioning: "Private Career Advisory para profesionales senior".
// V2.1 editorial pass: reduce, unify, elevate. Exactly eleven sections:
// hero → both sides + proof → para quién → outputs → resultados reales →
// acompañamiento → qué incluye → inversión → Purrfect + Kate → FAQ (4) →
// CTA final. The both-sides advantage appears exactly once; Spanish body
// with only the three English brand phrases + product IP names.
// Direction: flat navy/white 2026 system. No gradients, no glows, no
// box-shadow, no purple accent — flat surfaces, navy ink (#29285F),
// border-based elevation, Schibsted Grotesk (loaded globally).
import Layout from '../../layouts/Layout.astro';
import V6Nav from '../v6/V6Nav.astro';
import Footer from '../Footer.astro';
import OAResults from './OAResults.astro';
import { oaContent as c } from '../../content/offerAcceleration';
import { getContent } from '../../content/index';

interface Props {
  /** /offer-acceleration (canonical) is indexable; the /5 test route is not. */
  noindex?: boolean;
}

const { noindex = true } = Astro.props;
const { nav, footer } = getContent('es');
---

<Layout title={c.meta.title} description={c.meta.description} lang="es" noindex={noindex}>

  <main class="oa5">

    <V6Nav content={nav} lang="es" showLangToggle={false}>
      <a slot="extra-cta" href={c.apply.url} id="oa5-apply-btn" class="oa5-btn oa5-btn--solid">
        {c.apply.label}
      </a>
    </V6Nav>

    <!-- ── 1 · Hero ─────────────────────────────────────────────────── -->
    <section class="oa5-hero">
      <p class="oa5-eyebrow oa5-hero__eyebrow">{c.hero.eyebrow}</p>
      <h1 class="oa5-hero__headline">{c.hero.headline}</h1>
      <p class="oa5-hero__category">{c.hero.category}</p>
      <div class="oa5-hero__body">
        <p>{c.hero.para1}</p>
      </div>
      <div class="oa5-hero__ctas">
        <a href={c.apply.url} class="oa5-btn oa5-btn--solid oa5-btn--lg">
          {c.apply.label}
        </a>
      </div>
    </section>

    <!-- ── 2 · Both sides of the hiring table + proof ────────────────── -->
    <section class="oa5-chapter">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.advantage.title}</h2>
      </div>
      <p class="oa5-chapter__subhead oa5-reveal">{c.advantage.body}</p>

      <div class="oa5-sides oa5-reveal">
        {[c.advantage.founder, c.advantage.talent].map((side) => (
          <div class="oa5-sides__card">
            <p class="oa5-eyebrow">{side.kicker}</p>
            <p class="oa5-sides__lead">{side.lead}</p>
            <ul class="oa5-sides__list">
              {side.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <ul class="oa5-proof oa5-reveal">
        {c.advantage.proof.map((p) => (
          <li class="oa5-proof__item">{p}</li>
        ))}
      </ul>
    </section>

    <!-- ── 3 · Para quién es ─────────────────────────────────────────── -->
    <section class="oa5-chapter">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.fit.title}</h2>
      </div>
      <p class="oa5-chapter__subhead oa5-reveal">{c.fit.lead}</p>

      <ul class="oa5-fit oa5-reveal">
        {c.fit.items.map((item) => (
          <li class="oa5-fit__item">{item}</li>
        ))}
      </ul>

      <p class="oa5-statement oa5-reveal">{c.fit.close}</p>
    </section>

    <!-- ── 4 · Qué construimos contigo ───────────────────────────────── -->
    <section class="oa5-chapter">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.build.title}</h2>
      </div>
      <p class="oa5-chapter__subhead oa5-reveal">{c.build.intro}</p>

      <ol class="oa5-how">
        {c.build.bullets.map((b, i) => (
          <li class="oa5-how__item oa5-reveal">
            <span class="oa5-how__num">{String(i + 1).padStart(2, '0')}</span>
            <div class="oa5-how__text">
              <h3>{b.title}</h3>
              <p>{b.body}</p>
              <p class="oa5-how__output">
                <span class="oa5-how__output-label">{c.build.outputLabel}</span>
                {b.output}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── 5 · Resultados reales ─────────────────────────────────────── -->
    <OAResults />

    <!-- ── 6 · Acompañamiento durante procesos reales ────────────────── -->
    <section class="oa5-chapter">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.support.title}</h2>
      </div>
      <p class="oa5-chapter__subhead oa5-reveal">{c.support.intro}</p>

      <div class="oa5-rooms oa5-reveal">
        {c.support.rooms.map((r) => (
          <div class="oa5-rooms__card">
            <h3>{r.name}</h3>
            <p>{r.body}</p>
          </div>
        ))}
      </div>

      <p class="oa5-note oa5-reveal">{c.support.note}</p>
    </section>

    <!-- ── 7 · Qué incluye ───────────────────────────────────────────── -->
    <section class="oa5-chapter">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.includes.title}</h2>
      </div>
      <p class="oa5-chapter__subhead oa5-chapter__subhead--strong oa5-reveal">{c.includes.lead}</p>

      <ul class="oa5-fit oa5-reveal">
        {c.includes.items.map((item) => (
          <li class="oa5-fit__item">{item}</li>
        ))}
      </ul>
    </section>

    <!-- ── 8 · Inversión ─────────────────────────────────────────────── -->
    <section class="oa5-chapter">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.investment.title}</h2>
      </div>
      <p class="oa5-chapter__subhead oa5-reveal">{c.investment.body}</p>

      <div class="oa5-invest oa5-reveal">
        <p class="oa5-invest__price">{c.investment.price}</p>
        <p class="oa5-invest__note">{c.investment.priceNote}</p>
        <div class="oa5-invest__ctas">
          <a href={c.apply.url} class="oa5-btn oa5-btn--solid oa5-btn--lg">
            {c.apply.label}
          </a>
        </div>
      </div>
    </section>

    <!-- ── 9 · Purrfect + Kate (dark section) ────────────────────────── -->
    <section class="oa5-chapter oa5-chapter--dark">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.who.title}</h2>
      </div>

      <div class="oa5-who oa5-reveal">
        <div class="oa5-who__team">
          <h3>{c.who.team.name}</h3>
          <p>{c.who.team.bio}</p>
        </div>
        <div class="oa5-who__kate">
          <h3>{c.who.kate.name}</h3>
          <p class="oa5-who__role">{c.who.kate.role}</p>
          <p>{c.who.kate.bio}</p>
        </div>
      </div>
    </section>

    <!-- ── 10 · FAQ ──────────────────────────────────────────────────── -->
    <section class="oa5-chapter oa5-chapter--narrow">
      <div class="oa5-chapter__head oa5-reveal">
        <h2 class="oa5-chapter__title">{c.faq.title}</h2>
      </div>

      <div class="oa5-faq oa5-reveal">
        {c.faq.items.map((f) => (
          <details class="oa5-faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ── 11 · Final ────────────────────────────────────────────────── -->
    <section class="oa5-final">
      <h2 class="oa5-final__title oa5-reveal">{c.final.title}</h2>
      <p class="oa5-final__note oa5-reveal">{c.final.body}</p>
      <div class="oa5-final__ctas oa5-reveal">
        <a href={c.apply.url} class="oa5-btn oa5-btn--solid oa5-btn--lg">
          {c.final.button}
        </a>
      </div>
    </section>
  </main>

  <Footer content={footer} />
</Layout>

<style lang="scss">
  $ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

  .oa5 {
    // ── Flat navy/white 2026 tokens ──
    --oa5-bg: var(--bg, #ffffff);
    --oa5-bg-soft: var(--bg-soft, #fcfcfb);
    --oa5-surface: var(--bg, #ffffff);
    --oa5-text: var(--text, #1c1c1c);
    --oa5-ink: var(--ink, #29285f);
    --oa5-muted: var(--muted, #6b6b6b);
    --oa5-border: var(--line, rgba(0, 0, 0, 0.08));
    --oa5-dark: var(--dark, #29285f);
    --oa5-on-dark: var(--on-dark, #f3efe6);
    --oa5-radius: var(--radius, 12px);

    background: var(--oa5-bg);
    color: var(--oa5-text);
    font-family: 'Schibsted Grotesk', Arial, sans-serif;
    overflow-x: hidden;
    // Clear the fixed V6 nav
    padding-top: 4rem;

    ::selection {
      background: var(--oa5-ink);
      color: #fff;
    }
  }

  .oa5-eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oa5-ink);
  }

  // ── Buttons ───────────────────────────────────────────────
  .oa5-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--oa5-radius);
    text-decoration: none;
    color: var(--oa5-text);
    border: 1px solid var(--oa5-border);
    background: var(--oa5-bg);
    transition: background 0.25s $ease-expo, border-color 0.25s $ease-expo, color 0.25s $ease-expo;

    &:hover {
      border-color: var(--oa5-ink);
      color: var(--oa5-ink);
    }

    &--solid {
      background: var(--oa5-ink);
      border-color: var(--oa5-ink);
      color: #fff;

      &:hover {
        background: var(--oa5-text);
        border-color: var(--oa5-text);
        color: #fff;
      }
    }

    &--lg { padding: 16px 34px; font-size: 0.9375rem; }
  }

  // ── Hero ──────────────────────────────────────────────────
  .oa5-hero {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 120px) clamp(1.5rem, 5vw, 2rem) clamp(56px, 7vw, 88px);

    &__eyebrow {
      margin-bottom: 1.75rem;
    }

    &__headline {
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(2.5rem, 6vw, 4.75rem);
      font-weight: 700;
      line-height: 1.04;
      letter-spacing: -0.02em;
      margin: 0;
      max-width: 18ch;
      color: var(--oa5-ink);
    }

    &__category {
      margin: 1.5rem 0 0;
      font-size: clamp(1.125rem, 2vw, 1.375rem);
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--oa5-text);
    }

    &__body {
      max-width: 44rem;
      margin-top: 1rem;

      p {
        margin: 0;
        font-size: 1.0625rem;
        line-height: 1.65;
        color: var(--oa5-muted);
      }
    }

    &__ctas {
      margin-top: 2.25rem;
    }
  }

  // ── Chapters ──────────────────────────────────────────────
  .oa5-chapter {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 80px) clamp(1.5rem, 5vw, 2rem);
    border-top: 1px solid var(--oa5-border);

    &--narrow { max-width: 760px; }

    &--dark {
      max-width: none;
      background: var(--oa5-dark);
      color: var(--oa5-on-dark);
      border-top: none;

      .oa5-chapter__title { color: var(--oa5-on-dark); }
    }

    &__head {
      margin-bottom: 2.5rem;
    }

    &__title {
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.875rem, 3.4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin: 0;
      color: var(--oa5-ink);
      max-width: 22ch;
    }

    &__subhead {
      max-width: 46rem;
      color: var(--oa5-muted);
      margin: -1rem 0 3rem;
      font-size: 1.0625rem;
      line-height: 1.65;

      &--strong {
        color: var(--oa5-text);
        font-weight: 500;
        font-size: 1.1875rem;
      }
    }
  }

  // dark section inner content needs a centered max-width wrapper
  .oa5-chapter--dark > .oa5-chapter__head,
  .oa5-chapter--dark > .oa5-who {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .oa5-statement {
    margin: 3.5rem 0 0;
    max-width: 40rem;
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--oa5-ink);
  }

  .oa5-note {
    margin: 2.5rem 0 0;
    max-width: 46rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--oa5-muted);
  }

  // ── Both sides ────────────────────────────────────────────
  .oa5-sides {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;

    @media (max-width: 767px) { grid-template-columns: 1fr; }

    &__card {
      border: 1px solid var(--oa5-border);
      border-radius: var(--oa5-radius);
      padding: 2rem;
      background: var(--oa5-surface);
    }

    &__lead {
      margin: 1.25rem 0 0;
      font-size: 1.0625rem;
      font-weight: 500;
      line-height: 1.5;
      color: var(--oa5-text);
    }

    &__list {
      list-style: none;
      margin: 1.25rem 0 0;
      padding: 0;

      li {
        position: relative;
        padding: 0.5rem 0 0.5rem 1.25rem;
        font-size: 0.9375rem;
        line-height: 1.6;
        color: var(--oa5-muted);
        border-top: 1px solid var(--oa5-border);

        &:first-child { border-top: none; }

        // Round bullet, vertically centered on the first text line.
        &::before {
          content: '';
          position: absolute;
          left: 1px;
          top: calc(0.5rem + 0.8em - 3px);
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: var(--oa5-ink);
        }
      }
    }
  }

  // Proof strip under the advantage cards
  .oa5-proof {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--oa5-border);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
  }

  .oa5-proof__item {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--oa5-text);

    &:not(:last-child)::after {
      content: '·';
      position: absolute;
      right: -1.4rem;
      color: var(--oa5-muted);
    }
  }

  // ── Fit checklist (also reused by "qué incluye") ──────────
  .oa5-fit {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 56rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;

    @media (max-width: 767px) { grid-template-columns: 1fr; }
  }

  .oa5-fit__item {
    position: relative;
    padding: 1rem 0 1rem 1.375rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--oa5-text);
    border-bottom: 1px solid var(--oa5-border);

    // Round bullet, vertically centered on the first text line.
    &::before {
      content: '';
      position: absolute;
      left: 1px;
      top: calc(1rem + 0.8em - 3px);
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--oa5-ink);
    }
  }

  // ── Build: the five decisions ─────────────────────────────
  .oa5-how {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 56rem;
  }

  .oa5-how__item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--oa5-border);

    &:first-child { border-top: 1px solid var(--oa5-border); }

    .oa5-how__num {
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--oa5-ink);
      line-height: 1.4;
    }

    .oa5-how__text {
      h3 {
        margin: 0 0 0.5rem;
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--oa5-text);
      }

      p {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--oa5-muted);
        max-width: 42rem;
      }
    }

    .oa5-how__output {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      padding: 0.375rem 0.875rem;
      border: 1px solid var(--oa5-border);
      border-radius: 999px;
      background: var(--oa5-bg-soft);
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--oa5-ink);
    }

    .oa5-how__output-label {
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--oa5-muted);
    }

    @media (max-width: 480px) {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  // ── Support rooms ─────────────────────────────────────────
  .oa5-rooms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;

    @media (max-width: 991px) { grid-template-columns: 1fr; }

    &__card {
      border: 1px solid var(--oa5-border);
      border-radius: var(--oa5-radius);
      padding: 2rem;
      background: var(--oa5-surface);

      h3 {
        margin: 0 0 0.75rem;
        font-family: 'Schibsted Grotesk', sans-serif;
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--oa5-ink);
      }

      p {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--oa5-muted);
      }
    }
  }

  // ── Investment ────────────────────────────────────────────
  .oa5-invest {
    &__price {
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.75rem, 3.6vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0;
      color: var(--oa5-ink);
    }

    &__note {
      margin-top: 0.75rem;
      color: var(--oa5-muted);
      font-size: 1.0625rem;
    }

    &__ctas {
      margin-top: 2rem;
    }
  }

  // ── Who (dark) ────────────────────────────────────────────
  .oa5-who {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1.5rem;

    @media (max-width: 767px) { grid-template-columns: 1fr; }

    h3 {
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: 1.375rem;
      font-weight: 700;
      margin: 0 0 0.375rem;
      color: var(--oa5-on-dark);
    }

    p {
      margin: 1rem 0 0;
      font-size: 0.9375rem;
      line-height: 1.7;
      color: rgba(243, 239, 230, 0.78);
    }

    &__role {
      margin-top: 0 !important;
      font-size: 0.8125rem !important;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(243, 239, 230, 0.6) !important;
    }

    &__kate,
    &__team {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(243, 239, 230, 0.16);
      border-radius: var(--oa5-radius);
      padding: 2rem;
    }
  }

  // ── FAQ ───────────────────────────────────────────────────
  .oa5-faq {
    max-width: 46rem;

    &__item {
      border-bottom: 1px solid var(--oa5-border);

      &:first-child { border-top: 1px solid var(--oa5-border); }

      summary {
        padding: 1.5rem 2.5rem 1.5rem 0;
        font-size: 1.0625rem;
        font-weight: 500;
        color: var(--oa5-text);
        cursor: pointer;
        list-style: none;
        position: relative;

        &::-webkit-details-marker { display: none; }

        &::after {
          content: '+';
          position: absolute;
          right: 0.25rem;
          top: 50%;
          transform: translateY(-50%);
          color: var(--oa5-ink);
          font-size: 1.375rem;
          font-weight: 400;
          transition: transform 0.25s $ease-expo;
        }
      }

      &[open] summary::after { transform: translateY(-50%) rotate(45deg); }

      p {
        margin: 0 0 1.5rem;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--oa5-muted);
        max-width: 42rem;
      }
    }
  }

  // ── Final ─────────────────────────────────────────────────
  .oa5-final {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 110px) clamp(1.5rem, 5vw, 2rem) 3rem;
    text-align: center;
    border-top: 1px solid var(--oa5-border);

    &__title {
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(2rem, 4.5vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin: 0 auto;
      max-width: 18ch;
      color: var(--oa5-ink);
    }

    &__note {
      max-width: 34rem;
      margin: 1.5rem auto 0;
      color: var(--oa5-muted);
      font-size: 1rem;
      line-height: 1.65;
    }

    &__ctas {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 2.5rem;
    }
  }

  // ── Scroll reveals ────────────────────────────────────────
  .oa5-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s $ease-expo, transform 0.8s $ease-expo;

    &.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oa5-reveal { transition: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.oa5-reveal');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  reveals.forEach((el) => io.observe(el));
</script>
