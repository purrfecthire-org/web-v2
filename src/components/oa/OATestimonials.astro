---
// ── OA testimonials — candidate proof section ────────────────────────────
// Two stories, deliberately different in format so they read as two
// different candidates: Alejandro (named, face + verifiable LinkedIn) and
// Meri (audio-only, first name only, at her request — the voice card leads
// with a player instead of a photo, and the privacy note is stated rather
// than hidden). Future named testimonials append to
// oaContent.testimonials.items; future voice ones extend `voice`.
import { oaContent as c } from '../../content/offerAcceleration';

const t = c.testimonials;
const p = t.items[0];
const v = t.voice;

// Split a paragraph on its exact highlight substring so the markup can
// emphasize it without storing HTML in the content file.
const splitHl = (paragraphs: string[], highlights: string[]) =>
  paragraphs.map((text, i) => {
    const hl: string | undefined = highlights[i];
    const at = hl ? text.indexOf(hl) : -1;
    return at >= 0
      ? { pre: text.slice(0, at), hl: hl as string, post: text.slice(at + (hl as string).length) }
      : { pre: text, hl: '', post: '' };
  });

const withHl = splitHl(p.paragraphs, p.highlights);
const voiceHl = splitHl(v.paragraphs, v.highlights);

// Decorative waveform: deterministic bar heights (percent) so the SSR
// output is stable. Purely visual — seeking works on the whole strip.
const BARS = Array.from({ length: 48 }, (_, i) => {
  const wave = Math.abs(Math.sin(i * 0.55)) * 0.55 + Math.abs(Math.sin(i * 1.9 + 2)) * 0.45;
  return Math.round(18 + wave * 72);
});
---

<section class="oat" id="testimonios">
  <div class="oat-inner">
    <div class="oat-head reveal">
      <h2 class="oat-title">{t.title}</h2>
      <p class="oat-intro">{t.intro}</p>
    </div>

    <div class="oat-card reveal">
      <p class="oat-kicker">{p.kicker}</p>
      <span class="oat-card__mark" aria-hidden="true">“</span>
      <blockquote class="oat-card__quote">{p.pull2}</blockquote>

      <picture class="oat-photo oat-avatar">
        <source srcset={p.photoWebp} type="image/webp" />
        <img src={p.photo} alt={p.photoAlt} loading="lazy" width="900" height="1125" />
      </picture>

      <div class="oat-card__person">
        <span class="oat-name">{p.name}</span>
        <a class="oat-link" href={p.linkedin} target="_blank" rel="noopener noreferrer">
          {t.linkedinCta} ↗
        </a>
      </div>

      <details class="oat-expand">
        <summary>
          <span class="oat-expand__more">{t.readMore}</span>
          <span class="oat-expand__less">{t.readLess}</span>
        </summary>
        <div class="oat-expand__body">
          {withHl.map((seg) => (
            <p>
              {seg.pre}{seg.hl && <strong class="oat-hl">{seg.hl}</strong>}{seg.post}
            </p>
          ))}
        </div>
      </details>
    </div>

    <hr class="oat-divider" />

    <!-- ── Voice story: Meri (audio-only at her request) ─────────────── -->
    <div class="oat-card oat-voice reveal">
      <p class="oat-kicker">{v.kicker}</p>
      <span class="oat-card__mark" aria-hidden="true">“</span>
      <blockquote class="oat-card__quote oat-voice__quote">{v.pull}</blockquote>

      <div class="oat-player">
        <p class="oat-player__label">{v.audioLabel}</p>
        <audio preload="metadata" src={v.audioSrc}></audio>
        <div class="oat-player__row">
          <button class="oat-player__btn" type="button" aria-label="Reproducir el testimonio de Meri">
            <svg class="oat-player__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5-11-6.5z" />
            </svg>
            <svg class="oat-player__icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="7" y="5" width="3.5" height="14" rx="1" />
              <rect x="13.5" y="5" width="3.5" height="14" rx="1" />
            </svg>
          </button>

          <div class="oat-player__wave" role="slider" tabindex="0" aria-label="Progreso del audio"
            aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            {BARS.map((h) => (
              <span class="oat-player__bar" style={`height:${h}%`}></span>
            ))}
          </div>

          <span class="oat-player__time" data-duration={v.audioDuration}>0:00&thinsp;/&thinsp;{v.audioDuration}</span>
        </div>
      </div>

      <div class="oat-card__person">
        <span class="oat-name">{v.name}</span>
        <span class="oat-voice__role">{v.role}</span>
      </div>

      <p class="oat-voice__privacy">{v.privacyNote}</p>

      <details class="oat-expand">
        <summary>
          <span class="oat-expand__more">{v.transcriptMore}</span>
          <span class="oat-expand__less">{v.transcriptLess}</span>
        </summary>
        <div class="oat-expand__body">
          <p class="oat-voice__transcript-note">{v.transcriptNote}</p>
          {voiceHl.map((seg) => (
            <p>
              {seg.pre}{seg.hl && <strong class="oat-hl">{seg.hl}</strong>}{seg.post}
            </p>
          ))}
        </div>
      </details>
    </div>
  </div>
</section>

<style lang="scss">
  $ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

  .oat {
    --oat-ink: var(--ink, #29285f);
    --oat-text: var(--text, #1c1c1c);
    --oat-muted: var(--muted, #6b6b6b);
    --oat-border: var(--line, rgba(0, 0, 0, 0.08));
    --oat-bg: var(--bg, #ffffff);
    --oat-bg-soft: var(--bg-soft, #fcfcfb);
    --oat-radius: var(--radius, 12px);

    position: relative;
    font-family: 'Schibsted Grotesk', Arial, sans-serif;
    background: var(--oat-bg-soft);
    border-top: 1px solid var(--oat-border);
    padding: clamp(48px, 7vw, 80px) clamp(1.5rem, 5vw, 2rem);
  }

  .oat-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .oat-head {
    margin-bottom: 2.5rem;
  }

  .oat-title {
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.875rem, 3.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 auto;
    color: var(--oat-ink);
    max-width: 22ch;
  }

  .oat-intro {
    max-width: 46rem;
    margin: 1.25rem auto 0;
    color: var(--oat-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  // ── Duotone portrait: navy monotone at rest, real color on hover ───────
  .oat-photo {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--oat-border);
    border-radius: var(--oat-radius);
    background: var(--oat-ink);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.02);
      transition: filter 0.6s $ease-expo, transform 0.6s $ease-expo;
    }

    // Navy tint over the grayscale image = single-color portrait.
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--oat-ink);
      mix-blend-mode: color;
      opacity: 1;
      transition: opacity 0.6s $ease-expo;
      pointer-events: none;
    }

    &:hover {
      img { filter: none; transform: scale(1.02); }
      &::after { opacity: 0; }
    }
  }

  .oat-avatar {
    width: 96px;
    height: 96px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .oat-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--oat-text);
  }

  .oat-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--oat-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s $ease-expo;

    &:hover { border-color: var(--oat-ink); }
  }

  .oat-hl {
    font-weight: 500;
    color: var(--oat-ink);
  }

  // ── Read-more (details/summary, no JS) ─────────────────────────────────
  .oat-expand {
    text-align: center;

    summary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      list-style: none;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--oat-ink);

      &::-webkit-details-marker { display: none; }

      &::after {
        content: '+';
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1;
        transition: transform 0.25s $ease-expo;
      }
    }

    &[open] summary::after { transform: rotate(45deg); }

    .oat-expand__less { display: none; }
    &[open] .oat-expand__more { display: none; }
    &[open] .oat-expand__less { display: inline; }

    &__body {
      margin-top: 1.25rem;
      max-width: 42rem;
      margin-inline: auto;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 1rem;

      p {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--oat-muted);
      }
    }

    &[open] .oat-expand__body { animation: oat-fade 0.45s $ease-expo; }
  }

  @keyframes oat-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  // ── Card ────────────────────────────────────────────────────────────────
  .oat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1rem;

    &__mark {
      font-family: Georgia, serif;
      font-size: clamp(4rem, 8vw, 6.5rem);
      line-height: 0.5;
      color: var(--oat-ink);
      opacity: 0.18;
      user-select: none;
    }

    &__quote {
      margin: 0 auto;
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.5rem, 3.2vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.25;
      color: var(--oat-ink);
      max-width: 24ch;
    }

    &__person {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
    }
  }

  // ── Story kicker + divider between the two candidates ──────────────────
  .oat-kicker {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oat-muted);
  }

  .oat-divider {
    max-width: 220px;
    margin: clamp(3rem, 6vw, 4.5rem) auto;
    border: none;
    border-top: 1px solid var(--oat-border);
  }

  // ── Voice story (Meri) ─────────────────────────────────────────────────
  .oat-voice {
    &__quote {
      font-size: clamp(1.375rem, 2.6vw, 2rem);
      max-width: 28ch;
    }

    &__role {
      font-size: 0.8125rem;
      color: var(--oat-muted);
    }

    &__privacy {
      margin: -0.25rem auto 0;
      max-width: 34rem;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--oat-muted);
    }

    &__transcript-note {
      font-size: 0.75rem !important;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--oat-muted);
    }
  }

  // Custom flat player: navy play button + decorative waveform whose navy
  // fill tracks playback. The real <audio> stays hidden.
  .oat-player {
    width: min(100%, 34rem);
    border: 1px solid var(--oat-border);
    border-radius: var(--oat-radius);
    background: var(--oat-bg);
    padding: 1.25rem 1.5rem 1.5rem;

    audio { display: none; }

    &__label {
      margin: 0 0 1rem;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--oat-ink);
      text-align: left;
    }

    &__row {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    &__btn {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 50%;
      background: var(--oat-ink);
      color: #fff;
      cursor: pointer;
      transition: background 0.25s $ease-expo;

      &:hover { background: var(--oat-text); }

      svg { width: 22px; height: 22px; }
      .oat-player__icon-pause { display: none; }
    }

    &.is-playing .oat-player__btn {
      .oat-player__icon-play { display: none; }
      .oat-player__icon-pause { display: block; }
    }

    &__wave {
      position: relative;
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      gap: 3px;
      height: 44px;
      cursor: pointer;

      &:focus-visible {
        outline: 2px solid var(--oat-ink);
        outline-offset: 4px;
        border-radius: 4px;
      }
    }

    &__bar {
      flex: 1 1 0;
      min-width: 2px;
      border-radius: 2px;
      background: rgba(41, 40, 95, 0.18);
    }

    &__time {
      flex: 0 0 auto;
      font-size: 0.8125rem;
      font-variant-numeric: tabular-nums;
      color: var(--oat-muted);
      white-space: nowrap;
    }

    @media (max-width: 480px) {
      padding: 1rem 1.125rem 1.25rem;

      &__row { gap: 0.75rem; }
      &__btn { width: 42px; height: 42px; }
      &__time { font-size: 0.75rem; }
      // Narrow screens: thinner bars and half of them hidden, so the
      // waveform's min-content width never pushes the time label out of
      // the row (progress JS counts all bars, so the fill stays accurate).
      &__wave { gap: 2px; }
      &__bar { min-width: 1px; }
      &__bar:nth-child(even) { display: none; }
    }
  }

  // Played bars are re-colored by JS toggling .is-played per bar — cheaper
  // and cleaner than a masked overlay.
  .oat-player__bar.is-played { background: var(--oat-ink); }

  @media (prefers-reduced-motion: reduce) {
    .oat-photo img,
    .oat-photo::after,
    .oat-expand summary::after {
      transition: none;
    }

    .oat-expand[open] .oat-expand__body { animation: none; }
  }
</style>

<script>
  // Minimal vanilla player for the voice testimonial: play/pause, live
  // waveform tint, click/keyboard seeking. No libraries (see CLAUDE.md).
  const player = document.querySelector<HTMLElement>('.oat-player');
  const audio = player?.querySelector('audio');

  if (player && audio) {
    const btn = player.querySelector<HTMLButtonElement>('.oat-player__btn')!;
    const wave = player.querySelector<HTMLElement>('.oat-player__wave')!;
    const time = player.querySelector<HTMLElement>('.oat-player__time')!;
    const bars = [...player.querySelectorAll<HTMLElement>('.oat-player__bar')];
    const durationLabel = time.dataset.duration ?? '';

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    const paint = () => {
      const dur = audio.duration || 0;
      const pct = dur ? audio.currentTime / dur : 0;
      const lit = Math.round(pct * bars.length);
      bars.forEach((b, i) => b.classList.toggle('is-played', i < lit));
      wave.setAttribute('aria-valuenow', String(Math.round(pct * 100)));
      time.textContent = `${fmt(audio.currentTime)} / ${dur ? fmt(dur) : durationLabel}`;
    };

    btn.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));

    audio.addEventListener('play', () => {
      player.classList.add('is-playing');
      btn.setAttribute('aria-label', 'Pausar el testimonio de Meri');
    });
    audio.addEventListener('pause', () => {
      player.classList.remove('is-playing');
      btn.setAttribute('aria-label', 'Reproducir el testimonio de Meri');
    });
    audio.addEventListener('timeupdate', paint);
    audio.addEventListener('loadedmetadata', paint);
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      paint();
    });

    const seekTo = (pct: number) => {
      if (!audio.duration) return;
      audio.currentTime = Math.min(Math.max(pct, 0), 1) * audio.duration;
      paint();
    };

    wave.addEventListener('click', (e) => {
      const r = wave.getBoundingClientRect();
      seekTo((e.clientX - r.left) / r.width);
    });

    wave.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      const step = 5 / audio.duration;
      const pct = audio.currentTime / audio.duration;
      if (e.key === 'ArrowRight') { e.preventDefault(); seekTo(pct + step); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); seekTo(pct - step); }
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        audio.paused ? audio.play() : audio.pause();
      }
    });
  }
</script>
