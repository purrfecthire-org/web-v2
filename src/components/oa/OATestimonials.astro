---
// ── OA testimonials — candidate proof section ────────────────────────────
// Replaces the old "cases" grid on /offer-acceleration. Full-bleed soft
// stage, centered navy pull quote, duotone portrait (navy monotone at rest,
// real color on hover) and an expandable full testimonial. First entry is
// Alejandro's; future cohort testimonials append to
// oaContent.testimonials.items and render as additional .oat sections.
import { oaContent as c } from '../../content/offerAcceleration';

const t = c.testimonials;
const p = t.items[0];

// Split each paragraph on its exact highlight substring so the markup can
// emphasize it without storing HTML in the content file.
const withHl = p.paragraphs.map((text, i) => {
  const hl: string | undefined = p.highlights[i];
  const at = hl ? text.indexOf(hl) : -1;
  return at >= 0
    ? { pre: text.slice(0, at), hl: hl as string, post: text.slice(at + (hl as string).length) }
    : { pre: text, hl: '', post: '' };
});
---

<section class="oat" id="testimonios">
  <div class="oat-inner">
    <div class="oat-head reveal">
      <h2 class="oat-title">{t.title}</h2>
      <p class="oat-intro">{t.intro}</p>
    </div>

    <div class="oat-card reveal">
      <span class="oat-card__mark" aria-hidden="true">“</span>
      <blockquote class="oat-card__quote">{p.pull2}</blockquote>

      <span class="oat-photo oat-avatar">
        <img src={p.photo} alt={p.photoAlt} loading="lazy" width="900" height="1125" />
      </span>

      <div class="oat-card__person">
        <span class="oat-name">{p.name}</span>
        <a class="oat-link" href={p.linkedin} target="_blank" rel="noopener noreferrer">
          {t.linkedinCta} ↗
        </a>
      </div>

      <details class="oat-expand">
        <summary>
          <span class="oat-expand__more">{t.readMore}</span>
          <span class="oat-expand__less">{t.readLess}</span>
        </summary>
        <div class="oat-expand__body">
          {withHl.map((seg) => (
            <p>
              {seg.pre}{seg.hl && <strong class="oat-hl">{seg.hl}</strong>}{seg.post}
            </p>
          ))}
        </div>
      </details>
    </div>
  </div>
</section>

<style lang="scss">
  $ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

  .oat {
    --oat-ink: var(--ink, #29285f);
    --oat-text: var(--text, #1c1c1c);
    --oat-muted: var(--muted, #6b6b6b);
    --oat-border: var(--line, rgba(0, 0, 0, 0.08));
    --oat-bg: var(--bg, #ffffff);
    --oat-bg-soft: var(--bg-soft, #fcfcfb);
    --oat-radius: var(--radius, 12px);

    position: relative;
    font-family: 'Schibsted Grotesk', Arial, sans-serif;
    background: var(--oat-bg-soft);
    border-top: 1px solid var(--oat-border);
    padding: clamp(48px, 7vw, 80px) clamp(1.5rem, 5vw, 2rem);
  }

  .oat-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .oat-head {
    margin-bottom: 2.5rem;
  }

  .oat-title {
    font-family: 'Schibsted Grotesk', sans-serif;
    font-size: clamp(1.875rem, 3.4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 auto;
    color: var(--oat-ink);
    max-width: 22ch;
  }

  .oat-intro {
    max-width: 46rem;
    margin: 1.25rem auto 0;
    color: var(--oat-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  // ── Duotone portrait: navy monotone at rest, real color on hover ───────
  .oat-photo {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--oat-border);
    border-radius: var(--oat-radius);
    background: var(--oat-ink);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.02);
      transition: filter 0.6s $ease-expo, transform 0.6s $ease-expo;
    }

    // Navy tint over the grayscale image = single-color portrait.
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--oat-ink);
      mix-blend-mode: color;
      opacity: 1;
      transition: opacity 0.6s $ease-expo;
      pointer-events: none;
    }

    &:hover {
      img { filter: none; transform: scale(1.02); }
      &::after { opacity: 0; }
    }
  }

  .oat-avatar {
    width: 96px;
    height: 96px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .oat-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--oat-text);
  }

  .oat-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--oat-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s $ease-expo;

    &:hover { border-color: var(--oat-ink); }
  }

  .oat-hl {
    font-weight: 500;
    color: var(--oat-ink);
  }

  // ── Read-more (details/summary, no JS) ─────────────────────────────────
  .oat-expand {
    text-align: center;

    summary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      list-style: none;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--oat-ink);

      &::-webkit-details-marker { display: none; }

      &::after {
        content: '+';
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1;
        transition: transform 0.25s $ease-expo;
      }
    }

    &[open] summary::after { transform: rotate(45deg); }

    .oat-expand__less { display: none; }
    &[open] .oat-expand__more { display: none; }
    &[open] .oat-expand__less { display: inline; }

    &__body {
      margin-top: 1.25rem;
      max-width: 42rem;
      margin-inline: auto;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 1rem;

      p {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--oat-muted);
      }
    }

    &[open] .oat-expand__body { animation: oat-fade 0.45s $ease-expo; }
  }

  @keyframes oat-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  // ── Card ────────────────────────────────────────────────────────────────
  .oat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1rem;

    &__mark {
      font-family: Georgia, serif;
      font-size: clamp(4rem, 8vw, 6.5rem);
      line-height: 0.5;
      color: var(--oat-ink);
      opacity: 0.18;
      user-select: none;
    }

    &__quote {
      margin: 0 auto;
      font-family: 'Schibsted Grotesk', sans-serif;
      font-size: clamp(1.5rem, 3.2vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.25;
      color: var(--oat-ink);
      max-width: 24ch;
    }

    &__person {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oat-photo img,
    .oat-photo::after,
    .oat-expand summary::after {
      transition: none;
    }

    .oat-expand[open] .oat-expand__body { animation: none; }
  }
</style>
