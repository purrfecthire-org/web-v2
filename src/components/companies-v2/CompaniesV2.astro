---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getCompaniesV2 } from '../../content/companiesV2';
import { CLIENT_BRANDS } from '../../content/clientBrands';
import { BOOKING_B2B as BOOKING_URL } from '../../content/links';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getCompaniesV2(lang);
const situations = t.situations.items.filter(({ title }) => ['The role keeps changing', 'The people you want are not applying', 'The hire has to outgrow the role'].includes(title));
const searches = t.selectedSearches.items.filter((search) => search.outcome).slice(0, 2);
const voices = t.proof.voices.filter(({ name }) => ['Fabián Torres', 'Chen Atlas'].includes(name)).slice(0, 2);
const voiceBrand = (name: string) => CLIENT_BRANDS.find(({ id }) => id === (name === 'Fabián Torres' ? 'trebol' : 'optery'))!;

---

<Shell
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  theme="light"
  navCta={{ label: t.hero.cta, href: BOOKING_URL }}
  journey="companies"
>
  <section class="h3-hero fc-hero" aria-labelledby="fc-title">
    <div class="h3-wrap h3-hero__grid">
      <div class="h3-hero__copy">
        <p class="h3-eyebrow">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1" id="fc-title">{t.hero.headline}</h1>
        <p class="h3-hero__sub">{t.hero.sub}</p>
        <p class="fc-credential">{t.hero.credential}</p>
        <div class="fc-hero__actions"><a href={BOOKING_URL} data-cta="companies-hero-booking" class="h3-btn h3-btn--ink h3-hero__cta fc-hero__cta">
          {t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span>
        </a>
        </div>
        <p class="fc-microcopy">{t.hero.microcopy}</p>
      </div>
      <figure class="h3-hero__media fc-hero__media" style={{ "--photo-desktop": "8 / 5", "--photo-mobile": "4 / 3" }}>
        <img src="/photos/editorial/walking-conversation.webp" alt="Illustrative scene of three people in conversation while walking through the city." width="1200" height="800" decoding="async" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="fc-situations" aria-labelledby="fc-situations-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.situations.eyebrow}</p>
      <h2 class="h3-h2 fc-situations__h2" id="fc-situations-title">{t.situations.headline}</h2>
      <ul class="fc-situations__list">
        {situations.map((situation) => (
          <li class="fc-situation">
            <h3>{situation.title}</h3>
            <p>{situation.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="fc-method" aria-labelledby="fc-method-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.method.eyebrow}</p>
      <h2 class="h3-h2 fc-method__h2" id="fc-method-title">{t.method.headline}</h2>
      <ol class="fc-steps">
        {t.method.steps.map((step) => (
          <li class="fc-step">
            <span class="fc-step__id" aria-hidden="true">{step.id}</span>
            <h3 class="fc-step__title">{step.title}</h3>
            <p class="fc-step__body">{step.body}</p>
          </li>
        ))}
      </ol>
      <div class="fc-method__links" id="candidate-brief">
        <a href="/search-calibration" data-cta="companies-calibration-example" class="h3-link">{t.read.sampleLabel}<span class="h3-arrow" aria-hidden="true">→</span></a>
        <a href="/candidate-brief-sample" data-cta="companies-candidate-brief-sample" class="h3-link">{t.evidence.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="fc-proof" aria-labelledby="fc-proof-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.proof.eyebrow}</p>
      <h2 class="h3-h2 fc-proof__h2" id="fc-proof-title">{t.proof.headline}</h2>
      <!-- Keep the anonymous search separate from named feedback. It is not
           attributed to either speaker or counted as an additional outcome. -->
      {searches.length > 0 && <div class="fc-searches" id="selected-searches">
        <p class="h3-eyebrow">{t.selectedSearches.eyebrow}</p>
        <div class="fc-searches__list">
          {searches.map((search) => (
            <article class="fc-search">
              <div class="fc-search__narrative">
                <p class="h3-eyebrow">{[search.company, search.stage, search.role].filter(Boolean).join(' · ')}</p>
                <h3>{search.title}</h3>
                <p class="fc-search__problem">{search.problem}</p>
                {search.outcome && <dl><div><dt>{t.selectedSearches.outcomeLabel}</dt><dd>{search.outcome}</dd></div></dl>}
                <details class="fc-search__detail">
                  <summary>Read the search approach <span aria-hidden="true">+</span></summary>
                  <dl>
                    <div><dt>{t.selectedSearches.interventionLabel}</dt><dd>{search.intervention}</dd></div>
                    {search.evidence && <div><dt>Evidence to examine</dt><dd>{search.evidence}</dd></div>}
                  </dl>
                </details>
              </div>
            </article>
          ))}
        </div>
      </div>}
      <div class="fc-proof__voices">
      {voices.map((voice) => (
        <figure class="fc-quote">
          <div class="fc-quote__identity">
          {voice.photo && <div class="fc-quote__portrait">
            <picture>
              {voice.photoWebp && <source srcset={voice.photoWebp} type="image/webp" />}
              <img src={voice.photo} alt={voice.name} width="480" height="480" loading="lazy" decoding="async" />
            </picture>
          </div>}
          <a class="fc-quote__brand" href={voiceBrand(voice.name).href} target="_blank" rel="noopener noreferrer" aria-label={voiceBrand(voice.name).name}>
            <img src={`/clients/neutral/${voiceBrand(voice.name).id}.png`} alt={voiceBrand(voice.name).name} width="480" height="192" loading="lazy" decoding="async" />
          </a>
          </div>
          <div class="fc-quote__body">
            {voice.excerptLabel && <p class="h3-eyebrow fc-quote__excerpt">{voice.excerptLabel}</p>}
            <blockquote>“{voice.quote}”</blockquote>
            <figcaption>
              <span class="fc-quote__name">{voice.name}</span>
              <span class="fc-quote__role">{voice.role}</span>
              {voice.context && <span class="fc-quote__context">{voice.context}</span>}
            </figcaption>
          </div>
        </figure>
      ))}
      </div>
    </div>
  </section>

  <section class="fc-models" aria-labelledby="fc-models-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.models.eyebrow}</p>
      <h2 class="h3-h2 fc-models__h2" id="fc-models-title">{t.models.headline}</h2>
      <ul class="fc-models__list">
        {t.models.items.map((model) => (
          <li class="fc-model">
            <h3 class="fc-model__name">{model.name}</h3>
            <p class="fc-model__note">{model.note}</p>
          </li>
        ))}
      </ul>
      <div class="fc-models__close">
        <p class="h3-body">{t.close.body}</p>
        <a href={BOOKING_URL} data-cta="companies-close-booking" class="h3-btn h3-btn--ink">{t.close.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Shell>

<style lang="scss">
  .fc-hero__actions { display: flex; margin-top: var(--space-stack); }
  .fc-hero__actions .h3-hero__cta { margin-top: 0; }
  .fc-hero__media { margin: 0; border-radius: var(--radius-card); overflow: hidden; }
  .fc-hero__media img { object-position: 42% 42%; }
  .fc-credential, .fc-microcopy { margin-top: var(--space-2); color: var(--muted); font-size: var(--type-caption); line-height: 1.5; max-width: 34rem; }
  .fc-situations, .fc-method, .fc-proof, .fc-models { padding-block: var(--space-section); }
  .fc-situations__h2, .fc-method__h2, .fc-proof__h2, .fc-models__h2 { max-width: 26ch; }
  .fc-situations__list, .fc-steps, .fc-proof__voices, .fc-models__list { display: grid; gap: var(--space-grid); margin-top: var(--space-stack); }
  .fc-situation, .fc-step, .fc-search, .fc-quote, .fc-model { min-width: 0; }
  .fc-situation, .fc-step, .fc-model { padding-top: var(--space-stack); border-top: 1px solid var(--line); }
  .fc-situation h3, .fc-step__title, .fc-search h3, .fc-model__name { font-family: var(--h-sans); font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .fc-situation p, .fc-step__body, .fc-search__problem, .fc-model__note { margin-top: var(--space-2); max-width: 40rem; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .fc-step__id { display: block; margin-bottom: var(--space-2); font-size: var(--type-caption); color: var(--muted); font-variant-numeric: tabular-nums; line-height: 1.5; }
  .fc-method__links { margin-top: var(--space-stack); display: flex; flex-wrap: wrap; column-gap: var(--space-grid); row-gap: var(--space-2); }
  .fc-method__links a { max-width: 100%; }
  .fc-searches { margin-top: var(--space-grid); }
  .fc-searches__list { margin-top: var(--space-stack); }
  .fc-search { padding-block: var(--space-stack); border-block: 1px solid var(--line); }
  .fc-search__narrative { min-width: 0; }
  .fc-search h3 { margin-top: var(--space-2); }
  .fc-search__detail { margin-top: var(--space-stack); }
  .fc-search__detail summary { cursor: pointer; display: flex; justify-content: space-between; gap: var(--space-2); padding-block: var(--space-1); font-size: var(--type-ui); font-weight: 500; list-style: none; line-height: 1.5; }
  .fc-search__detail summary::-webkit-details-marker { display: none; }
  .fc-search__detail[open] summary span { transform: rotate(45deg); }
  .fc-search dl { margin-top: var(--space-stack); display: grid; gap: var(--space-stack); }
  .fc-search dt { font-size: var(--type-caption); font-weight: 500; line-height: 1.5; }
  .fc-search dd { margin: var(--space-1) 0 0; color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .fc-proof__voices { margin-top: var(--space-grid); }
  .fc-quote { margin: 0; display: flex; flex-direction: column; padding-top: var(--space-stack); }
  .fc-quote__identity { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-stack); }
  .fc-quote__body { display: flex; flex-direction: column; flex: 1; }
  .fc-quote__excerpt { margin-bottom: var(--space-2); }
  .fc-quote blockquote { font-family: var(--h-sans); font-size: var(--type-quote); line-height: 1.5; }
  .fc-quote figcaption { padding-top: var(--space-stack); margin-top: auto; display: flex; flex-direction: column; font-size: var(--type-caption); line-height: 1.5; }
  .fc-quote__name { font-weight: 500; }
  .fc-quote__role, .fc-quote__context { color: var(--muted); }
  .fc-quote__context { margin-top: var(--space-1); }
  .fc-quote__portrait { width: var(--space-8); height: var(--space-8); overflow: hidden; border-radius: 50%; flex: 0 0 auto; }
  .fc-quote__portrait picture, .fc-quote__portrait img { display: block; width: 100%; height: 100%; }
  .fc-quote__portrait img { object-fit: cover; object-position: 50% 35%; }
  .fc-quote__brand { display: flex; width: 10rem; min-height: var(--space-8); align-items: center; }
  .fc-quote__brand img { display: block; width: 100%; height: auto; }
  .fc-models { border-top: 1px solid var(--line); }
  .fc-models__close { margin-top: var(--space-grid); }
  .fc-models__close > .h3-body { margin: 0 0 var(--space-stack); }
  @media (min-width: 56rem) {
    .fc-situations__list, .fc-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .fc-proof__voices, .fc-models__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
