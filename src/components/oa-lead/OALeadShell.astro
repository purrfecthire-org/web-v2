---
// ── Shared shell for the three OA lead-capture pages ─────────────────────
// Minimal chrome on purpose: a logo that links back to the program page and
// nothing else. These pages are NOT part of the site's navigation — they are
// pasted into a LinkedIn post or DM, so a full nav would only offer exits
// from a single-decision page.
//
// The page body goes in the default slot; the hero, the closing "apply"
// block and the form are rendered here so all three stay consistent.
import Layout from '../../layouts/Layout.astro';
import OALeadForm from './OALeadForm.astro';
import type { OALeadFormCopy, OALeadVariant } from '../../content/oaLeadForms';

interface Props {
  variant: OALeadVariant;
  meta: { title: string; description: string };
  hero: { eyebrow: string; headline: string; lede: string; signature?: string };
  apply: { title: string; body: string; dark: boolean };
  form: OALeadFormCopy;
  footer: string;
  /** Collect the self-audit answers into the payload (variant `espejo`). */
  withAudit?: boolean;
}

const { variant, meta, hero, apply, form, footer, withAudit = false } = Astro.props;
---

<Layout title={meta.title} description={meta.description} lang="es" noindex>
  <main class="oal">
    <header class="oal__header">
      <a href="/offer-acceleration" aria-label="Purrfect Hire · Offer Acceleration">
        <picture>
          <source srcset="/logos/logo-desktop.webp" type="image/webp" />
          <img src="/logos/logo-desktop.png" alt="Purrfect Hire" class="oal__logo" width="150" height="34" />
        </picture>
      </a>
    </header>

    <div class="oal__page">
      <section class="oal__hero">
        <p class="oal__eyebrow">{hero.eyebrow}</p>
        <h1 class="oal__headline">{hero.headline}</h1>
        <p class="oal__lede">{hero.lede}</p>
        {hero.signature && <p class="oal__signature">{hero.signature}</p>}
      </section>

      <slot />

      <section class={`oal__apply${apply.dark ? ' oal__apply--dark' : ''}`}>
        <h2 class="oal__apply-title">{apply.title}</h2>
        <p class="oal__apply-body">{apply.body}</p>
        <OALeadForm variant={variant} copy={form} onDark={apply.dark} withAudit={withAudit} />
      </section>

      <p class="oal__footer">{footer}</p>
    </div>
  </main>
</Layout>

<style lang="scss">
  @use '../../styles/breakpoints.scss' as *;

  .oal {
    background: var(--bg);
    min-height: 100vh;

    &__header {
      max-width: 720px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 0;
    }

    &__logo {
      display: block;
      height: 34px;
      width: auto;
    }

    &__page {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.25rem 5rem;
    }

    /* ── Hero ───────────────────────────────────────────────────────── */
    &__hero {
      padding: 3.5rem 0 3rem;

      @include max-sm {
        padding: 2.5rem 0 2rem;
      }
    }

    &__eyebrow {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--muted);
      margin: 0 0 1rem;
    }

    &__headline {
      font-size: clamp(1.7rem, 4.5vw, 2.4rem);
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
      color: var(--ink);
      text-wrap: balance;
    }

    &__lede {
      font-size: 1.08rem;
      line-height: 1.6;
      color: var(--text);
      max-width: 58ch;
      margin: 0;
    }

    &__signature {
      margin: 1rem 0 0;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--muted);
    }

    /* ── Closing block + form ───────────────────────────────────────── */
    &__apply {
      margin-top: 3rem;
      border-top: 1px solid var(--line);
      padding-top: 2.5rem;

      /* The one dark section on the page (design system: max one per page). */
      &--dark {
        border-top: none;
        background: var(--dark);
        color: var(--on-dark);
        border-radius: var(--radius);
        padding: 2.5rem 1.75rem;

        .oal__apply-title {
          color: var(--on-dark);
        }

        .oal__apply-body {
          color: rgba(243, 239, 230, 0.72);
        }
      }
    }

    &__apply-title {
      font-size: 1.35rem;
      font-weight: 500;
      line-height: 1.3;
      margin: 0 0 0.75rem;
      color: var(--ink);
      text-wrap: balance;
    }

    &__apply-body {
      color: var(--text);
      max-width: 58ch;
      margin: 0 0 1.5rem;
    }

    &__footer {
      border-top: 1px solid var(--line);
      margin-top: 3.5rem;
      padding-top: 1.5rem;
      font-size: 0.8rem;
      color: var(--muted);
    }
  }
</style>
