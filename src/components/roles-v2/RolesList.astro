---
import { roleCardHTML, apiBase } from '../../lib/roles';
import { getRolesSnapshot } from './snapshot';
import { rolesCopy as t } from './copy';

const { roles, unavailable } = await getRolesSnapshot();
---

<section class="rl h3-surface h3-editorial-hero" data-built-slugs={JSON.stringify(roles.map((role) => role.slug))} data-configured={Boolean(apiBase())}>
  <div class="h3-wrap">
    <header class="rl__header">
      <p class="h3-eyebrow">{t.eyebrow}</p>
      <h1 class="h3-hero__h1 rl__title">{t.headline}</h1>
      <p class="h3-lead">{t.intro}</p>
      <p class="rl__free">{t.free}</p>
    </header>

    <div class="rl__list-head">
      <h2 class="rl__list-title">{t.count}<span id="rl-count" hidden={unavailable}> · {roles.length}</span></h2>
      <p>{t.confidentiality}</p>
    </div>
    <div class="rl__notice" id="rl-refresh-error" hidden>
      <p id="rl-refresh-message" role="status"></p>
      <button class="h3-btn h3-btn--sm h3-btn--ink" id="rl-refresh-retry" type="button" aria-describedby="rl-refresh-message" aria-controls="rl-grid rl-empty rl-error">{t.retry}</button>
    </div>
    <div class="rl__grid" id="rl-grid" hidden={roles.length === 0} set:html={roles.map(roleCardHTML).join('')}></div>

    <div class="rl__state" id="rl-empty" hidden={unavailable || roles.length > 0}>
      <h3 id="rl-empty-title">{!unavailable && roles.length === 0 ? t.emptyTitle : ''}</h3>
      <p id="rl-empty-body">{!unavailable && roles.length === 0 ? t.emptyBody : ''}</p>
      <a class="h3-link" href={t.profileHref} data-cta="roles-empty-profile">{t.profileCta} →</a>
    </div>
    <div class="rl__state" id="rl-error" hidden={!unavailable}>
      <h3 id="rl-error-title">{unavailable ? t.errorTitle : ''}</h3>
      <p id="rl-error-body">{unavailable ? t.errorBody : ''}</p>
      <div class="rl__state-actions">
        <button class="h3-btn h3-btn--ink" id="rl-retry" type="button">{t.retry}</button>
        <a class="h3-link" href={`mailto:${t.email}`}>{t.email}</a>
      </div>
    </div>

    <aside class="rl__profile">
      <div>
        <h2 class="h3-h2">{t.profileTitle}</h2>
        <p class="h3-body">{t.profileBody}</p>
      </div>
      <a class="h3-btn h3-btn--ink" href={t.profileHref} data-cta="roles-profile">{t.profileCta} →</a>
    </aside>
  </div>
</section>

<script>
  import { fetchRoles, roleCardHTML, reportClientError } from '../../lib/roles';
  import { rolesCopy as t } from './copy';

  const root = document.querySelector<HTMLElement>('.rl');
  if (root) {
    const built = new Set<string>(JSON.parse(root.dataset.builtSlugs || '[]'));
    const grid = document.getElementById('rl-grid')!;
    const empty = document.getElementById('rl-empty')!;
    const error = document.getElementById('rl-error')!;
    const notice = document.getElementById('rl-refresh-error')!;
    const count = document.getElementById('rl-count')!;
    const retry = document.getElementById('rl-retry') as HTMLButtonElement;
    const refreshRetry = document.getElementById('rl-refresh-retry') as HTMLButtonElement;
    let refreshing = false;

    function setStateCopy(state: 'open' | 'empty' | 'error' | 'stale') {
      document.getElementById('rl-empty-title')!.textContent = state === 'empty' ? t.emptyTitle : '';
      document.getElementById('rl-empty-body')!.textContent = state === 'empty' ? t.emptyBody : '';
      document.getElementById('rl-error-title')!.textContent = state === 'error' ? t.errorTitle : '';
      document.getElementById('rl-error-body')!.textContent = state === 'error' ? t.errorBody : '';
      document.getElementById('rl-refresh-message')!.textContent = state === 'stale' ? t.refreshError : '';
    }

    function preserveAttribution() {
      const campaign = new URLSearchParams(location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const incomingEntry = campaign.get('entry_path');
      // Keep only the original same-site pathname, never a query string,
      // form field, cross-origin URL or fragment.
      const entry = incomingEntry?.startsWith('/') && !incomingEntry.startsWith('//')
        ? new URL(incomingEntry, location.origin).pathname.slice(0, 250)
        : location.pathname;
      for (const link of grid.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        const url = new URL(link.href);
        if (url.origin !== location.origin) continue;
        for (const key of keys) {
          const value = campaign.get(key);
          if (value && /^[a-zA-Z0-9_. -]{1,100}$/.test(value)) url.searchParams.set(key, value);
        }
        url.searchParams.set('entry_path', entry);
        link.href = url.href;
      }
    }

    async function refresh() {
      if (refreshing) return;
      refreshing = true;
      retry.disabled = true;
      refreshRetry.disabled = true;
      grid.setAttribute('aria-busy', 'true');
      notice.setAttribute('aria-busy', 'true');
      try {
        const current = await fetchRoles();
        // GitHub Pages cannot render a new dynamic slug at request time.
        // New roles enter this list after their detail page is deployed by
        // the existing role-published workflow; never create a dead link.
        const available = current.filter((role) => built.has(role.slug));
        grid.innerHTML = available.map(roleCardHTML).join('');
        preserveAttribution();
        notice.hidden = true;
        setStateCopy(current.length === 0 ? 'empty' : 'open');
        grid.hidden = available.length === 0;
        count.textContent = ` · ${available.length}`;
        count.hidden = false;
        error.hidden = true;
        empty.hidden = current.length !== 0;
        if (current.length > 0 && available.length === 0) {
          // There is demand, but its new pages are not deployed yet. Do not
          // describe this as "no open roles".
          setStateCopy('error');
          error.hidden = false;
          count.hidden = true;
        }
      } catch (err) {
        const hasSnapshot = grid.querySelector('.rl__card') !== null;
        if (hasSnapshot) { setStateCopy('stale'); notice.hidden = false; error.hidden = true; empty.hidden = true; }
        else { setStateCopy('error'); notice.hidden = true; error.hidden = false; empty.hidden = true; count.hidden = true; }
        reportClientError(`roles list refresh failed: ${(err as Error).message}`, { stage: 'roles_index_refresh' });
      } finally {
        refreshing = false;
        retry.disabled = false;
        refreshRetry.disabled = false;
        grid.removeAttribute('aria-busy');
        notice.removeAttribute('aria-busy');
      }
    }
    retry.addEventListener('click', refresh);
    refreshRetry.addEventListener('click', refresh);
    if (root.dataset.configured === 'true') refresh();
  }
</script>

<style is:global>
  .rl { padding: calc(var(--space-hero-top) + var(--space-3)) 0 var(--space-section); }
  .rl [hidden] { display: none !important; }
  .rl__header { padding-bottom: var(--space-section); max-width: 58rem; }
  .rl__title { max-width: 16ch; }
  .rl__free { margin-top: var(--space-stack) !important; font-size: var(--type-ui); line-height: 1.5; color: var(--muted); max-width: 38rem; }
  .rl__list-head { border-top: 1px solid var(--line); padding: var(--space-stack) 0; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem var(--space-grid); }
  .rl__list-title { font-size: var(--type-quote); line-height: 1.35; font-weight: 400; font-family: var(--h-serif); }
  .rl__list-head p { color: var(--muted); font-size: var(--type-caption); line-height: 1.5; max-width: 29rem; }
  .rl__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-stack); }
  .rl__card { display: flex; flex-direction: column; position: relative; min-width: 0; padding: var(--space-4); border: 1px solid var(--line); border-radius: var(--radius-card); background: rgba(255,255,255,.54); transition: border-color .2s, background-color .2s; }
  .rl__card:hover, .rl__card:focus-within { border-color: var(--muted); }
  .rl__card-top { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .rl__card-company { font-weight: 500; }
  .rl__card-posted { white-space: nowrap; }
  .rl__card-title { font-size: var(--type-quote); font-weight: 400; letter-spacing: -.014em; line-height: 1.2; margin-top: var(--space-2) !important; font-family: var(--h-serif); }
  .rl__card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1rem; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }
  .rl__meta { display: inline-flex; align-items: center; gap: 0.5rem; }
  .rl__meta svg { flex-shrink: 0; }
  .rl__meta--salary { color: var(--text); }
  .rl__meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--muted); }
  .rl__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: var(--space-stack) 0; }
  .rl__tag { padding: 0.25rem 0.5rem; border: 1px solid var(--line); border-radius: var(--radius-input); font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .rl__card-foot { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-top: auto; padding-top: 1rem; }
  .rl__badges { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }
  .rl__yc, .rl__english { display: inline-flex; gap: 0.5rem; align-items: center; }
  .rl__yc-mark { font-weight: 500; }
  .rl__view { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 3rem; padding-block: 0.75rem; color: var(--purple); font-size: var(--type-caption); line-height: 1.5; font-weight: 500; }
  .rl__state { padding: var(--space-section) 0; border-block: 1px solid var(--line); }
  .rl__state h3 { font-family: var(--h-sans); font-weight: 500; font-size: var(--type-subheading); line-height: 1.35; }
  .rl__state p { margin: 1rem 0 var(--space-stack); color: var(--muted); max-width: 36rem; }
  .rl__state-actions { display: flex; flex-wrap: wrap; gap: var(--space-stack); align-items: center; }
  .rl__state button { cursor: pointer; border: 0; font-family: inherit; }
  .rl__notice { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-stack); color: var(--muted); margin-bottom: var(--space-stack) !important; }
  .rl__notice p { flex: 1 1 auto; }
  .rl__notice button { flex: none; }
  .rl__profile { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-grid); border-top: 1px solid var(--line); margin-top: var(--space-section); padding-top: var(--space-section); }
  .rl__profile .h3-h2 { max-width: 22ch; }
  @media (max-width: 47.99rem) { .rl__grid { grid-template-columns: 1fr; } .rl__card { padding: var(--space-3); } }
</style>
