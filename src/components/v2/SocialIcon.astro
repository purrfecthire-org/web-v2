---
interface Props { name: 'instagram' | 'facebook' | 'linkedin' | 'x' }
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {name === 'instagram' && <Fragment>
    <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
    <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
    <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" />
  </Fragment>}
  {name === 'facebook' && <path fill="currentColor" d="M13.7 21v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.6-1.6H17V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.5v3.2h2.8V21h3.4Z" />}
  {name === 'linkedin' && <Fragment>
    <rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor" />
    <path d="M7.1 10.2v7M11.2 17.2v-7m0 3c0-3.8 5.4-4 5.4 0v4" stroke="var(--midnight)" stroke-width="1.9" />
    <circle cx="7.1" cy="7.3" r="1.15" fill="var(--midnight)" />
  </Fragment>}
  {name === 'x' && <path fill="currentColor" d="M17.6 3H20l-6.5 7.4L21 21h-5.9l-4.6-6.4L4.9 21H2.5l6.9-8L2 3h6l4.2 5.9L17.6 3Zm-.8 16.2h1.3L7.2 4.7H5.8l11 14.5Z" />}
</svg>
