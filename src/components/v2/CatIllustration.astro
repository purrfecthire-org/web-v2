---
interface Props {
  pose: 'observe' | 'walk' | 'leap' | 'rest';
}
const { pose } = Astro.props;
const dimensions = pose === 'rest' ? { width: 960, height: 640 } : { width: 1080, height: 720 };
---

<img
  class="cat-illustration"
  src={`/brand/illustrations/cat-${pose}-ink.webp`}
  alt=""
  aria-hidden="true"
  width={dimensions.width}
  height={dimensions.height}
  loading="lazy"
  decoding="async"
/>

<style>
  .cat-illustration {
    display: block;
    width: 100%;
    max-width: calc(var(--space-8) * 3);
    height: auto;
    justify-self: center;
    align-self: center;
    object-fit: contain;
  }
  @media (min-width: 56rem) {
    .cat-illustration { max-width: calc(var(--space-8) * 4); justify-self: end; }
  }
</style>
