---
import { talentTestimonials } from '../../content/talentTestimonials';
---

<div class="participant-voices">
  {talentTestimonials.map((voice) => (
    <figure>
      <blockquote>“{voice.quote}”</blockquote>
      <figcaption><strong>{voice.name}</strong><span>{voice.context}</span><span>Translated from Spanish</span></figcaption>
    </figure>
  ))}
</div>

<style>
  .participant-voices { display: grid; gap: 2rem; margin-top: 3rem; }
  .participant-voices figure { padding-top: 1.5rem; border-top: 1px solid currentColor; border-color: color-mix(in srgb, currentColor 20%, transparent); }
  .participant-voices blockquote { font-family: var(--h-sans); font-size: var(--type-body, 1.0625rem); line-height: 1.7; max-width: 46ch; }
  .participant-voices figcaption { display: grid; gap: 0.25rem; margin-top: 1rem; font-size: var(--type-caption, .875rem); line-height: 1.5; }
  .participant-voices strong { font-weight: 500; }
  .participant-voices figcaption span { opacity: .8; }
  @media (min-width: 48rem) { .participant-voices { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; } }
</style>
