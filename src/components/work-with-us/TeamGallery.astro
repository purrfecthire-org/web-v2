---
import { team } from '../../content/team';
---

<div class="team-gallery" role="group" aria-label={team.label}>
  {team.people.map((person) => (
    <figure class="team-gallery__person">
      <div class="team-gallery__portrait">
        <img
          src={person.src}
          alt={person.name}
          width={person.width}
          height={person.height}
          loading="lazy"
          decoding="async"
          style={{ objectPosition: person.position }}
        />
      </div>
      <figcaption>{person.name}</figcaption>
    </figure>
  ))}
</div>

<style>
  .team-gallery {
    --avatar-size: var(--space-8);
    --gallery-gap: var(--space-2);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gallery-gap);
    row-gap: var(--space-stack);
    padding-block: var(--space-stack);
  }
  .team-gallery__person { position: relative; min-width: 0; margin: 0; text-align: center; }
  .team-gallery__person::after { content: ''; position: absolute; z-index: -1; top: calc(var(--avatar-size) / 2); left: 50%; width: calc(100% + var(--gallery-gap)); height: 1px; background: var(--purple); opacity: .16; pointer-events: none; }
  .team-gallery__person:nth-child(3n)::after,
  .team-gallery__person:last-child::after { display: none; }
  .team-gallery__portrait {
    width: var(--avatar-size);
    max-width: 100%;
    margin-inline: auto;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--stone);
  }
  .team-gallery__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team-gallery figcaption {
    margin-top: var(--space-2);
    font-size: var(--type-ui);
    font-weight: 500;
    line-height: 1.5;
  }
  @media (min-width: 48rem) {
    .team-gallery { --avatar-size: calc(var(--space-6) * 2); grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .team-gallery__person:nth-child(3)::after { display: block; }
  }
  @media (min-width: 56rem) {
    .team-gallery { --gallery-gap: var(--space-stack); }
  }
</style>
