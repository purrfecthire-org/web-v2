---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { CAREER_COMPOUNDING_EMAIL, DISCUSS_CAREER_COMPOUNDING, getCareerCompoundingV2 } from '../../content/careerCompoundingV2';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getCareerCompoundingV2(lang);
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="light"
  navCta={{ label: t.hero.cta, href: DISCUSS_CAREER_COMPOUNDING }} journey="talent">
  <div class="cc-page" data-product="career-compounding">
    <section class="h3-hero cc-hero" aria-labelledby="cc-title">
      <div class="h3-wrap cc-hero__grid">
        <div>
          <p class="h3-eyebrow">{t.hero.eyebrow}</p>
          <h1 class="h3-hero__h1 cc-hero__title" id="cc-title">{t.hero.headline}</h1>
          <p class="h3-hero__sub">{t.hero.body}</p>
          <p class="cc-hero__audience">{t.hero.audience}</p>
          <a href={DISCUSS_CAREER_COMPOUNDING} data-cta="career-compounding-hero-email" class="h3-btn cc-hero__cta">{t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
          <p class="cc-hero__note">{t.hero.note}</p>
        </div>
        <dl class="cc-facts" aria-label="Program at a glance">
          {t.hero.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="cc-work" aria-labelledby="cc-work-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.work.eyebrow}</p>
        <h2 class="h3-h2" id="cc-work-title">{t.work.headline}</h2>
        <p class="h3-body cc-work__intro">{t.work.intro}</p>
        <ol class="cc-work__list">
          {t.work.areas.map((area) => (
            <li class="cc-area" id={"cc-area-" + area.id}>
              <div class="cc-area__heading">
                <span class="cc-area__id" aria-hidden="true">{area.id}</span>
                <h3>{area.title}</h3>
              </div>
              <p>{area.body}</p>
              <div class="cc-area__output">
                <p class="cc-area__output-label">{area.outputLabel}</p>
                <p>{area.output}</p>
              </div>
            </li>
          ))}
        </ol>
        <details class="cc-method cc-question">
          <summary>{t.progress.title}<span aria-hidden="true">+</span></summary>
          <div class="cc-progress">
            <p>{t.progress.body}</p>
            <dl>{t.progress.dimensions.map((dimension) => <div><dt>{dimension.title}</dt><dd>{dimension.body}</dd></div>)}</dl>
          </div>
        </details>
      </div>
    </section>

    <section class="cc-scope" aria-labelledby="cc-scope-title">
      <div class="h3-wrap cc-scope__grid">
        <div>
          <p class="h3-eyebrow">{t.scope.eyebrow}</p>
          <h2 class="h3-h2" id="cc-scope-title">{t.scope.headline}</h2>
          <p class="cc-scope__price">{t.scope.price}</p>
          <p class="h3-body cc-scope__terms">{t.scope.summary}</p>
          <p class="cc-scope__privacy">{t.scope.privacy}</p>
        </div>
        <div>
          <ol class="cc-inclusions">{t.scope.items.map((item) => <li><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol>
          <div class="cc-questions">
          {t.questions.items.map((item) => (
            <details class="cc-question">
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
          </div>
        </div>
      </div>
    </section>

    <section class="cc-close" aria-labelledby="cc-close-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.close.eyebrow}</p>
        <h2 class="h3-h2" id="cc-close-title">{t.close.headline}</h2>
        <p class="h3-body">{t.close.body}</p>
        <a href={DISCUSS_CAREER_COMPOUNDING} data-cta="career-compounding-close-email" class="h3-btn cc-close__cta">{t.close.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
        <p class="cc-close__note">{t.close.note}</p>
        <p class="cc-close__email">{t.close.emailLabel} <a href={"mailto:" + CAREER_COMPOUNDING_EMAIL} data-cta="career-compounding-direct-email">{CAREER_COMPOUNDING_EMAIL}</a>.</p>
      </div>
    </section>
  </div>
</Shell>

<style lang="scss">
  .cc-hero__grid { display: grid; align-items: center; gap: var(--space-grid); }
  .cc-hero__title { max-width: 15ch; }
  .cc-hero__cta, .cc-close__cta { margin-top: var(--space-4); max-width: 100%; text-align: center; line-height: 1.4; }
  .cc-hero__note, .cc-close__note, .cc-close__email { margin-top: var(--space-2); color: var(--muted); font-size: var(--type-caption); line-height: 1.5; max-width: 34rem; }
  .cc-hero__audience { margin-top: var(--space-3); max-width: 34rem; color: var(--muted); font-size: var(--type-ui); line-height: 1.5; }
  .cc-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin: 0; padding-block: var(--space-4); border-block: 1px solid var(--line); }
  .cc-facts > div { min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .cc-facts dt { font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .cc-facts dd { order: -1; margin: 0; font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .cc-work, .cc-scope, .cc-close { padding-block: var(--space-section); background: var(--sand); border-top: 1px solid var(--line); }
  .cc-work .h3-h2, .cc-scope .h3-h2, .cc-close .h3-h2 { max-width: 28ch; }
  .cc-work__intro { margin-top: var(--space-3); max-width: 44rem; }
  .cc-work__list { margin-top: var(--space-4); }
  .cc-area { display: grid; align-items: baseline; gap: var(--space-3); min-width: 0; padding-block: var(--space-3); scroll-margin-top: var(--space-hero-top); border-top: 1px solid var(--line); }
  .cc-area__heading { display: flex; align-items: baseline; gap: var(--space-2); min-width: 0; }
  .cc-area__id { flex-shrink: 0; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; font-variant-numeric: tabular-nums; }
  .cc-area h3 { margin-top: 0; font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .cc-area > p, .cc-area__output p { font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .cc-area__output .cc-area__output-label { margin-bottom: var(--space-1); color: var(--text); font-size: var(--type-ui); line-height: 1.5; font-weight: 500; }
  .cc-method { margin-top: 0; }
  .cc-progress { padding-bottom: var(--space-3); max-width: 44rem; color: var(--muted); }
  .cc-progress dl { display: grid; gap: var(--space-3); margin-top: var(--space-3); }
  .cc-progress dt { color: var(--text); font-size: var(--type-ui); font-weight: 500; line-height: 1.5; }
  .cc-progress dd { margin: var(--space-1) 0 0; }
  .cc-inclusions { display: grid; gap: var(--space-3); padding-bottom: var(--space-4); }
  .cc-inclusions li { padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .cc-inclusions li:first-child { padding-top: 0; border-top: 0; }
  .cc-inclusions h3 { font-size: var(--type-subheading); line-height: 1.35; }
  .cc-inclusions p { margin-top: var(--space-1); color: var(--muted); }
  .cc-scope__price { margin-top: var(--space-3); font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .cc-scope__grid { display: grid; gap: var(--space-grid); align-items: start; }
  .cc-scope__terms { margin-top: var(--space-3); }
  .cc-scope__privacy { margin-top: var(--space-3); max-width: 34rem; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }
  .cc-questions { border-top: 1px solid var(--line); min-width: 0; }
  .cc-question { border-bottom: 1px solid var(--line); }
  .cc-question summary { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); padding-block: var(--space-3); cursor: pointer; list-style: none; font-size: var(--type-body); font-weight: 500; line-height: 1.7; }
  .cc-question summary::-webkit-details-marker { display: none; }
  .cc-question summary span { flex-shrink: 0; font-size: var(--type-subheading); line-height: 1.35; color: var(--purple); }
  .cc-question[open] summary span { transform: rotate(45deg); }
  .cc-question > p { padding-bottom: var(--space-3); max-width: 36rem; color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .cc-close .h3-body { margin-top: var(--space-3); }
  .cc-close__email { margin-top: var(--space-1); overflow-wrap: anywhere; }
  .cc-close__email a { text-decoration: underline; text-underline-offset: 3px; color: var(--purple); }
  @media (min-width: 56rem) {
    .cc-hero__grid { grid-template-columns: 1.25fr 1fr; }
    .cc-area { grid-template-columns: minmax(0, .8fr) minmax(0, 1.1fr) minmax(0, 1.1fr); gap: var(--space-grid); }
    .cc-scope__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
