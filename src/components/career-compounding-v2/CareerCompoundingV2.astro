---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import {
  CAREER_COMPOUNDING_EMAIL,
  DISCUSS_CAREER_COMPOUNDING,
  getCareerCompoundingV2,
} from '../../content/careerCompoundingV2';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getCareerCompoundingV2(lang);
---

<Shell
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  theme="light"
  navCta={{ label: t.hero.cta, href: DISCUSS_CAREER_COMPOUNDING }}
  journey="talent"
>
  <div class="cc-page" data-product="career-compounding">
    <section class="h3-hero cc-hero" aria-labelledby="cc-title">
      <div class="h3-wrap cc-hero__grid">
        <div class="cc-hero__copy">
          <p class="h3-eyebrow">{t.hero.eyebrow}</p>
          <h1 class="h3-hero__h1 cc-hero__title" id="cc-title">{t.hero.headline}</h1>
          <p class="h3-hero__sub">{t.hero.body}</p>
          <a href={DISCUSS_CAREER_COMPOUNDING} data-cta="career-compounding-hero-email" class="h3-btn cc-hero__cta">
            {t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span>
          </a>
          <p class="cc-hero__note">{t.hero.note}</p>
        </div>
        <aside class="cc-prompt" aria-labelledby="cc-prompt-title">
          <p class="h3-eyebrow">{t.hero.prompt.eyebrow}</p>
          <h2 class="cc-prompt__title" id="cc-prompt-title">{t.hero.prompt.title}</h2>
          <ul class="cc-prompt__list">
            {t.hero.prompt.items.map((item) => <li><span class="cc-prompt__dot" aria-hidden="true"></span>{item}</li>)}
          </ul>
          <p class="cc-prompt__closing">{t.hero.prompt.closing}</p>
        </aside>
      </div>
    </section>

    <section class="cc-audience" aria-labelledby="cc-audience-title">
      <div class="h3-wrap cc-audience__grid">
        <div>
          <p class="h3-eyebrow">{t.audience.eyebrow}</p>
          <h2 class="h3-h2 cc-audience__title" id="cc-audience-title">{t.audience.headline}</h2>
        </div>
        <div class="cc-audience__body">
          <p class="h3-body">{t.audience.body}</p>
          <ul class="cc-audience__situations">
            {t.audience.situations.map((situation) => <li>{situation}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="cc-work" aria-labelledby="cc-work-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.work.eyebrow}</p>
        <h2 class="h3-h2 cc-work__title" id="cc-work-title">{t.work.headline}</h2>
        <p class="h3-body cc-work__intro">{t.work.intro}</p>
        <ol class="cc-work__list">
          {t.work.areas.map((area) => (
            <li class="cc-area">
              <span class="cc-area__id" aria-hidden="true">{area.id}</span>
              <h3 class="cc-area__title">{area.title}</h3>
              <p class="cc-area__body">{area.body}</p>
              <div class="cc-area__output">
                <p class="cc-area__output-label">{area.outputLabel}</p>
                <p>{area.output}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cc-approach" aria-labelledby="cc-approach-title">
      <div class="h3-wrap cc-approach__grid">
        <div>
          <p class="h3-eyebrow">{t.approach.eyebrow}</p>
          <h2 class="h3-h2 cc-approach__title" id="cc-approach-title">{t.approach.headline}</h2>
          <p class="cc-approach__scope">{t.approach.scope}</p>
        </div>
        <ol class="cc-approach__steps">
          {t.approach.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="h3-wrap"><p class="cc-approach__privacy">{t.approach.privacy}</p></div>
    </section>

    <section class="cc-questions" aria-labelledby="cc-questions-title">
      <div class="h3-wrap cc-questions__grid">
        <div>
          <p class="h3-eyebrow">{t.questions.eyebrow}</p>
          <h2 class="h3-h2 cc-questions__title" id="cc-questions-title">{t.questions.headline}</h2>
        </div>
        <div class="cc-questions__list">
          {t.questions.items.map((item) => (
            <details class="cc-question">
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cc-close" aria-labelledby="cc-close-title">
      <div class="h3-wrap">
        <p class="h3-eyebrow">{t.close.eyebrow}</p>
        <h2 class="h3-h2 cc-close__title" id="cc-close-title">{t.close.headline}<span class="h3-dot--end" aria-hidden="true"></span></h2>
        <p class="h3-body cc-close__body">{t.close.body}</p>
        <a href={DISCUSS_CAREER_COMPOUNDING} data-cta="career-compounding-close-email" class="h3-btn cc-close__cta">
          {t.close.cta}<span class="h3-arrow" aria-hidden="true">→</span>
        </a>
        <p class="cc-close__note">{t.close.note}</p>
        <p class="cc-close__email">{t.close.emailLabel} <a href={`mailto:${CAREER_COMPOUNDING_EMAIL}`} data-cta="career-compounding-direct-email">{CAREER_COMPOUNDING_EMAIL}</a>.</p>
      </div>
    </section>
  </div>
</Shell>

<style lang="scss">
  .cc-page { --cc-section-space: var(--space-section); }
  .cc-hero { padding-bottom: var(--cc-section-space); }
  .cc-hero__grid { display: grid; align-items: center; gap: 3rem; }
  .cc-hero__copy { min-width: 0; }
  .cc-hero__title { max-width: 15ch; }
  .cc-hero__cta, .cc-close__cta { margin-top: 2rem; max-width: 100%; text-align: center; line-height: 1.4; }
  .cc-hero__note, .cc-close__note, .cc-close__email {
    margin-top: 1rem; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; max-width: 32rem;
  }
  .cc-prompt { padding: var(--space-grid); background: var(--stone); border-radius: var(--radius-card); }
  .cc-prompt__title {
    margin-top: 1rem; font-family: var(--h-sans); font-size: var(--type-subheading);
    font-weight: 500; letter-spacing: -0.014em; line-height: 1.35;
    font-variation-settings: 'opsz' 110, 'SOFT' 0, 'WONK' 0;
  }
  .cc-prompt__list { margin-top: 2rem; }
  .cc-prompt__list li {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 1rem 0; border-top: 1px solid var(--line); font-size: var(--type-body); line-height: 1.7;
  }
  .cc-prompt__dot { flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); }
  .cc-prompt__closing { margin-top: 1.5rem; font-size: var(--type-ui); line-height: 1.5; color: var(--muted); }

  .cc-audience, .cc-approach, .cc-questions { padding-block: var(--cc-section-space); background: var(--sand); border-top: 1px solid var(--line); }
  .cc-audience__grid, .cc-approach__grid, .cc-questions__grid { display: grid; gap: 2rem; align-items: start; }
  .cc-audience__title, .cc-approach__title, .cc-questions__title { max-width: 18ch; }
  .cc-audience__situations { margin-top: 1.5rem; max-width: 34rem; }
  .cc-audience__situations li { padding: 1rem 0; border-top: 1px solid var(--line); font-size: var(--type-body); line-height: 1.7; }

  .cc-work { padding-block: var(--cc-section-space); background: var(--sand); border-top: 1px solid var(--line); }
  .cc-work__title { max-width: 24ch; }
  .cc-work__intro { margin-top: 1.5rem; max-width: 42rem; }
  .cc-work__list { display: grid; gap: 2rem; margin-top: 3rem; }
  .cc-area { display: flex; flex-direction: column; min-width: 0; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .cc-area__id { color: var(--muted); font-size: var(--type-caption); line-height: 1.5; font-variant-numeric: tabular-nums; }
  .cc-area__title { margin-top: 1rem; font-size: var(--type-subheading); line-height: 1.35; font-weight: 500; letter-spacing: -0.015em; }
  .cc-area__body { margin-top: 1rem; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .cc-area__output { margin-top: auto; padding-top: 2rem; font-size: var(--type-body); line-height: 1.7; }
  .cc-area__output-label { margin-bottom: 0.5rem; font-weight: 500; }

  .cc-approach__scope { margin-top: 1.5rem; max-width: 31rem; color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .cc-approach__steps { border-top: 1px solid var(--line); }
  .cc-approach__steps li { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .cc-approach__steps h3 { font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .cc-approach__steps p { margin-top: 0.5rem; color: var(--muted); font-size: var(--type-body); line-height: 1.7; }
  .cc-approach__privacy { margin-top: 3rem; max-width: 48rem; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }

  .cc-questions__list { border-top: 1px solid var(--line); min-width: 0; }
  .cc-question { border-bottom: 1px solid var(--line); }
  .cc-question summary {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding: 1.5rem 0; list-style: none; cursor: pointer; font-size: var(--type-body); font-weight: 500; line-height: 1.7;
  }
  .cc-question summary::-webkit-details-marker { display: none; }
  .cc-question summary span { flex-shrink: 0; font-size: var(--type-subheading); line-height: 1.35; color: var(--purple); }
  .cc-question[open] summary span { transform: rotate(45deg); }
  .cc-question p { padding-bottom: 1.5rem; font-size: var(--type-body); line-height: 1.7; color: var(--muted); max-width: 36rem; }

  .cc-close { padding-block: var(--cc-section-space); background: var(--sand); }
  .cc-close__title { max-width: 24ch; }
  .cc-close__body { margin-top: 1.5rem; max-width: 38rem; }
  .cc-close__email { margin-top: 0.5rem; overflow-wrap: anywhere; }
  .cc-close__email a { text-decoration: underline; text-underline-offset: 3px; color: var(--purple); }

  @media (min-width: 48rem) {
    .cc-work__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  }
  @media (min-width: 56rem) {
    .cc-hero__grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 4rem; }
    .cc-audience__grid, .cc-approach__grid, .cc-questions__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; }
    .cc-audience__body { padding-top: 2rem; }
    .cc-work__list { gap: 3rem; }
  }
</style>
