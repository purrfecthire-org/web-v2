---
import Shell from '../v2/Shell.astro';
import CatIllustration from '../v2/CatIllustration.astro';
import ClientPortrait from '../v2/ClientPortrait.astro';
import SocialIcon from '../v2/SocialIcon.astro';
import { talentTestimonials } from '../../content/talentTestimonials';
import type { Lang } from '../../content/index';
import { getOfferV2 } from '../../content/offerV2';
import { APPLY_OFFER } from '../../content/links';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getOfferV2(lang);
const includedItems = [
  {title:'Eight one-hour sessions', description:'One diagnostic session and seven private sessions with a senior Purrfect advisor. Your advisor is confirmed before enrollment.'},
  {title:'A private Career Journal', description:t.includes.items[1]},
  {title:'A weekly team check-in', description:'Support and progress reviews between sessions.'},
  {title:'WhatsApp and email support', description:'Questions, updates and feedback on active processes, without 24/7 availability.'},
  {title:'Active process follow-up', description:t.includes.items[4]},
];
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="light"
  navCta={{ label: t.hero.cta, href: APPLY_OFFER }} journey="offer">
  <link slot="head" rel="stylesheet" href="/styles/offer-v2.css?v=unified-light-20261029" />
  <div class="oa-editorial-intro">
    <section class="oa-new-hero" aria-labelledby="oa-hero-title">
      <div class="h3-wrap oa-new-hero__grid">
        <div class="oa-new-hero__copy">
          <p class="h3-eyebrow">Offer Accelerator · Private career advisory</p>
          <h1 id="oa-hero-title">The market may be reading you a level below your real one.</h1>
          <p class="oa-new-hero__sub">{t.hero.sub}</p>
          <ul class="oa-new-hero__signals" aria-label="Career situations">
            <li>New company</li><li>Market change</li><li>Offer negotiation</li>
          </ul>
          <a href={APPLY_OFFER} data-cta="offer-hero-apply" class="h3-btn oa-new-hero__cta">{t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
          <p class="oa-new-hero__terms">{t.investment.price} · Eight one-hour sessions<br /><a href="#investment">Scope and investment <span aria-hidden="true">↓</span></a></p>
        </div>
        <div class="oa-new-hero__art" aria-hidden="true"></div>
      </div>
    </section>

    <section class="oa-familiar" aria-labelledby="oa-familiar-title">
      <div class="h3-wrap">
        <div class="oa-familiar__grid">
          <div class="oa-familiar__heading">
            <p class="h3-eyebrow">Recognise this?</p>
            <h2 id="oa-familiar-title">Does this sound familiar?</h2>
            <p>You can have ten years of experience and still:</p>
          </div>
          <p class="oa-bubble oa-bubble--one">Not get interviews for the roles you actually want.</p>
          <p class="oa-bubble oa-bubble--two">Be read as less senior than you are.</p>
          <p class="oa-bubble oa-bubble--three">Reach the final rounds and lose to another candidate.</p>
          <p class="oa-bubble oa-bubble--four">Hear about roles only once they are posted.</p>
          <p class="oa-bubble oa-bubble--five">Struggle to show the impact you had in an interview.</p>
        </div>
      </div>
    </section>
  </div>

  <details class="oa-method-disclosure h3-surface">
    <summary class="h3-wrap">See the work behind the program <span aria-hidden="true">+</span></summary>
  <section class="oa-work oa-stages" aria-labelledby="oa-work-title" data-stages>
    <div class="h3-wrap">
      <p class="h3-eyebrow">How we work</p>
      <h2 class="h3-h2" id="oa-work-title">Three stages, one private workspace.</h2>
      <p class="h3-body oa-stages__lead">{t.deliverables.body}</p>
      <div class="oa-stages__tabs" aria-label="Explore three stages">
        {['Understand how you are read', 'Build your approach', 'Navigate the process'].map((name, i) => (
          <button class="oa-stages__tab" type="button" data-stage-tab={i} aria-controls={`oa-stage-panel-${i}`} aria-current={i === 0 ? 'step' : undefined}>
            <span class="oa-stages__number">0{i + 1}</span><span class="oa-stages__tab-title">{name}</span>
          </button>
        ))}
      </div>
      <div class="oa-stages__panels">
        {[
          {name:'Understand how you are read', description:'Examine how your experience is understood and define the scope of your next move.', outcomes:['Clear criteria for the next move you want to make','Specific evidence of your contribution, scope and results']},
          {name:'Build your approach', description:'Research relevant companies and organize the work behind each real opportunity.', outcomes:['A focused map of relevant companies and decision makers','A working system for research, outreach and live processes']},
          {name:'Navigate the process', description:'Prepare for real interviews, evaluate offers and decide how to negotiate.', outcomes:['Interview preparation grounded in feedback','A framework for evaluating offers and negotiation decisions']}
        ].map((stage, i) => (
          <article class="oa-stage" id={`oa-stage-panel-${i}`} data-stage-panel={i} aria-labelledby={`oa-stage-title-${i}`}>
            <div class="oa-stage__intro">
              <p class="h3-eyebrow">Stage 0{i + 1}</p>
              <h3 id={`oa-stage-title-${i}`}>{stage.name}</h3>
              <p>{stage.description}</p>
            </div>
            <div class="oa-stage__deliverables">
              {t.deliverables.items.slice(i * 2, i * 2 + 2).map((item, j) => (
                <div class="oa-stage__deliverable">
                  <span class="oa-stage__glyph" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      {(i * 2 + j) === 0 && <><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></>}
                      {(i * 2 + j) === 1 && <><path d="M4 20V13h4v7M10 20V9h4v11M16 20V4h4v16M3 20h18"/></>}
                      {(i * 2 + j) === 2 && <><circle cx="6" cy="7" r="2"/><circle cx="18" cy="7" r="2"/><circle cx="12" cy="18" r="2"/><path d="M8 8.5l3 7M16 8.5l-3 7M8 7h8"/></>}
                      {(i * 2 + j) === 3 && <><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></>}
                      {(i * 2 + j) === 4 && <><path d="M5 8h14v9H9l-4 3V8Z"/><path d="M9 12h6"/></>}
                      {(i * 2 + j) === 5 && <><path d="m4 12 5 5L20 6"/><path d="M4 5h7M4 9h4"/></>}
                    </svg>
                  </span>
                  <div><h4>{item.title}</h4><p>{item.body}</p>{item.note && <p class="oa-stage__note">{item.note}</p>}</div>
                </div>
              ))}
            </div>
            <div class="oa-stage__outcomes">
              <p class="h3-eyebrow">What you walk away with</p>
              <ul>{stage.outcomes.map(outcome => <li>{outcome}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      <div class="oa-stages__controls" data-stage-controls>
        <button type="button" data-stage-prev aria-label="Previous stage">←</button>
        <span class="oa-stages__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <button type="button" data-stage-next aria-label="Next stage">→</button>
        <span class="oa-stages__counter" data-stage-counter>Stage 1 of 3</span>
      </div>
    </div>
  </section>
  </details>

  <section class="oa-proof oa-testimonials" id="voices" aria-labelledby="oa-proof-title" data-testimonials>
    <div class="h3-wrap oa-testimonials__layout">
      <div class="oa-testimonials__intro">
        <p class="h3-eyebrow">{t.proof.eyebrow}</p>
        <h2 class="h3-h2" id="oa-proof-title">{t.proof.headline}</h2>
        <span class="oa-testimonials__quote-mark" aria-hidden="true">“</span>
        <p class="oa-testimonials__aside">What participants are saying</p>
        <div class="oa-testimonials__controls" hidden>
          <button type="button" data-voice-prev aria-label="Previous testimonial">←</button>
          <span data-voice-position aria-live="polite">1–3 of 3</span>
          <button type="button" data-voice-next aria-label="Next testimonial">→</button>
        </div>
      </div>
      <div class="oa-testimonials__viewport" data-voice-viewport tabindex="0" role="region" aria-label="Participant testimonials">
        <div class="oa-testimonials__track">
          <figure class="oa-testimonial">
            <div class="oa-testimonial__person"><ClientPortrait alt={t.proof.name} shape="circle" />
              <figcaption><strong>{t.proof.name}</strong><span>{t.proof.role}</span><small>Translated from Spanish</small></figcaption>
            </div>
            <blockquote>“{t.proof.quote}”</blockquote>
            <a href={t.proof.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`View ${t.proof.name} on LinkedIn`}>View LinkedIn ↗</a>
          </figure>
          {talentTestimonials.map(voice => (
            <figure class="oa-testimonial">
              <div class="oa-testimonial__person">
                <img src={voice.photo} alt={voice.name} width="128" height="128" loading="lazy" decoding="async" />
                <figcaption><strong>{voice.name}</strong><span>{voice.context}</span><small>{voice.translation}</small></figcaption>
              </div>
              <blockquote>“{voice.quote}”</blockquote>
              {voice.reflection && <p class="oa-testimonial__reflection">“{voice.reflection}”</p>}
              <a href={voice.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`View ${voice.name} on LinkedIn`}>View LinkedIn ↗</a>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="oa-advisors" aria-labelledby="oa-advisors-title">
    <div class="h3-wrap oa-advisors__grid">
      <div class="oa-advisors__media">
        <img class="oa-advisors__portrait" src="/images/offer-v2/kate.webp.webp" alt="Kate, founder of Purrfect Hire" width="900" height="1124" loading="lazy" decoding="async" />
      </div>
      <div class="oa-advisors__copy">
        <p class="h3-eyebrow">Who you will work with</p>
        <h2 id="oa-advisors-title">Know who you will work with.</h2>
        <p class="oa-advisors__lead">Kate led recruiting at Addi and founded Purrfect Hire. Your sessions are led by Kate or a senior Purrfect advisor.</p>
        <p class="oa-advisors__note">Your advisor is confirmed before enrollment.</p>
        <details class="oa-advisors__more"><summary>Advisor background <span aria-hidden="true">+</span></summary>
        <ul class="oa-advisors__credentials">
          <li><span aria-hidden="true" class="oa-advisors__dot"></span><div><h3>Experience across tech and product</h3><p>Perspective shaped by operating roles and founder experience.</p></div></li>
          <li><span aria-hidden="true" class="oa-advisors__dot"></span><div><h3>Senior talent advisory</h3><p>Support for professionals navigating company, market and scope changes.</p></div></li>
          <li><span aria-hidden="true" class="oa-advisors__dot"></span><div><h3>Direct view of hiring decisions</h3><p>Grounded in real searches, interviews and offer conversations.</p></div></li>
          <li><span aria-hidden="true" class="oa-advisors__dot"></span><div><h3>Pragmatic, candid and involved</h3><p>Clear feedback, thoughtful strategy and genuine support throughout the process.</p></div></li>
        </ul>
        </details>
      </div>
    </div>
  </section>

  <div class="oa-close-wrap">
    <section class="oa-fit-check h3-surface">
      <div class="h3-wrap"><details class="oa-purchase-details">
        <summary>Is Offer Accelerator right for you? <span aria-hidden="true">+</span></summary>
      <div class="oa-close-grid">
        <div class="oa-fit-close__intro">
          <p class="h3-eyebrow">Is this for you?</p>
          <h2 id="oa-fit-close-title">Better to know before you apply.</h2>
          <p>This program is designed for senior professionals who are serious about their next move. Take a moment to see if it is the right fit.</p>
        </div>
        <div class="oa-fit-card oa-fit-card--yes">
          <h3><span aria-hidden="true">✓</span> This is for you if</h3>
          <ul>
            <li>You are a senior IC, leader or former founder changing company, market or scope.</li>
            <li>You are in an active process, or ready to start one.</li>
            <li>You want to do more between sessions: research, outreach, applications and interviews.</li>
          </ul>
        </div>
        <div class="oa-fit-card oa-fit-card--no">
          <h3><span aria-hidden="true">×</span> This is not for you if</h3>
          <ul>
            <li>You want a guaranteed job or pay increase.</li>
            <li>You want someone to apply on your behalf.</li>
            <li>Your main goal is to develop how you operate in your current role. <a href="/career-compounding">Explore Career Compounding.</a></li>
          </ul>
        </div>
      </div>
      </details></div>
    </section>

    <section class="oa-scope oa-included" id="investment" aria-labelledby="oa-scope-title">
      <div class="h3-wrap">
        <div class="oa-included__top">
          <div class="oa-included__intro">
            <p class="h3-eyebrow">Offer Accelerator</p>
            <h2 id="oa-scope-title">What is included.</h2>
            <p class="oa-included__lead">Eight private hours, personalized work and support as you pursue your next role.</p>
          </div>
          <div class="oa-included__price">
            <p>{t.investment.price}</p>
            <span>{t.investment.note}</span>
            <a href={APPLY_OFFER} data-cta="offer-investment-apply" class="h3-btn oa-investment__cta">{t.apply.cta}<span aria-hidden="true">→</span></a>
          </div>
          <aside class="oa-included__quote">
            <div class="oa-included__quote-context"><h3>{t.fit.commitmentTitle}</h3><p>Bring accurate evidence and carry out the agreed plan between sessions.</p></div>
          </aside>
        </div>
        <ul class="oa-included__highlights">{includedItems.map(item => <li>{item.title}</li>)}</ul>
        <details class="oa-scope-full oa-purchase-details"><summary>Full scope and support terms <span aria-hidden="true">+</span></summary>
        <ul class="oa-included__items">
          {includedItems.map((item,i)=>(
            <li>
              <span class="oa-included__icon" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
            </li>
          ))}
        </ul>
        <p class="oa-scope-full__commitment">{t.fit.commitment}</p>
        </details>
        <aside class="oa-confidentiality" aria-labelledby="oa-firewall-title">
          <h3 id="oa-firewall-title">{t.firewall.headline}</h3>
          <p>Advisory is confidential and gives no preference in client searches. Applying to open roles is free.</p>
          <details class="oa-confidentiality__details">
            <summary>How confidentiality works <span aria-hidden="true">↗</span></summary>
            <div>{t.firewall.body.map(paragraph => <p>{paragraph}</p>)}</div>
          </details>
        </aside>
      </div>
    </section>
  </div>

  <section class="oa-decide h3-surface" aria-labelledby="oa-decide-title">
    <div class="h3-wrap oa-decide__grid">
      <div>
        <p class="h3-eyebrow">{t.faq.eyebrow}</p>
        <h2 class="h3-h2" id="oa-decide-title">Clear commitments before you pay.</h2>
        <p class="h3-body">We agree your advisor, scope and fee before payment. We commit to the preparation, feedback and follow-up described in your program.</p>
        <p class="oa-decide__limit">A job or salary increase is not guaranteed.</p>
        <a class="h3-link" href="/for-talent/#compare-programs">Compare all three options <span aria-hidden="true">→</span></a>
      </div>
      <div class="oa-decide__questions">
        <details><summary>Why does investment range from USD 2,000 to 8,000?</summary><p>{t.investment.note} Your advisor, scope and next steps are agreed before payment and scheduling.</p></details>
        <details><summary>How much private time is included?</summary><p>Eight one-hour sessions: one diagnostic and seven private sessions with a senior consultant. {t.includes.items[4]}</p></details>
        {t.faq.items.filter((_, index) => index !== 2).map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        <details><summary>What if the evidence does not support the move?</summary><p>{t.question.body}</p></details>
        <details><summary>What happens after I apply?</summary>
          <ol class="oa-decide__steps">{t.apply.steps.map((step,index) => <li><span aria-hidden="true">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol>
        </details>
      </div>
    </div>
  </section>

  <section class="oa-apply oa-apply--mineral" aria-labelledby="oa-apply-title">
    <div class="h3-wrap oa-apply__layout">
      <div class="oa-apply__copy">
        <h2 class="h3-h2" id="oa-apply-title">{t.apply.headline}</h2>
        <p class="h3-body">{t.apply.body}</p>
        <a href={APPLY_OFFER} data-cta="offer-close-apply" class="h3-btn oa-apply__cta">{t.apply.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
        <p class="oa-apply__how">{t.apply.howNote}</p>
      </div>
      <div class="oa-apply__scene" aria-hidden="true"></div>
    </div>
  </section>
</Shell>




<script>
  // Observe only elements below the current viewport. Content remains visible without JS.
  const offerReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!offerReduced && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll<HTMLElement>(
      '.oa-familiar__heading, .oa-why, .oa-stages__tabs, .oa-stages__panels, .oa-testimonials__intro, .oa-testimonials__viewport, .oa-advisors__media, .oa-advisors__copy, .oa-fit-close__intro, .oa-fit-card, .oa-included__intro, .oa-included__price, .oa-included__quote, .oa-included__items, .oa-confidentiality, .oa-apply__copy'
    );
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('oa-reveal-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold:0.08, rootMargin:'0px 0px -35px 0px' });
    targets.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * .95) return;
      el.classList.add('oa-reveal-ready');
      observer.observe(el);
    });
  }

  const stages = document.querySelector<HTMLElement>('[data-stages]');
  if (stages) {
    const tabs = Array.from(stages.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
    const panels = Array.from(stages.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const prev = stages.querySelector<HTMLButtonElement>('[data-stage-prev]')!;
    const next = stages.querySelector<HTMLButtonElement>('[data-stage-next]')!;
    const counter = stages.querySelector<HTMLElement>('[data-stage-counter]')!;
    const dots = Array.from(stages.querySelectorAll<HTMLElement>('.oa-stages__dots i'));
    let active = 0;
    const show = (index: number) => {
      active = Math.max(0, Math.min(index, panels.length - 1));
      panels.forEach((panel,i) => {
        panel.hidden = i !== active;
        panel.classList.remove('oa-stage--entering');
        if(i === active && stages.classList.contains('oa-stages--enhanced') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          void panel.offsetWidth;
          panel.classList.add('oa-stage--entering');
        }
      });
      tabs.forEach((tab,i) => { if(i === active) tab.setAttribute('aria-current','step'); else tab.removeAttribute('aria-current'); });
      prev.disabled = active === 0; next.disabled = active === panels.length - 1;
      counter.textContent = `Stage ${active + 1} of ${panels.length}`;
      dots.forEach((dot,i)=>dot.classList.toggle('active',i === active));
    };
    tabs.forEach((tab,i) => {
      tab.addEventListener('click',()=>show(i));
      tab.addEventListener('keydown',(event)=>{
        if(event.key === 'ArrowRight' || event.key === 'ArrowLeft' || event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          const target = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length-1 : (i + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          show(target);tabs[target].focus();
        }
      });
    });
    prev.addEventListener('click',()=>show(active-1));next.addEventListener('click',()=>show(active+1));
    show(0);stages.classList.add('oa-stages--enhanced');
  }
  const testimonials = document.querySelector<HTMLElement>('[data-testimonials]');
  if(testimonials) {
    const viewport = testimonials.querySelector<HTMLElement>('[data-voice-viewport]')!;
    const cards = Array.from(viewport.querySelectorAll<HTMLElement>('.oa-testimonial'));
    const prev = testimonials.querySelector<HTMLButtonElement>('[data-voice-prev]')!;
    const next = testimonials.querySelector<HTMLButtonElement>('[data-voice-next]')!;
    const position = testimonials.querySelector<HTMLElement>('[data-voice-position]')!;
    const controls = testimonials.querySelector<HTMLElement>('.oa-testimonials__controls')!;
    const update = () => {
      const max = viewport.scrollWidth-viewport.clientWidth;
      controls.hidden = max <= 3;
      const first = cards.reduce((best,card,i)=>Math.abs(card.offsetLeft - cards[0].offsetLeft - viewport.scrollLeft)<Math.abs(cards[best].offsetLeft - cards[0].offsetLeft - viewport.scrollLeft)?i:best,0);
      const visible = cards.filter(card=>card.offsetLeft - cards[0].offsetLeft >= viewport.scrollLeft - 2 && card.offsetLeft-cards[0].offsetLeft+card.offsetWidth <= viewport.scrollLeft+viewport.clientWidth+2).length;
      position.textContent = `${first+1}–${Math.min(cards.length,first+Math.max(1,visible))} of ${cards.length}`;
      prev.disabled = viewport.scrollLeft<=2;next.disabled = viewport.scrollLeft>=max-2;
    };
    const move = (direction:number) => {
      const offset = cards[1]?.offsetLeft-cards[0]?.offsetLeft || cards[0]?.offsetWidth || 0;
      viewport.scrollBy({left:direction*offset,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
    };
    prev.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));
    viewport.addEventListener('scroll',update,{passive:true});
    viewport.addEventListener('keydown',e=>{if(e.target===viewport && (e.key==='ArrowLeft'||e.key==='ArrowRight')){e.preventDefault();move(e.key==='ArrowRight'?1:-1);}});
    window.addEventListener('resize',update);
    update();
  }
</script>
