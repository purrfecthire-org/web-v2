---
// ── Offer Accelerator ────────────────────────────────────────────────────
// Product page. Same system as Home and For Talent: Ivory as the main
// surface, Midnight for the hero and one weighted moment, Stone for the
// investment block, purple only for action and the single brand dot.
// Every apply button opens the same destination, and the line under the
// button says what happens when it does.
import Shell from '../v2/Shell.astro';
import ClientPortrait from '../v2/ClientPortrait.astro';
import ParticipantVoices from '../v2/ParticipantVoices.astro';
import type { Lang } from '../../content/index';
import { getOfferV2 } from '../../content/offerV2';
import { APPLY_OFFER } from '../../content/links';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getOfferV2(lang);
---

<Shell
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  theme="dark"
  navCta={{ label: t.hero.cta, href: APPLY_OFFER, external: true }}
  journey="offer"
>

      <!-- Hero -->
      <section class="h3-hero">
        <div class="h3-wrap h3-hero__grid">
          <div class="h3-hero__copy">
            <p class="h3-eyebrow h3-eyebrow--on-dark">{t.hero.eyebrow}</p>
            <h1 class="h3-hero__h1">{t.hero.headline}</h1>
            <p class="h3-hero__sub">{t.hero.sub}</p>
            <div class="oa-hero__package">
              <p class="oa-hero__price">{t.investment.price}</p>
              <p>{t.hero.package}</p>
            </div>
            <a href={APPLY_OFFER} data-cta="offer-hero-apply" class="h3-btn oa-hero__cta">
              {t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <figure class="h3-hero__media" style={{ "--photo-desktop": "8 / 5", "--photo-mobile": "4 / 3" }}>
<picture>
              <source media="(max-width: 55.99rem)" type="image/webp" srcset="/photos/web/offer-mobile.webp" />
              <source media="(max-width: 55.99rem)" srcset="/photos/web/offer-mobile.png" />
              <source type="image/webp" srcset="/photos/web/offer-desktop.webp" />
              <img src="/photos/web/offer-desktop.png" alt="Two people having a conversation at a desk." width="1200" height="750" decoding="async" fetchpriority="high" />
            </picture>
            <span class="h3-hero__scrim" aria-hidden="true"></span>
          </figure>
        </div>
      </section>

      <!-- The real question + method + access + firewall, one Sand surface -->
      <section class="oa-main">
        <div class="h3-wrap">
          <div class="oa-question">
            <div>
              <p class="h3-eyebrow">{t.question.eyebrow}</p>
              <h2 class="h3-h2">
                {t.question.headline}<span class="h3-dot--end" aria-hidden="true"></span>
              </h2>
            </div>
            <div>
              <p class="oa-question__body">{t.question.body}</p>
              <p class="h3-body oa-question__who">{t.question.who}</p>
            </div>
          </div>

          <div class="oa-deliverables" aria-labelledby="oa-deliverables-title">
            <p class="h3-eyebrow">{t.deliverables.eyebrow}</p>
            <h2 class="h3-h2" id="oa-deliverables-title">{t.deliverables.headline}</h2>
            <p class="h3-body oa-deliverables__intro">{t.deliverables.body}</p>
            <ul class="oa-deliverables__grid">
              {t.deliverables.items.map((item) => (
                <li class="oa-deliverable">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class="oa-fit">
            <div>
              <p class="h3-eyebrow">{t.fit.eyebrow}</p>
              <h2 class="h3-h2">{t.fit.headline}</h2>
              <p class="h3-body oa-fit__body">{t.fit.body}</p>
            </div>
            <div class="oa-fit__commitment">
              <h3>{t.fit.commitmentTitle}</h3>
              <p class="h3-body">{t.fit.commitment}</p>
            </div>
          </div>

          <div class="oa-method">
            <p class="h3-eyebrow">{t.method.eyebrow}</p>
            <h2 class="h3-h2 oa-method__h2">{t.method.headline}</h2>
            <ol class="oa-steps">
              {t.method.steps.map((s) => (
                <li class="oa-step">
                  <span class="oa-step__id">{s.id}</span>
                  <div>
                    <h3 class="oa-step__title">{s.title}</h3>
                    <p class="oa-step__body">{s.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <div class="oa-access">
            <h2 class="oa-access__h2">{t.access.headline}</h2>
            <p class="h3-body oa-access__body">{t.access.body}</p>
            <p class="oa-access__limit">{t.access.limit}</p>
          </div>

          <aside class="fw" aria-labelledby="oa-fw">
            <h2 class="fw__h" id="oa-fw">{t.firewall.headline}</h2>
            <p class="fw__lead">{t.firewall.lead}</p>
            <details class="fw__more">
              <summary>{t.firewall.more}</summary>
              <div>{t.firewall.body.map((b) => <p>{b}</p>)}</div>
            </details>
          </aside>
        </div>
      </section>

      <!-- What is included -->
      <section class="oa-includes">
        <div class="h3-wrap oa-includes__grid">
          <div>
            <p class="h3-eyebrow">{t.includes.eyebrow}</p>
            <h2 class="h3-h2">{t.includes.headline}</h2>
            <p class="oa-includes__closing">{t.includes.closing}</p>
          </div>
          <ul class="oa-list">
            {t.includes.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </section>

      <!-- Where our read comes from (the one weighted dark moment) -->
      <section class="oa-behind">
        <div class="h3-wrap oa-behind__grid">
          <div>
            <p class="h3-eyebrow h3-eyebrow--on-dark">{t.behind.eyebrow}</p>
            <h2 class="h3-h2 h3-h2--on-dark">{t.behind.headline}</h2>
          </div>
          <div class="oa-behind__body">
            {t.behind.body.map((b) => <p>{b}</p>)}
          </div>
        </div>
      </section>

      <!-- Proof -->
      <section class="oa-proof">
        <div class="h3-wrap">
          <p class="h3-eyebrow">{t.proof.eyebrow}</p>
          <h2 class="h3-h2 oa-proof__h2">{t.proof.headline}</h2>
          <figure class="oa-quote">
            <div class="oa-quote__photo">
              <ClientPortrait alt={t.proof.name} />
            </div>
            <blockquote>“{t.proof.quote}”</blockquote>
            <figcaption>
              <span class="oa-quote__name">{t.proof.name}</span>
              <span class="oa-quote__role">{t.proof.role}</span>
              <span class="oa-quote__role">Translated from Spanish</span>
            </figcaption>
          </figure>
          <ParticipantVoices />
        </div>
      </section>

      <!-- Investment -->
      <section class="oa-investment">
        <div class="h3-wrap oa-investment__grid">
          <div>
            <p class="h3-eyebrow">{t.investment.eyebrow}</p>
            <h2 class="h3-h2">{t.investment.headline}</h2>
          </div>
          <div>
            <p class="oa-price">{t.investment.price}</p>
            <p class="h3-body oa-investment__next">{t.investment.next}</p>
          </div>
        </div>
      </section>

      <!-- Questions that help the reader decide -->
      <section class="oa-faq" aria-labelledby="oa-faq-title">
        <div class="h3-wrap oa-faq__grid">
          <div>
            <p class="h3-eyebrow">{t.faq.eyebrow}</p>
            <h2 class="h3-h2" id="oa-faq-title">{t.faq.headline}</h2>
          </div>
          <div class="oa-faq__items">
            {t.faq.items.map((item) => (
              <details class="oa-faq__item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Apply -->
      <section class="oa-apply">
        <div class="h3-wrap">
          <h2 class="h3-h2 oa-apply__h2">{t.apply.headline}</h2>
          <p class="h3-body oa-apply__body">{t.apply.body}</p>
          <ol class="oa-apply__steps">
            {t.apply.steps.map((step, index) => (
              <li>
                <span class="oa-apply__step-id" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <p class="oa-apply__price">{t.investment.price}</p>
          <a href={APPLY_OFFER} data-cta="offer-close-apply" class="h3-btn oa-apply__cta">
            {t.apply.cta}<span class="h3-arrow" aria-hidden="true">→</span>
          </a>
          <p class="oa-apply__how">{t.apply.howNote}</p>
          <p class="oa-editorial">{t.editorial}</p>
        </div>
      </section>

    </Shell>

<style lang="scss" is:global>
  .oa-hero__package { margin-top: 1.75rem; max-width: 34rem; display: grid; gap: 0.5rem; }
  .oa-hero__package > p { font-size: var(--type-ui); line-height: 1.6; color: var(--on-dark-muted); }
  .oa-hero__package > .oa-hero__price { font-size: var(--type-subheading); line-height: 1.2; font-weight: 500; color: var(--on-dark); font-family: var(--h-sans); }
  .oa-hero__cta { margin-top: 1.5rem; }
  .oa-main { background: var(--sand); padding: 5rem 0 6rem; }
  @media (min-width: 56rem) { .oa-main { padding: 6.5rem 0 7.5rem; } }
  .oa-question { display: grid; gap: 1.75rem; align-items: start; }
  @media (min-width: 56rem) { .oa-question { grid-template-columns: 1.05fr 1fr; gap: 4rem; } }
  .oa-question__body { font-size: var(--type-lead); line-height: 1.55; color: var(--text); max-width: 32rem; }
  @media (min-width: 56rem) { .oa-question__body { padding-top: 1.9rem; } }
  .oa-question__who { margin-top: 1.25rem; }

  .oa-deliverables { margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--line); }
  .oa-deliverables .h3-h2 { max-width: 28ch; }
  .oa-deliverables__intro { margin-top: 1.25rem; max-width: 43rem; }
  .oa-deliverables__grid { margin-top: 2rem; display: grid; gap: 0 2rem; }
  .oa-deliverable { border-top: 1px solid var(--line); padding: 1.5rem 0; }
  .oa-deliverable h3 { font-size: var(--type-subheading); font-weight: 500; line-height: 1.4; }
  .oa-deliverable p { margin-top: 0.6rem; color: var(--muted); font-size: var(--type-body); line-height: 1.65; }
  @media (min-width: 40rem) { .oa-deliverables__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .oa-deliverables__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 2.75rem; } }

  .oa-fit { margin-top: 3rem; padding-top: 3rem; border-top: 1px solid var(--line); display: grid; gap: 2rem; align-items: start; }
  .oa-fit__body { margin-top: 1.25rem; }
  .oa-fit__commitment h3 { font-size: var(--type-subheading); font-weight: 500; line-height: 1.4; }
  .oa-fit__commitment p { margin-top: 0.75rem; }
  @media (min-width: 56rem) {
    .oa-fit { grid-template-columns: 1.05fr 1fr; gap: 4rem; }
    .oa-fit__commitment { padding-top: 2.25rem; }
  }

  .oa-method { margin-top: 5rem; }
  @media (min-width: 56rem) { .oa-method { margin-top: 7rem; } }
  .oa-method__h2 { max-width: 30ch; }
  .oa-steps { margin-top: 2.5rem; display: grid; gap: 0 3.5rem; border-top: 1px solid var(--line); }
  @media (min-width: 56rem) { .oa-steps { grid-template-columns: 1fr 1fr; } }
  .oa-step { display: grid; grid-template-columns: 2.75rem 1fr; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .oa-step__id { font-size: var(--type-caption); font-weight: 500; color: var(--muted); padding-top: 0.25rem; }
  .oa-step__title { font-size: var(--type-subheading); font-weight: 500; line-height: 1.3; }
  .oa-step__body { margin-top: 0.4rem; color: var(--muted); }

  .oa-access { margin-top: 4rem; max-width: 46rem; }
  .oa-access__h2 { font-size: var(--type-subheading); font-weight: 500; letter-spacing: -0.005em; font-family: var(--h-sans); }
  .oa-access__body { margin-top: 1rem; max-width: 44rem; }
  .oa-access__limit { margin-top: 1rem; font-size: var(--type-body); font-weight: 500; }

  .fw { margin-top: 3.5rem; max-width: 44rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .fw__h { font-size: var(--type-subheading); font-weight: 500; letter-spacing: -0.005em; font-family: var(--h-sans); }
  .fw__lead { margin-top: 0.75rem; font-size: var(--type-body); line-height: 1.6; color: var(--text); }
  .fw__more { margin-top: 1rem; }
  .fw__more > summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: var(--type-ui); font-weight: 500; color: var(--text);
    border-bottom: 1px solid var(--line); padding-bottom: 2px;
  }
  .fw__more > summary::-webkit-details-marker { display: none; }
  .fw__more > summary::after { content: '+'; font-size: var(--type-body); line-height: 1; color: var(--purple); }
  .fw__more[open] > summary::after { content: '–'; }
  .fw__more > summary:hover { border-color: var(--text); }
  .fw__more > div { margin-top: 1rem; display: grid; gap: 0.85rem; }
  .fw__more p { font-size: var(--type-body); line-height: 1.7; color: var(--muted); }

  .oa-includes { background: var(--sand); border-top: 1px solid var(--line); padding: 5rem 0; }
  @media (min-width: 56rem) { .oa-includes { padding: 7rem 0; } }
  .oa-includes__grid { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 56rem) { .oa-includes__grid { grid-template-columns: 1fr 1.05fr; gap: 5rem; } }
  .oa-includes__closing { margin-top: 1.5rem; font-size: var(--type-lead); line-height: 1.55; max-width: 28rem; }
  .oa-list { border-top: 1px solid var(--line); }
  .oa-list li { padding: 1.1rem 0; border-bottom: 1px solid var(--line); font-size: var(--type-body); line-height: 1.6; }

  .oa-behind { background: var(--midnight); color: var(--on-dark); padding: 5rem 0; }
  @media (min-width: 56rem) { .oa-behind { padding: 7rem 0; } }
  .oa-behind__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 56rem) { .oa-behind__grid { grid-template-columns: 1fr 1.1fr; gap: 5rem; } }
  .oa-behind__body { display: grid; gap: 1.25rem; }
  .oa-behind__body p { font-size: var(--type-body); line-height: 1.7; color: var(--on-dark-muted); max-width: 36rem; }

  .oa-proof { background: var(--sand); padding: 5rem 0; }
  @media (min-width: 56rem) { .oa-proof { padding: 6.5rem 0; } }
  .oa-proof__h2 { max-width: 20ch; }
  .oa-quote { margin-top: 2.5rem; display: grid; gap: 1.25rem; align-items: start; }
  .oa-quote__photo { aspect-ratio: 3 / 2; overflow: hidden; border-radius: 12px; background: var(--stone); margin-bottom: 0.75rem; }
  .oa-quote__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .oa-quote blockquote {
    font-family: var(--h-sans); font-size: var(--type-quote);
    line-height: 1.55; max-width: 34ch; font-weight: 400; }
  .oa-quote figcaption { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--type-caption); }
  .oa-quote__name { font-weight: 500; }
  .oa-quote__role { color: var(--muted); }
  @media (min-width: 56rem) {
    .oa-quote { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); column-gap: 3rem; row-gap: 1.5rem; }
    .oa-quote__photo { grid-row: 1 / span 2; margin-bottom: 0; }
    .oa-quote blockquote, .oa-quote figcaption { grid-column: 2; }
  }

  .oa-investment { background: var(--stone); padding: 4.5rem 0; }
  @media (min-width: 56rem) { .oa-investment { padding: 6rem 0; } }
  .oa-investment__grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 56rem) { .oa-investment__grid { grid-template-columns: 1.1fr 1fr; gap: 4rem; } }
  .oa-price {
    font-family: var(--h-sans); font-size: var(--type-section);
    line-height: 1.2; letter-spacing: -0.02em; font-weight: 500; }
  @media (min-width: 56rem) { .oa-price { padding-top: 1.4rem; } }
  .oa-investment__next { margin-top: 1.25rem; }

  .oa-faq { background: var(--sand); padding: 4.5rem 0 0; }
  .oa-faq__grid { display: grid; gap: 2rem; align-items: start; }
  .oa-faq__items { border-top: 1px solid var(--line); }
  .oa-faq__item { border-bottom: 1px solid var(--line); }
  .oa-faq__item > summary { padding: 1.25rem 0; display: flex; justify-content: space-between; gap: 1.5rem; cursor: pointer; list-style: none; font-size: var(--type-body); font-weight: 500; line-height: 1.5; }
  .oa-faq__item > summary::-webkit-details-marker { display: none; }
  .oa-faq__item > summary::after { content: '+'; flex: 0 0 auto; color: var(--purple); }
  .oa-faq__item[open] > summary::after { content: '−'; }
  .oa-faq__item > p { margin: 0 0 1.5rem; max-width: 44rem; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .oa-faq__item > summary:focus-visible { outline: 2px solid var(--purple); outline-offset: 4px; border-radius: 2px; }
  @media (min-width: 56rem) { .oa-faq { padding-top: 6rem; } .oa-faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }

  .oa-apply { background: var(--sand); padding: 5rem 0 6rem; }
  @media (min-width: 56rem) { .oa-apply { padding: 7rem 0 8rem; } }
  .oa-apply__h2 { max-width: 24ch; }
  .oa-apply__body { margin-top: 1.25rem; }
  .oa-apply__steps { margin-top: 2.5rem; display: grid; gap: 1.5rem 2rem; }
  .oa-apply__steps li { padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .oa-apply__step-id { display: block; color: var(--muted); font-size: var(--type-caption); margin-bottom: 0.75rem; }
  .oa-apply__steps h3 { font-size: var(--type-subheading); line-height: 1.4; font-weight: 500; }
  .oa-apply__steps p { margin-top: 0.6rem; font-size: var(--type-body); line-height: 1.6; color: var(--muted); max-width: 32rem; }
  @media (min-width: 56rem) { .oa-apply__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .oa-apply__price { margin-top: 2rem; font-size: var(--type-subheading); line-height: 1.4; font-weight: 500; }
  .oa-apply__cta { margin-top: 1rem; }
  /* Says what the button does before it is pressed. */
  .oa-apply__how {
    margin-top: 1rem; max-width: 30rem;
    font-size: var(--type-caption); line-height: 1.6; color: var(--muted);
  }
  .oa-editorial {
    margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line);
    font-family: var(--h-sans); font-size: var(--type-lead);
    line-height: 1.65; color: var(--muted);
  }

  .h3-footer {
    background: var(--midnight); color: var(--on-dark-muted);
    border-top: 1px solid var(--line-dark); padding: 2rem 0 2.5rem; font-size: var(--type-caption);
  }
  .h3-footer__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .h3-footer nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .h3-footer a:hover { color: var(--on-dark); }

  @media (prefers-reduced-motion: reduce) { .h3 * { transition: none !important; } }
</style>
