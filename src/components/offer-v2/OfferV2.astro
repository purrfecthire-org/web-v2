---
import Shell from '../v2/Shell.astro';
import CatIllustration from '../v2/CatIllustration.astro';
import ClientPortrait from '../v2/ClientPortrait.astro';
import SocialIcon from '../v2/SocialIcon.astro';
import { talentTestimonials } from '../../content/talentTestimonials';
import type { Lang } from '../../content/index';
import { getOfferV2 } from '../../content/offerV2';
import { APPLY_OFFER } from '../../content/links';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getOfferV2(lang);
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="light"
  navCta={{ label: t.hero.cta, href: APPLY_OFFER }} journey="offer">
  <section class="h3-hero">
    <div class="h3-wrap h3-hero__grid">
      <div class="h3-hero__copy">
        <p class="h3-eyebrow">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1">{t.hero.headline}</h1>
        <p class="h3-hero__sub">{t.hero.sub}</p>
      </div>
      <div class="oa-hero__offer">
        <p class="h3-eyebrow">{t.investment.eyebrow}</p>
        <p class="oa-hero__price">{t.investment.price}</p>
        <p class="oa-investment__note">{t.investment.note}</p>
        <p class="oa-hero__package">{t.hero.package}</p>
        <p class="oa-hero__fit">{t.fit.body}</p>
        <a href={APPLY_OFFER} data-cta="offer-hero-apply" class="h3-btn oa-hero__cta">{t.hero.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="oa-work" aria-labelledby="oa-work-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.deliverables.eyebrow}</p>
      <h2 class="h3-h2" id="oa-work-title">{t.deliverables.headline}</h2>
      <div class="oa-work__intro">
        <p class="h3-body">{t.deliverables.body}</p>
      </div>
      <ol class="oa-outputs">
        {t.deliverables.items.map((item, index) => (
          <li class="oa-output">
            <div class="oa-output__heading">
              <span class="oa-output__id" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
            </div>
            <div class="oa-output__body">
              <p>{item.body}</p>
              {item.note && <p class="oa-output__note">{item.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="oa-proof" id="voices" aria-labelledby="oa-proof-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.proof.eyebrow}</p>
      <h2 class="h3-h2" id="oa-proof-title">{t.proof.headline}</h2>
      <figure class="oa-quote">
        <ClientPortrait alt={t.proof.name} shape="circle" />
        <div class="oa-quote__copy">
          <blockquote>“{t.proof.quote}”</blockquote>
          <figcaption>
            <strong>{t.proof.name}</strong>
            <span>{t.proof.role}</span>
            <span>Translated from Spanish</span>
            <a class="oa-quote__linkedin" href={t.proof.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`View ${t.proof.name} on LinkedIn`}><SocialIcon name="linkedin" />View LinkedIn<span aria-hidden="true">↗</span></a>
          </figcaption>
        </div>
      </figure>
      {talentTestimonials.map(voice => <figure class="oa-quote">
        <img class="oa-quote__portrait" src={voice.photo} alt={voice.name} width="480" height="480" loading="lazy" decoding="async" />
        <div class="oa-quote__copy">
          <blockquote>“{voice.quote}”</blockquote>
          {voice.reflection && <p class="oa-quote__reflection">“{voice.reflection}”</p>}
          <figcaption><strong>{voice.name}</strong><span>{voice.context}</span><span>{voice.translation}</span><a class="oa-quote__linkedin" href={voice.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`View ${voice.name} on LinkedIn`}><SocialIcon name="linkedin" />View LinkedIn<span aria-hidden="true">↗</span></a></figcaption>
        </div>
      </figure>)}
    </div>
  </section>

  <section class="oa-scope" aria-labelledby="oa-scope-title">
    <div class="h3-wrap">
      <p class="h3-eyebrow">{t.includes.eyebrow}</p>
      <h2 class="h3-h2" id="oa-scope-title">{t.includes.headline}</h2>
      <div class="oa-scope__grid">
        <div class="oa-investment">
          <p class="h3-eyebrow">{t.investment.eyebrow}</p>
          <p class="oa-price">{t.investment.price}</p>
          <p class="oa-investment__note">{t.investment.note}</p>
          <a href={APPLY_OFFER} data-cta="offer-investment-apply" class="h3-btn oa-investment__cta">{t.apply.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="oa-inclusions">{t.includes.items.map(item => <li><span>{item}</span></li>)}</ul>
      </div>
      <div class="oa-scope__details">
        <div>
          <div class="oa-commitment">
            <h3>{t.fit.commitmentTitle}</h3>
            <p class="h3-body">{t.fit.commitment}</p>
          </div>
          <aside class="oa-firewall" aria-labelledby="oa-firewall-title">
            <h3 id="oa-firewall-title">{t.firewall.headline}</h3>
            <p class="h3-body">{t.firewall.lead}</p>
            <details class="oa-detail">
              <summary>{t.firewall.more}</summary>
              <div>{t.firewall.body.map(paragraph => <p>{paragraph}</p>)}</div>
            </details>
          </aside>
        </div>
        <div class="oa-questions">
          <p class="h3-eyebrow">{t.faq.eyebrow}</p>
          <div class="oa-questions__list">
            {t.faq.items.map(item => <details class="oa-detail"><summary>{item.question}</summary><p>{item.answer}</p></details>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="oa-apply" aria-labelledby="oa-apply-title">
    <div class="h3-wrap oa-apply__layout">
      <div class="oa-apply__copy">
      <h2 class="h3-h2" id="oa-apply-title">{t.apply.headline}</h2>
      <p class="h3-body">{t.apply.body}</p>
      <a href={APPLY_OFFER} data-cta="offer-close-apply" class="h3-btn oa-apply__cta">{t.apply.cta}<span class="h3-arrow" aria-hidden="true">→</span></a>
      <p class="oa-apply__how">{t.apply.howNote}</p>
      </div>
      <CatIllustration pose="walk" />
    </div>
  </section>
</Shell>

<style lang="scss" is:global>
  .oa-hero__offer { min-width: 0; padding-block: var(--space-4); border-block: 1px solid var(--line); }
  .oa-hero__price, .oa-price { font-family: var(--h-sans); font-size: var(--type-section); line-height: 1.12; font-weight: 500; letter-spacing: -.014em; color: var(--text); font-variant-numeric: tabular-nums; }
  .oa-hero__price { margin-top: var(--space-2); }
  .oa-hero__package { margin-top: var(--space-stack); max-width: 54ch; font-size: var(--type-body); line-height: 1.6; color: var(--text); }
  .oa-hero__fit { margin-top: var(--space-stack); max-width: 54ch; font-size: var(--type-ui); line-height: 1.5; color: var(--muted); }
  .oa-hero__cta { margin-top: var(--space-stack); max-width: 100%; }
  .oa-work, .oa-proof, .oa-scope, .oa-apply { padding-block: var(--space-section); background: var(--sand); }
  .oa-work, .oa-scope, .oa-apply { border-top: 1px solid var(--line); }
  .oa-work .h3-h2, .oa-proof .h3-h2, .oa-scope .h3-h2, .oa-apply .h3-h2 { max-width: 28ch; }
  .oa-work__intro { margin-top: var(--space-3); max-width: 44rem; }
  .oa-outputs { margin-top: var(--space-4); }
  .oa-output { display: grid; align-items: baseline; min-width: 0; gap: var(--space-2); padding-block: var(--space-3); border-top: 1px solid var(--line); }
  .oa-output__heading { display: flex; align-items: baseline; gap: var(--space-2); min-width: 0; }
  .oa-output__id { flex-shrink: 0; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; font-variant-numeric: tabular-nums; }
  .oa-output h3 { font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .oa-output__body > p { max-width: 34rem; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .oa-output__body > .oa-output__note { margin-top: var(--space-2); font-size: var(--type-ui); line-height: 1.5; }
  .oa-proof { scroll-margin-top: var(--space-hero-top); }
  .oa-quote { margin-top: var(--space-4); display: grid; gap: var(--space-grid); align-items: start; }
  .oa-quote__copy { min-width: 0; }
  .oa-quote blockquote { font-family: var(--h-sans); font-size: var(--type-quote); line-height: 1.5; max-width: 46ch; font-weight: 400; }
  .oa-quote figcaption { margin-top: var(--space-3); display: grid; gap: var(--space-1); font-size: var(--type-caption); line-height: 1.5; }
  .oa-quote figcaption strong { font-weight: 500; }
  .oa-quote figcaption span { color: var(--muted); }
  .oa-quote + .oa-quote { padding-top: var(--space-grid); border-top: 1px solid var(--line); }
  .oa-quote__portrait { display: block; width: calc(var(--space-8) * 2); height: calc(var(--space-8) * 2); border-radius: 50%; object-fit: cover; object-position: 50% 30%; }
  .oa-quote__linkedin { display: inline-flex; align-items: center; gap: var(--space-1); justify-self: start; min-height: var(--space-6); color: var(--text); text-decoration: underline; text-underline-offset: .2em; }
  .oa-quote__linkedin:hover { color: var(--purple); }
  .oa-quote__reflection { margin-top: var(--space-2); max-width: 54ch; font-size: var(--type-body); line-height: 1.6; color: var(--muted); }
  .oa-scope__grid, .oa-scope__details { display: grid; gap: var(--space-grid); align-items: start; margin-top: var(--space-grid); }
  .oa-scope__grid > *, .oa-scope__details > * { min-width: 0; }
  .oa-investment { padding-top: var(--space-stack); border-top: 1px solid var(--line); }
  .oa-price { margin-top: var(--space-2); }
  .oa-investment__cta { margin-top: var(--space-stack); max-width: 100%; }
  .oa-investment__note { margin-top: var(--space-2); max-width: 54ch; font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .oa-scope__details { padding-top: var(--space-grid); border-top: 1px solid var(--line); }
  .oa-inclusions li { padding-block: var(--space-stack); border-top: 1px solid var(--line); font-size: var(--type-body); line-height: 1.6; }
  .oa-inclusions li span { display: block; max-width: 54ch; }
  .oa-commitment { margin-top: 0; }
  .oa-commitment .h3-body { margin-top: var(--space-2); }
  .oa-firewall { margin-top: var(--space-6); max-width: 44rem; }
  .oa-firewall > .h3-body { margin-top: var(--space-2); }
  .oa-firewall .oa-detail { margin-top: var(--space-2); }
  .oa-questions { margin-top: 0; }
  .oa-questions > .h3-eyebrow { margin-bottom: var(--space-2); }
  .oa-detail { border-bottom: 1px solid var(--line); }
  .oa-detail summary { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); padding-block: var(--space-3); cursor: pointer; list-style: none; font-size: var(--type-body); font-weight: 500; line-height: 1.7; }
  .oa-detail summary::-webkit-details-marker { display: none; }
  .oa-detail summary::after { content: '+'; flex-shrink: 0; color: var(--purple); }
  .oa-detail[open] summary::after { content: '×'; }
  .oa-detail > p, .oa-detail > div { padding-bottom: var(--space-3); max-width: 44rem; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .oa-detail > div { display: grid; gap: var(--space-2); }
  .oa-apply .h3-body { margin-top: var(--space-3); }
  .oa-apply__layout { display: grid; gap: var(--space-grid); align-items: center; }
  .oa-apply__copy { min-width: 0; }
  .oa-apply__cta { margin-top: var(--space-4); }
  .oa-apply__how { margin-top: var(--space-2); max-width: 34rem; font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  @media (min-width: 56rem) {
    .oa-apply__layout { grid-template-columns: minmax(0, 1fr) minmax(0, calc(var(--space-8) * 4)); }
    .oa-output { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: var(--space-grid); }
    .oa-quote { grid-template-columns: 8rem minmax(0, 1fr); }
    .oa-scope__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .oa-scope__details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
