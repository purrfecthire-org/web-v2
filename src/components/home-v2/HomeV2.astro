---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getHomeV2 } from '../../content/homeV2';
import { CLIENT_BRANDS } from '../../content/clientBrands';
import { PAGE_COMPANIES, PAGE_TALENT, BOOKING_B2B, WHATSAPP_B2B } from '../../content/links';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getHomeV2(lang);
const proofClients = CLIENT_BRANDS.slice(0, 8);
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="dark" navCta={{ label: t.hero.bookingCta, href: BOOKING_B2B }} journey="home">
  <section class="h3-hero home-entry" aria-labelledby="home-title">
    <div class="h3-wrap h3-hero__grid">
      <div class="h3-hero__copy">
        <p class="h3-eyebrow h3-eyebrow--on-dark">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1" id="home-title">{t.hero.headline}</h1>
        <p class="h3-hero__sub">{t.hero.sub}</p>
      </div>
      <figure class="h3-hero__media home-entry__media" style={{ '--photo-desktop': '8 / 5', '--photo-mobile': '4 / 3' }}>
        <picture>
          <source media="(max-width: 55.99rem)" type="image/webp" srcset="/photos/library/home-editorial-mobile.webp" />
          <source media="(max-width: 55.99rem)" srcset="/photos/library/home-editorial-mobile.png" />
          <source type="image/webp" srcset="/photos/library/home-editorial-desktop.webp" />
          <img src="/photos/library/home-editorial-desktop.png" alt={t.hero.photoAlt} width="1200" height="750" decoding="async" fetchpriority="high" />
        </picture>
      </figure>
        <nav class="home-paths" id="choose-your-path" aria-label={t.hero.choose}>
          <div class="home-path-group">
          <a class="home-path" href={PAGE_COMPANIES} data-cta="home-choose-companies">
            <span class="home-path__label">{t.hero.companies.label}</span>
            <span class="home-path__promise">{t.hero.companies.promise}</span>
            <span class="home-path__detail">{t.hero.companies.detail}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
          <div class="home-path__contact">
            <a href={BOOKING_B2B} data-cta="home-founders-direct-booking" class="h3-link">{t.hero.bookingCta} →</a>
            <a href={WHATSAPP_B2B} data-cta="home-founders-whatsapp" class="h3-link">{t.hero.whatsappCta} ↗</a>
          </div>
          </div>
          <a class="home-path" href={PAGE_TALENT} data-cta="home-choose-talent">
            <span class="home-path__label">{t.hero.talent.label}</span>
            <span class="home-path__promise">{t.hero.talent.promise}</span>
            <span class="home-path__detail">{t.hero.talent.detail}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
        </nav>
    </div>
  </section>

  <section class="home-proof" aria-labelledby="home-proof-label">
    <div class="h3-wrap">
      <p class="h3-eyebrow" id="home-proof-label">{t.proof.eyebrow}</p>
      <ul class="home-proof__logos">
        {proofClients.map((client) => (
          <li>
            <a href={client.href} target="_blank" rel="noopener noreferrer" aria-label={`${client.name}, official website (opens in a new tab)`} data-cta={`home-client-${client.id}`}>
              <img src={client.logo} alt={client.name} width={client.width} height={client.height} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <div class="home-proof__voice">
        <figure>
          <blockquote>“{t.proof.quote}”</blockquote>
          <figcaption><span>{t.proof.name}</span><span>{t.proof.role}</span></figcaption>
        </figure>
        <a href={t.proof.href} class="h3-link home-proof__cta" data-cta="home-proof-assessment">{t.proof.cta}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-kate" id="kate" aria-labelledby="kate-title">
    <div class="h3-wrap home-kate__grid">
      <figure class="home-kate__portrait">
        <picture>
          <source srcset="/brand/kate.webp" type="image/webp" />
          <img src="/brand/kate.jpg" alt="Kate Forero" width="900" height="1124" loading="lazy" />
        </picture>
      </figure>
      <div>
        <p class="h3-eyebrow">{t.kate.eyebrow}</p>
        <h2 class="h3-h2" id="kate-title">{t.kate.headline}</h2>
        <p class="h3-body">{t.kate.body}</p>
        <figure class="home-kate__recommendation">
          <blockquote>“{t.kate.recommendation.quote}”</blockquote>
          <figcaption>{t.kate.recommendation.name} · {t.kate.recommendation.context}</figcaption>
          <a href={t.kate.recommendation.href} target="_blank" rel="noopener noreferrer" class="h3-link">{t.kate.recommendation.cta} <span aria-hidden="true">↗</span></a>
        </figure>
        <div class="home-kate__links">
          <a href={PAGE_COMPANIES} class="h3-link" data-cta="home-kate-companies">{t.kate.ctaCompanies} <span aria-hidden="true">→</span></a>
          <a href={PAGE_TALENT} class="h3-link" data-cta="home-kate-talent">{t.kate.ctaTalent} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Shell>

<style>
  .home-entry { padding-bottom: 3rem; }
  .home-entry .h3-hero__grid { align-items: start; gap: 2rem; }
  .home-entry .home-entry__media { position: relative; inset: auto; transform: none; width: 100%; margin-top: 0; border-radius: 14px; overflow: hidden; order: 2; }
  .home-entry .h3-hero__h1 { max-width: 18ch; }
  .home-paths { display: grid; order: 1; border-top: 1px solid var(--line-dark); scroll-margin-top: 2rem; }
  .home-path { position: relative; display: grid; gap: .5rem; padding: 1.25rem 2rem 1.25rem 0; border-bottom: 1px solid var(--line-dark); transition: border-color .2s; }
  .home-path__contact { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; padding-top: 1rem; }
  .home-path__contact a { color: var(--on-dark); font-size: var(--type-caption); border-color: var(--line-dark); }
  .home-paths > .home-path { align-self: start; }
  .home-path:hover { border-color: var(--on-dark); }
  .home-path__label { color: var(--on-dark); font-size: var(--type-caption); font-weight: 500; }
  .home-path__promise { color: var(--on-dark); font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; font-family: var(--h-sans); }
  .home-path__detail { color: var(--on-dark-muted); font-size: var(--type-caption); }
  .home-path__arrow { position: absolute; right: 0; top: 50%; font-size: var(--type-subheading); color: var(--on-dark); transform: translateY(-50%); }
  .home-proof { padding: 2.75rem 0; background: var(--sand); border-top: 1px solid var(--line); }
  .home-proof__logos { margin-top: 1rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 1rem; align-items: center; }
  .home-proof__logos li { min-width: 0; }
  .home-proof__logos a { display: flex; align-items: center; justify-content: center; min-height: 64px; padding: 0.75rem; border-radius: 6px; }
  .home-proof__logos img { display: block; width: auto; height: auto; max-width: min(100%, 132px); max-height: 36px; object-fit: contain; }
  .home-proof__logos img[alt='Addi'] { width: 100px; max-height: 50px; }
  .home-proof__logos img[alt='Hera'] { width: 112px; max-height: 39px; }
  .home-proof__logos a:hover { background: var(--white); }
  .home-proof__voice { display: grid; gap: 1.5rem; margin-top: 1.5rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .home-proof__voice blockquote { max-width: 60ch; font-size: var(--type-quote); line-height: 1.55; color: var(--text); font-family: var(--h-sans); }
  .home-proof__voice figcaption { margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; font-size: var(--type-caption); color: var(--muted); }
  .home-proof__voice figcaption span:first-child { font-weight: 500; color: var(--text); }
  .home-proof__cta { justify-self: start; align-self: center; font-size: var(--type-ui); line-height: 1.5; }
  @media (min-width: 40rem) { .home-proof__logos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .home-proof__logos { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .home-proof__voice { grid-template-columns: minmax(0, 1fr) auto; gap: 3rem; }
  }
  .home-kate { background: var(--sand); padding: 4.5rem 0; border-top: 1px solid var(--line); }
  .home-kate__grid { display: grid; gap: 2.75rem; align-items: center; }
  .home-kate__portrait { max-width: 21rem; border-radius: 14px; overflow: hidden; }
  .home-kate__portrait img { display: block; width: 100%; height: auto; }
  .home-kate__links { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .home-kate__recommendation { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .home-kate__recommendation blockquote { font-size: var(--type-lead); line-height: 1.6; }
  .home-kate__recommendation figcaption { margin-top: .75rem; font-size: var(--type-caption); color: var(--muted); }
  .home-kate__recommendation a { margin-top: .75rem; font-size: var(--type-caption); }
  @media (min-width: 56rem) {
    .home-entry .h3-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
    .home-entry .home-entry__media { order: 0; }
    .home-paths { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
    .home-kate { padding: 7rem 0; } .home-kate__grid { grid-template-columns: .55fr 1.45fr; gap: 4.5rem; }
  }
</style>
