---
// ── Home v3 · rebrand ────────────────────────────────────────────────────
// Six blocks: hero (Midnight) → trust strip (ivory) → For Companies (white,
// primary audience) → For Talent (Midnight, four lines) → shared belief
// (stone) → Kate (Midnight close). Dark and light alternate on purpose.
// Purple is reserved for action and signal: buttons and signal dots. Never
// decoration. Photography and cat illustrations are clearly marked
// placeholders until the real assets land. Headline face is Instrument
// Serif standing in for Canela; swap --h-serif when the license is in.
import Layout from '../../layouts/Layout.astro';
import { getContent, type Lang } from '../../content/index';
import { getHomeV2 } from '../../content/homeV2';

interface Props { lang?: Lang }

const { lang = 'en' } = Astro.props;
const t = getHomeV2(lang);
const content = getContent(lang);
// Fabián Torres: three years working together, his own recommendation, and a
// photograph we can publish. The quote stays in his words.
const featured = content.testimonials.grid.find((q) => q.name === 'Fabián Torres') ?? content.testimonials.featured;
const p = lang === 'es' ? '/es' : '';

const clients = [
  { name: 'Addi', logo: '/clients/addi.png' },
  { name: 'PayJoy', logo: '/clients/payjoy.png' },
  { name: 'Heron', logo: '/clients/heron.png' },
  { name: 'Optery', logo: '/clients/optery.png' },
  { name: 'Trébol', logo: '/clients/trebol.png' },
  { name: 'Cheaf', logo: '/clients/cheaf.png' },
  { name: 'Mavi', logo: '/clients/mavi.png' },
  { name: 'Hera', logo: '/clients/hera.png' },
];
---

<Layout title={t.meta.title} description={t.meta.description} lang={lang} noindex>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="h3">
    <header class="h3-nav">
      <div class="h3-nav__in">
        <a href={p || '/'} class="h3-nav__logo" aria-label="Purrfect Hire">
          <picture>
            <source srcset="/logos/logo-desktop.webp" type="image/webp" />
            <img src="/logos/logo-desktop.png" alt="Purrfect Hire" />
          </picture>
        </a>
        <nav class="h3-nav__links" aria-label="Main">
          <a href={`${p}/for-founders`}>{t.nav.companies}</a>
          <a href={`${p}/for-talent`}>{t.nav.talent}</a>
          <a href="/roles">{t.nav.roles}</a>
          <a href={`${p}/kate`}>{t.nav.kate}</a>
        </nav>
        <a href={`${p}/for-founders`} class="h3-btn h3-btn--sm">{t.nav.cta}</a>
      </div>
    </header>

    <main>
      <!-- 1 · Hero: router with a brand layer -->
      <section class="h3-hero">
        <div class="h3-wrap h3-hero__grid">
          <div class="h3-hero__copy">
            <h1 class="h3-hero__h1">{t.hero.headline}</h1>
            <p class="h3-hero__sub">{t.hero.sub}</p>

            <div class="h3-doors">
              <a href={`${p}/for-founders`} class="h3-door">
                <span class="h3-door__label">
  {t.hero.companies.label}
                </span>
                <span class="h3-door__promise">{t.hero.companies.promise}</span>
                <span class="h3-door__arrow" aria-hidden="true">→</span>
              </a>
              <a href={`${p}/for-talent`} class="h3-door">
                <span class="h3-door__label">
  {t.hero.talent.label}
                </span>
                <span class="h3-door__promise">{t.hero.talent.promise}</span>
                <span class="h3-door__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <figure class="h3-hero__media">
            <picture>
              <source srcset="/brand/team-table.webp" type="image/webp" />
              <img src="/brand/team-table.jpg" alt="" aria-hidden="true" width="1600" height="1066" />
            </picture>
            <span class="h3-hero__scrim" aria-hidden="true"></span>
          </figure>
        </div>
      </section>

      <!-- 2 · Trust strip -->
      <section class="h3-trust">
        <div class="h3-wrap h3-trust__in">
          <p class="h3-eyebrow">{t.trust.label}</p>
          <ul class="h3-trust__logos">
            {clients.map((c) => <li><img src={c.logo} alt={c.name} loading="lazy" /></li>)}
          </ul>
          <p class="h3-trust__evidence">{t.trust.evidence}</p>
        </div>
      </section>

      <!-- 3 · For companies -->
      <section class="h3-co">
        <div class="h3-wrap h3-co__grid">
          <div class="h3-co__left">
            <p class="h3-eyebrow">{t.companies.eyebrow}</p>
            <h2 class="h3-h2">
              {t.companies.headline}<span class="h3-dot h3-dot--end" aria-hidden="true"></span>
            </h2>
            <p class="h3-lead">{t.companies.intro}</p>
            <a href={`${p}/for-founders`} class="h3-btn h3-btn--ink h3-co__cta">
              {t.companies.cta}<span class="h3-arrow" aria-hidden="true">→</span>
            </a>
            <figure class="h3-co__scene">
              <picture>
                <source srcset="/brand/team-meeting.webp" type="image/webp" />
                <img src="/brand/team-meeting.jpg" alt="" aria-hidden="true" width="1600" height="1066" loading="lazy" />
              </picture>
            </figure>
          </div>

          <div class="h3-co__right">
            <p class="h3-body">{t.companies.hard}</p>
            <p class="h3-body">{t.companies.pov}</p>
            <p class="h3-co__evidence">{t.companies.evidence}</p>
            <figure class="h3-quote">
              <div class="h3-quote__portrait">
                <picture>
                  <source srcset="/brand/fabian-torres.webp" type="image/webp" />
                  <img src="/brand/fabian-torres.jpg" alt="Fabián Torres" width="900" height="1200" loading="lazy" />
                </picture>
              </div>
              <div class="h3-quote__text">
                <p class="h3-eyebrow">{t.companies.quoteLabel}</p>
                <blockquote>“{featured.quote}”</blockquote>
                <figcaption>
                  <span class="h3-quote__name">{featured.name}</span>
                  <span class="h3-quote__role">{featured.role}</span>
                </figcaption>
              </div>
            </figure>
          </div>
        </div>
      </section>

      <!-- 4 · For talent -->
      <section class="h3-ta">
        <div class="h3-wrap h3-ta__grid">
          <figure class="h3-ph h3-ph--cat h3-ph--on-dark">
            <figcaption>{t.talent.catNote}</figcaption>
          </figure>
          <div class="h3-ta__copy">
            <p class="h3-eyebrow h3-eyebrow--on-dark">{t.talent.eyebrow}</p>
            <h2 class="h3-h2 h3-h2--on-dark">{t.talent.headline}</h2>
            <p class="h3-lead h3-lead--on-dark">{t.talent.body}</p>
            <p class="h3-body h3-body--on-dark">{t.talent.sub}</p>
            <a href={`${p}/for-talent`} class="h3-btn h3-ta__cta">{t.talent.cta}</a>
            <p class="h3-note">{t.talent.storyNote}</p>
          </div>
        </div>
      </section>

      <!-- 5 · Shared point of view -->
      <section class="h3-belief">
        <div class="h3-wrap">
          <p class="h3-eyebrow">{t.belief.eyebrow}</p>
          <p class="h3-belief__statement">{t.belief.statement}</p>
          <div class="h3-belief__split">
            <p>{t.belief.forCompanies}</p>
            <p>{t.belief.forTalent}</p>
          </div>
        </div>
      </section>

      <!-- 6 · Kate -->
      <section class="h3-kate">
        <div class="h3-wrap h3-kate__grid">
          <figure class="h3-kate__portrait">
            <picture>
              <source srcset="/brand/kate.webp" type="image/webp" />
              <img src="/brand/kate.jpg" alt="Kate Forero" width="1200" height="1525" loading="lazy" />
            </picture>
          </figure>
          <div>
            <p class="h3-eyebrow">{t.kate.eyebrow}</p>
            <h2 class="h3-h2">{t.kate.headline}</h2>
            <p class="h3-body">{t.kate.body}</p>
            <div class="h3-kate__ctas">
              <a href={`${p}/for-founders`} class="h3-link">
                {t.kate.ctaCompanies} <span class="h3-arrow" aria-hidden="true">→</span>
              </a>
              <a href={`${p}/for-talent`} class="h3-link">
                {t.kate.ctaTalent} <span class="h3-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="h3-footer">
      <div class="h3-wrap h3-footer__in">
        <span>{t.footer.legal}</span>
        <nav aria-label="Footer">
          <a href="/privacy-policy">{t.footer.privacy}</a>
          <a href="https://www.linkedin.com/company/purrfect-hire" target="_blank" rel="noopener noreferrer">{t.footer.linkedin}</a>
          <a href="mailto:hiring@purrfecthire.com">hiring@purrfecthire.com</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<style lang="scss" is:global>
  .h3 { position: relative; }
  .h3 {
    --midnight: #0A0B14;
    --sand: #F7F6F3;
    --stone: #E9EBF0;
    --white: #FFFFFF;
    --text: #14161f;
    --muted: #63656f;
    --on-dark: #e8e7e3;
    --on-dark-muted: #9b9ca6;
    --line: rgba(20, 22, 31, 0.1);
    --line-dark: rgba(232, 231, 227, 0.14);
    --purple: #6366F1;
    --purple-deep: #4f46e5;
    --h-serif: 'Fraunces', 'Canela', Georgia, serif;
    --h-sans: 'Inter', system-ui, -apple-system, sans-serif;

    background: var(--sand);
    color: var(--text);
    font-family: var(--h-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  body:has(.h3) { background: #0a0b14; }

  :where(.h3) a { color: inherit; text-decoration: none; }
  :where(.h3) :where(p, h1, h2, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
  :where(.h3) :where(ul, ol) { list-style: none; }
  .h3 a:focus-visible { outline: 2px solid var(--purple); outline-offset: 4px; border-radius: 3px; }

  .h3-wrap { max-width: 80rem; margin-inline: auto; padding-inline: 1.5rem; }
  @media (min-width: 64rem) { .h3-wrap { padding-inline: 3rem; } }

  .h3-eyebrow {
    font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted);
  }
  .h3-eyebrow--on-dark { color: var(--on-dark-muted); }

  /* The signal dot. Purple lives here and on buttons, nowhere else. */
  /* Brand detail: one purple dot, closing a single headline per page. */
  .h3-dot--end {
    display: inline-block; width: 0.34em; height: 0.34em; border-radius: 50%;
    background: var(--purple); margin-left: 0.22em; vertical-align: 0.08em;
  }

  /* Purple is the primary action on Midnight. On light surfaces the
     primary action is Midnight, so the accent stays precise. */
  .h3-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.9rem 1.6rem; border-radius: 999px;
    background: var(--purple); color: #fff !important;
    font-size: 0.9375rem; font-weight: 500; line-height: 1;
    transition: background-color 0.2s ease;
  }
  .h3-btn:hover { background: var(--purple-deep); }
  .h3-btn--sm { padding: 0.6rem 1.1rem; font-size: 0.875rem; }
  .h3-btn--ink { background: var(--midnight); }
  .h3-btn--ink:hover { background: #1b1d2b; }
  .h3-btn--ghost {
    background: transparent; color: var(--text) !important;
    border: 1px solid rgba(20, 22, 31, 0.28);
  }
  .h3-btn--ghost:hover { border-color: var(--text); background: transparent; }
  .h3-arrow { font-size: 0.9em; line-height: 1; }
  .h3-link { font-weight: 500; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
  .h3-link--on-dark { color: var(--on-dark); border-color: var(--line-dark); }
  .h3-link:hover { border-color: currentColor; }

  .h3-h2 {
    font-family: var(--h-serif); font-weight: 400;
    font-variation-settings: 'opsz' 110, 'SOFT' 0, 'WONK' 0;
    font-size: clamp(1.875rem, 3.6vw, 3.5rem); line-height: 1.06; letter-spacing: -0.014em;
    margin-top: 0.9rem; text-wrap: balance;
  }
  .h3-h2--on-dark { color: var(--on-dark); }
  .h3-lead { margin-top: 1.5rem; font-size: 1.25rem; line-height: 1.5; max-width: 30rem; }
  .h3-lead--on-dark { color: var(--on-dark); }
  .h3-body { font-size: 1.125rem; line-height: 1.7; color: var(--muted); max-width: 34rem; }
  .h3-body--on-dark { color: var(--on-dark-muted); }
  .h3-body + .h3-body { margin-top: 1.1rem; }
  .h3-lead + .h3-body { margin-top: 1.15rem; }
  .h3-h2 + .h3-body { margin-top: 1.5rem; }
  .h3-h2 + .h3-lead { margin-top: 1.5rem; }

  /* Clearly marked asset placeholders */
  .h3-ph {
    display: flex; align-items: flex-end; border-radius: 14px;
    background: var(--sand); border: 1px dashed rgba(20, 22, 31, 0.22);
    padding: 1rem; max-width: 100%;
  }
  .h3-ph figcaption {
    font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted); line-height: 1.5;
  }
  .h3-ph--on-dark { background: #161825; border-color: var(--line-dark); }
  .h3-ph--on-dark figcaption { color: var(--on-dark-muted); }
  /* The photograph is part of the dark field: it runs to the right edge and
     dissolves into Midnight, so image and headline read as one composition. */
  .h3-hero__media { position: relative; margin: 0; }
  .h3-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 56rem) {
    .h3-hero__media {
      position: absolute; inset: 0 0 0 50%; z-index: 0;
    }
    .h3-hero__media img { object-position: 60% 40%; }
  }
  @media (max-width: 56rem) {
    .h3-hero__media { margin-top: 2.5rem; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; }
  }
  /* The image reads as part of the dark field, not as a pasted rectangle. */
  .h3-hero__scrim { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  @media (min-width: 56rem) {
    .h3-hero__scrim {
      background:
        linear-gradient(90deg, var(--midnight) 0%, rgba(10, 11, 20, 0.86) 18%, rgba(10, 11, 20, 0.28) 48%, rgba(10, 11, 20, 0.18) 100%),
        linear-gradient(0deg, rgba(10, 11, 20, 0.55) 0%, rgba(10, 11, 20, 0) 35%);
    }
  }
  @media (max-width: 56rem) {
    .h3-hero__scrim {
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(10, 11, 20, 0.45) 0%, rgba(10, 11, 20, 0.05) 40%);
    }
  }
  .h3-ph--cat { aspect-ratio: 1 / 1; }
  .h3-kate__portrait { margin: 0; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 14px; }
  .h3-kate__portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  .h3-ph--portrait {
    aspect-ratio: 3 / 4; width: 100%; padding: 0.6rem; align-items: flex-end;
  }
  .h3-ph__label {
    font-size: 0.5rem; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--muted); line-height: 1.45;
  }

  /* Nav */
  .h3-nav {
    position: absolute; top: env(safe-area-inset-top, 0px); left: 0; right: 0; z-index: 20;
    background: transparent; border-bottom: none;
  }
  .h3-nav__in {
    max-width: 80rem; margin-inline: auto; padding: 0.9rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  }
  @media (min-width: 64rem) { .h3-nav__in { padding-inline: 3rem; } }
  .h3-nav__logo img { height: 1.9rem; width: auto; display: block; filter: brightness(0) invert(1); }
  .h3-nav__links { display: none; gap: 2rem; font-size: 0.9375rem; color: var(--on-dark-muted); }
  .h3-nav__links a:hover { color: var(--on-dark); }
  @media (min-width: 56rem) { .h3-nav__links { display: flex; } }
  .h3-nav .h3-btn--sm { display: none; }
  @media (min-width: 48rem) { .h3-nav .h3-btn--sm { display: inline-flex; } }

  /* 1 · Hero */
  .h3-hero { position: relative; overflow: hidden; background: var(--midnight); color: var(--on-dark); padding: 4.5rem 0 5rem; }
  @media (min-width: 56rem) { .h3-hero { padding: 7rem 0 8rem; } }
  .h3-hero__grid { display: grid; gap: 0; align-items: center; }
  @media (min-width: 56rem) { .h3-hero__grid { grid-template-columns: minmax(0, 36rem) 1fr; } }
  .h3-hero__copy { position: relative; z-index: 2; min-width: 0; }
  .h3-hero__h1 {
    font-family: var(--h-serif); font-weight: 400;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 0;
    font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 1.02; letter-spacing: -0.02em;
    max-width: 15ch; text-wrap: balance;
  }
  .h3-hero__sub {
    margin-top: 2rem; max-width: 36rem; font-size: 1.1875rem;
    line-height: 1.65; color: var(--on-dark-muted);
  }

  .h3-doors { margin-top: 2.75rem; border-top: 1px solid var(--line-dark); }
  .h3-door {
    display: grid; grid-template-columns: 1fr auto; align-items: baseline;
    gap: 0.35rem 1rem; padding: 1.5rem 0;
    border-bottom: 1px solid var(--line-dark); transition: padding-left 0.25s ease;
  }
  .h3-door:hover { padding-left: 0.6rem; }
  .h3-door__label {
    grid-column: 1 / -1; font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-dark-muted);
  }
  .h3-door__promise {
    font-family: var(--h-serif); font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.15; color: var(--on-dark);
  }
  .h3-door__arrow { color: var(--purple); font-size: 1.25rem; }

  /* 2 · Trust */
  .h3-trust { background: var(--sand); padding: 4rem 0 4.5rem; }
  .h3-co { border-top: 1px solid var(--line); }
  .h3-trust__in { text-align: center; }
  .h3-trust__logos {
    margin-top: 1.5rem; display: flex; flex-wrap: wrap; justify-content: center;
    gap: 1.5rem 3rem; align-items: center;
  }
  .h3-trust__logos img {
    height: 1.45rem; width: auto; display: block;
    filter: grayscale(1); opacity: 0.5; transition: opacity 0.2s ease;
  }
  .h3-trust__logos img:hover { opacity: 1; }
  .h3-trust__evidence {
    margin-top: 2.25rem; padding-top: 1.75rem; border-top: 1px solid var(--line);
    font-size: 1rem; font-weight: 500;
  }

  /* 3 · For companies */
  .h3-co { background: var(--sand); padding: 4.5rem 0 5rem; }
  @media (min-width: 56rem) { .h3-co { padding: 7rem 0 8rem; } }
  .h3-co__grid { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 56rem) { .h3-co__grid { grid-template-columns: 1fr 1.1fr; gap: 5.5rem; } }
  .h3-co__left { min-width: 0; }
  @media (min-width: 56rem) { .h3-co__left { position: sticky; top: 7rem; } }
  .h3-co__cta { margin-top: 2rem; }
  .h3-co__scene { margin: 2.75rem 0 0; aspect-ratio: 16 / 10; overflow: hidden; }
  .h3-co__scene img { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 56rem) { .h3-co__left { position: static; } }
  .h3-co__right { min-width: 0; }
  .h3-co__evidence { margin-top: 1.5rem; font-size: 1.125rem; font-weight: 500; }
  .h3-quote {
    margin-top: 3rem; padding-top: 2.25rem; border-top: 1px solid var(--line);
    display: grid; gap: 1.5rem; align-items: start;
  }
  @media (min-width: 40rem) { .h3-quote { grid-template-columns: 11rem 1fr; gap: 2.25rem; } }
  .h3-quote__portrait { max-width: 11rem; border-radius: 12px; overflow: hidden; }
  .h3-quote__portrait img { display: block; width: 100%; height: auto; }
  .h3-quote__text { min-width: 0; }
  .h3-quote blockquote {
    margin-top: 0.85rem; font-family: var(--h-serif);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem); line-height: 1.3;
  }
  .h3-quote figcaption { margin-top: 1.1rem; display: flex; flex-direction: column; font-size: 0.9375rem; }
  .h3-quote__name { font-weight: 500; }
  .h3-quote__role { color: var(--muted); }

  /* 4 · For talent */
  .h3-ta { background: var(--midnight); color: var(--on-dark); padding: 5rem 0; }
  @media (min-width: 56rem) { .h3-ta { padding: 8rem 0; } }
  .h3-ta__grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 56rem) { .h3-ta__grid { grid-template-columns: 0.8fr 1.2fr; gap: 5.5rem; } }
  .h3-ta__copy { min-width: 0; }
  .h3-ta__cta { margin-top: 2rem; }
  .h3-note {
    margin-top: 1.75rem; font-size: 0.6875rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--on-dark-muted);
    border-left: 1px dashed var(--line-dark); padding-left: 0.85rem; line-height: 1.6;
  }

  /* 5 · Belief */
  .h3-belief { background: var(--stone); padding: 4.5rem 0; }
  @media (min-width: 56rem) { .h3-belief { padding: 7rem 0; } }
  .h3-belief__statement {
    margin-top: 1.25rem; max-width: 30ch; font-family: var(--h-serif);
