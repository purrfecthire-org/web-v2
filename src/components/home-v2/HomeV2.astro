---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getHomeV2 } from '../../content/homeV2';
import ClientLogoReel from '../v2/ClientLogoReel.astro';
import { PAGE_COMPANIES, PAGE_TALENT } from '../../content/links';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getHomeV2(lang);
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="light" journey="home">
  <section class="h3-hero home-entry h3-editorial-hero" aria-labelledby="home-title">
    <picture class="home-entry__background">
      <source media="(max-width: 55.99rem)" srcset="/photos/editorial/timber-courtyard-mobile.webp" type="image/webp" />
      <img src="/photos/editorial/timber-courtyard-desktop.webp" alt={t.hero.photoAlt} width="1536" height="1024" decoding="async" fetchpriority="high" />
    </picture>
    <video class="home-entry__motion" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" data-desktop-src="/motion/timber-courtyard-desktop.mp4" data-mobile-src="/motion/timber-courtyard-mobile.mp4"></video>
    <div class="h3-wrap">
      <div class="home-entry__intro h3-hero__copy">
          <h1 class="h3-hero__h1" id="home-title">{t.hero.headline}</h1>
          <p class="h3-hero__sub">{t.hero.sub}</p>
        <nav class="home-paths" id="choose-your-path" aria-label={t.hero.choose}>
          <a class="h3-btn home-path" href={PAGE_COMPANIES} data-cta="home-choose-companies">
            <span>{t.hero.companies.label}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
          <a class="h3-btn home-path" href={PAGE_TALENT} data-cta="home-choose-talent">
            <span>{t.hero.talent.label}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      </div>
    </div>
    <button class="home-entry__motion-control" type="button" aria-label="Pause background motion" aria-pressed="false" hidden>
      <svg class="home-entry__pause-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zm7 0h3v14h-3z" /></svg>
      <svg class="home-entry__play-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
    </button>
  </section>

  <section class="home-proof h3-surface" id="clients" aria-labelledby="home-proof-label">
    <div class="h3-wrap home-proof__grid">
      <div>
        <h2 class="h3-h2" id="home-proof-label">{t.proof.eyebrow}</h2>
        <p class="home-proof__geography">{t.hero.eyebrow}</p>
      </div>
        <ClientLogoReel id="home-clients" />
    </div>
  </section>

  <section class="home-kate h3-surface" id="kate" aria-labelledby="kate-title">
    <div class="h3-wrap">
      <div class="home-kate__grid">
        <figure class="home-kate__portrait">
          <picture>
            <source srcset="/brand/kate.webp" type="image/webp" />
            <img src="/brand/kate.jpg" alt="Kate Forero" width="900" height="1124" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div class="home-kate__copy">
          <p class="h3-eyebrow">{t.kate.eyebrow}</p>
          <h2 class="h3-h2" id="kate-title">{t.kate.headline}</h2>
          <p class="h3-body">{t.kate.body}</p>
          <a href="https://www.linkedin.com/in/kathforero/" target="_blank" rel="noopener noreferrer" class="h3-link home-kate__meet" data-cta="home-meet-kate">Meet Kate <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Shell>

<script>
  // The photograph remains the LCP and no-JavaScript fallback. This loop only
  // animates camera framing over that same illustrative still image.
  const hero = document.querySelector<HTMLElement>('.home-entry');
  const video = hero?.querySelector<HTMLVideoElement>('.home-entry__motion');
  const control = hero?.querySelector<HTMLButtonElement>('.home-entry__motion-control');
  const poster = hero?.querySelector<HTMLImageElement>('.home-entry__background img');
  if (hero && video && control && poster && 'IntersectionObserver' in window) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 55.99rem)');
    const connection = (navigator as Navigator & {
      connection?: EventTarget & { saveData?: boolean };
    }).connection;
    let pageReady = false;
    let inView = false;
    let userPaused = false;
    let failed = false;
    let currentSource = '';
    let playPending = false;

    const updateControl = () => {
      control.setAttribute('aria-pressed', String(userPaused));
      control.setAttribute('aria-label', userPaused ? 'Play background motion' : 'Pause background motion');
    };
    const usePoster = () => {
      video.pause();
      video.classList.remove('is-ready');
      control.hidden = true;
      if (currentSource) {
        currentSource = '';
        video.removeAttribute('src');
        video.load();
      }
    };
    const syncPlayback = () => {
      if (!pageReady || reducedMotion.matches || connection?.saveData || failed) {
        usePoster();
        return;
      }
      const source = mobile.matches ? video.dataset.mobileSrc! : video.dataset.desktopSrc!;
      if (currentSource && currentSource !== source) {
        video.pause();
        video.classList.remove('is-ready');
        currentSource = '';
        video.removeAttribute('src');
        video.load();
      }
      if (!inView || document.hidden || userPaused) {
        video.pause();
        return;
      }
      if (currentSource !== source) {
        video.classList.remove('is-ready');
        control.hidden = true;
        currentSource = source;
        video.src = source;
        video.load();
      }
      if (video.paused && !playPending) {
        playPending = true;
        video.play().catch(() => {
          // Autoplay restrictions must leave a usable poster and manual control.
          if (currentSource === source && inView && !document.hidden && !reducedMotion.matches && !connection?.saveData && !failed) {
            userPaused = true;
            control.hidden = false;
            updateControl();
          }
        }).finally(() => {
          playPending = false;
          // A viewport or visibility change may have interrupted the request.
          if (!video.paused || userPaused) return;
          syncPlayback();
        });
      }
    };
    video.muted = true;
    video.addEventListener('playing', () => {
      if (reducedMotion.matches || connection?.saveData || !inView || document.hidden || userPaused) {
        video.pause();
        return;
      }
      video.classList.add('is-ready');
      control.hidden = false;
      updateControl();
    });
    video.addEventListener('error', () => {
      if (currentSource) {
        failed = true;
        usePoster();
      }
    });
    control.addEventListener('click', () => {
      userPaused = !userPaused;
      updateControl();
      syncPlayback();
    });
    reducedMotion.addEventListener('change', syncPlayback);
    mobile.addEventListener('change', syncPlayback);
    connection?.addEventListener('change', syncPlayback);
    document.addEventListener('visibilitychange', syncPlayback);
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncPlayback();
    }, { threshold: 0.1 }).observe(hero);
    const start = () => {
      const ready = () => {
        pageReady = true;
        syncPlayback();
      };
      // Finish the poster and page before requesting either video variant.
      if (poster.complete) ready();
      else poster.addEventListener('load', ready, { once: true });
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>

<style>
  .home-entry { isolation: isolate; display: flex; align-items: center; min-height: clamp(43rem, 52vw, 53rem); padding-block: calc(var(--space-hero-top) + var(--space-3)) var(--space-8); }
  .home-entry > .h3-wrap { width: 100%; }
  .home-entry__background { display: block; position: absolute; inset: 0; z-index: -3; }
  .home-entry__background img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; }
  .home-entry__motion { display: block; position: absolute; inset: 0; z-index: -3; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; opacity: 0; pointer-events: none; }
  .home-entry__motion.is-ready { opacity: 1; }
  .home-entry__motion-control { display: inline-flex; align-items: center; justify-content: center; position: absolute; left: var(--space-3); bottom: var(--space-3); z-index: 3; box-sizing: border-box; width: var(--space-6); height: var(--space-6); padding: 0; border: 1px solid var(--line); border-radius: 999px; background: rgba(247,246,243,.94); color: var(--text); font: 500 var(--type-caption)/1.5 var(--h-sans); cursor: pointer; }
  .home-entry__motion-control[hidden] { display: none; }
  .home-entry__motion-control:hover { background: var(--white); }
  .home-entry__motion-control:active { background: var(--stone); }
  .home-entry__motion-control svg { flex: none; }
  .home-entry__play-icon, .home-entry__motion-control[aria-pressed="true"] .home-entry__pause-icon { display: none; }
  .home-entry__motion-control[aria-pressed="true"] .home-entry__play-icon { display: block; }
  .home-entry.h3-editorial-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; opacity: 1; mix-blend-mode: normal; pointer-events: none; background: linear-gradient(90deg, rgba(247,246,243,.97) 0%, rgba(247,246,243,.91) 35%, rgba(247,246,243,.54) 53%, rgba(247,246,243,.03) 78%), linear-gradient(0deg, var(--sand), rgba(247,246,243,0) 28%); }
  .home-entry::after { content: ''; position: absolute; inset: 0 0 auto; height: calc(var(--space-hero-top) + var(--space-4)); z-index: -1; background: linear-gradient(rgba(247,246,243,.96),rgba(247,246,243,.7) 45%,transparent); }
  .home-entry__intro { max-width: 34rem; }
  .home-entry .h3-hero__h1 { max-width: 15ch; margin-top: 0; }
  .home-entry .h3-hero__sub { max-width: 36ch; margin-top: var(--space-3); color: var(--muted); }
  .home-entry .h3-eyebrow { color: var(--purple); }
  .home-paths { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); scroll-margin-top: var(--space-stack); }
  .home-path { justify-content: space-between; gap: var(--space-3); min-height: var(--space-6); padding-inline: var(--space-3); }
  .home-path:hover { background: var(--purple-deep); }
  .home-path:active { opacity: .8; }
  .home-path__arrow { font-size: var(--type-subheading); line-height: 1; }
  @media (max-width: 37.49rem) { .home-path { width: 100%; } }
  .home-proof, .home-kate { background: var(--sand); padding-block: var(--space-section); }
  .home-proof__grid { display: grid; gap: var(--space-grid); }
  .home-proof .h3-h2 { max-width: none; }
  .home-proof__geography { margin-top: var(--space-2); color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }
  .home-kate { border-top: 1px solid var(--line); }
  .home-kate .h3-eyebrow { color: var(--purple); }
  .home-kate__grid { display: grid; gap: var(--space-grid); align-items: center; }
  .home-kate__portrait { width: 100%; max-width: 10rem; margin: 0; border-radius: var(--radius-card); overflow: hidden; }
  .home-kate__portrait img { display: block; width: 100%; height: auto; }
  .home-kate__copy { min-width: 0; }
  .home-kate__copy .h3-body { max-width: 52ch; }
  .home-kate__meet { margin-top: var(--space-stack); }
  @media (min-width: 56rem) {
    .home-entry__motion-control { left: var(--space-6); bottom: var(--space-4); }
    .home-kate__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .home-kate__portrait { justify-self: center; }
  }
  @media (max-width: 55.99rem) {
    .home-entry { min-height: 38rem; }
    .home-entry.h3-editorial-hero::before { background: linear-gradient(90deg, rgba(247,246,243,.97), rgba(247,246,243,.85) 58%, rgba(247,246,243,.6)), linear-gradient(0deg, var(--sand), rgba(247,246,243,0) 35%); }
    .home-entry__intro { max-width: 29rem; }
  }
  @media (max-width: 30rem) {
    .home-entry { min-height: 35rem; }
    .home-entry.h3-editorial-hero::before { background: linear-gradient(rgba(247,246,243,.88), rgba(247,246,243,.86) 60%, var(--sand)); }
    .home-entry__motion-control { bottom: var(--space-1); }
  }
  @media (prefers-reduced-motion: reduce) { .home-path { transition: none; } .home-entry__motion, .home-entry__motion-control { display: none; } }
</style>
