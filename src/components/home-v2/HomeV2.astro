---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getHomeV2 } from '../../content/homeV2';
import ClientLogoReel from '../v2/ClientLogoReel.astro';
import { team } from '../../content/team';
import { PAGE_COMPANIES, PAGE_TALENT, BOOKING_B2B } from '../../content/links';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getHomeV2(lang);

---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="dark" navCta={{ label: t.hero.bookingCta, href: BOOKING_B2B }} journey="home">
  <section class="h3-hero home-entry" aria-labelledby="home-title">
    <div class="h3-wrap h3-hero__grid">
      <div class="h3-hero__copy">
        <p class="h3-eyebrow h3-eyebrow--on-dark">{t.hero.eyebrow}</p>
        <h1 class="h3-hero__h1" id="home-title">{t.hero.headline}</h1>
        <p class="h3-hero__sub">{t.hero.sub}</p>
      </div>
      <figure class="home-people" aria-label={team.label}>
        {team.people.map(person => <img src={person.src} alt={person.name} width={person.width} height={person.height} style={{'object-position':person.position}} decoding="async" />)}
      </figure>
        <nav class="home-paths" id="choose-your-path" aria-label={t.hero.choose}>
          <a class="home-path" href={PAGE_COMPANIES} data-cta="home-choose-companies">
            <span class="home-path__label">{t.hero.companies.label}</span>
            <span class="home-path__promise">{t.hero.companies.promise}</span>
            <span class="home-path__detail">{t.hero.companies.detail}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
          <a class="home-path" href={PAGE_TALENT} data-cta="home-choose-talent">
            <span class="home-path__label">{t.hero.talent.label}</span>
            <span class="home-path__promise">{t.hero.talent.promise}</span>
            <span class="home-path__detail">{t.hero.talent.detail}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
        </nav>
    </div>
  </section>

  <section class="home-proof" aria-labelledby="home-proof-label">
    <div class="h3-wrap">
      <p class="h3-eyebrow" id="home-proof-label">{t.proof.eyebrow}</p>
      <div class="home-proof__grid">
      <ClientLogoReel id="home-clients" />
      <div class="home-proof__voice">
        <figure>
          <blockquote>“{t.proof.quote}”</blockquote>
          <figcaption><span>{t.proof.name}</span><span>{t.proof.role}</span></figcaption>
        </figure>

      </div>
      </div>
    </div>
  </section>

  <section class="home-kate" id="kate" aria-labelledby="kate-title">
    <div class="h3-wrap home-kate__grid">
      <figure class="home-kate__portrait">
        <picture>
          <source srcset="/brand/kate.webp" type="image/webp" />
          <img src="/brand/kate.jpg" alt="Kate Forero" width="900" height="1124" loading="lazy" />
        </picture>
      </figure>
      <div>
        <p class="h3-eyebrow">{t.kate.eyebrow}</p>
        <h2 class="h3-h2" id="kate-title">{t.kate.headline}</h2>
        <p class="h3-body">{t.kate.body}</p>
        <a href="https://www.linkedin.com/in/kathforero/" target="_blank" rel="noopener noreferrer" class="h3-link home-kate__meet" data-cta="home-meet-kate">Meet Kate <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Shell>

<style>
  .home-entry { padding-bottom: var(--space-section); }
  .home-entry .h3-hero__grid { align-items: center; gap: var(--space-grid); }
  .home-entry .h3-hero__h1 { max-width: 18ch; }
  .home-people { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: var(--space-3); align-items: center; justify-items: center; width: 100%; max-width: 30rem; padding: var(--space-4); box-sizing: border-box; border-radius: var(--radius-card); background: var(--sand); margin-inline: auto; order: 2; }
  .home-people img { width: 100%; aspect-ratio: 1; height: auto; object-fit: cover; border-radius: 50%; }
  .home-people img:nth-child(3n + 2) { width: 80%; }
  .home-people img:nth-child(3), .home-people img:nth-child(4) { width: 64%; }
  .home-paths { display: grid; order: 1; gap: var(--space-grid); scroll-margin-top: var(--space-stack); }
  .home-path { position: relative; display: grid; gap: var(--space-1); padding: var(--space-3) var(--space-4) var(--space-3) 0; border-block: 1px solid var(--line-dark); }
  .home-path:hover { border-color: var(--on-dark); }
  .home-path__label { color: var(--on-dark); font-size: var(--type-caption); font-weight: 500; }
  .home-path__promise { color: var(--on-dark); font-size: var(--type-subheading); font-weight: 500; line-height: 1.35; }
  .home-path__detail { color: var(--on-dark-muted); font-size: var(--type-caption); }
  .home-path__arrow { position: absolute; right: 0; top: 50%; color: var(--on-dark); transform: translateY(-50%); }
  .home-proof, .home-kate { background: var(--sand); padding-block: var(--space-section); }
  .home-proof__grid { display: grid; align-items: center; gap: var(--space-grid); margin-top: var(--space-stack); }
  .home-proof__voice blockquote { max-width: 48ch; font-size: var(--type-quote); line-height: 1.55; color: var(--text); }
  .home-proof__voice figcaption { margin-top: var(--space-2); display: grid; gap: var(--space-1); font-size: var(--type-caption); color: var(--muted); }
  .home-proof__voice figcaption span:first-child { font-weight: 500; color: var(--text); }
  .home-kate__grid { display: grid; gap: var(--space-grid); align-items: center; }
  .home-kate__portrait { max-width: 14rem; border-radius: var(--radius-card); overflow: hidden; }
  .home-kate__portrait img { display: block; width: 100%; height: auto; }
  .home-kate__meet { margin-top: var(--space-stack); }
  @media (min-width: 56rem) {
    .home-entry .h3-hero__grid { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
    .home-people { order: 0; }
    .home-paths { grid-column: 1/-1; grid-template-columns: repeat(2,minmax(0,1fr)); }
    .home-proof__grid { grid-template-columns: 12rem minmax(0,1fr); gap: var(--space-section); }
    .home-kate__grid { grid-template-columns: 14rem minmax(0,1fr); gap: var(--space-section); }
  }
</style>
