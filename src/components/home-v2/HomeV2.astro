---
import Shell from '../v2/Shell.astro';
import type { Lang } from '../../content/index';
import { getHomeV2 } from '../../content/homeV2';
import ClientLogoReel from '../v2/ClientLogoReel.astro';
import { PAGE_COMPANIES, PAGE_TALENT } from '../../content/links';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = getHomeV2(lang);
---

<Shell lang={lang} title={t.meta.title} description={t.meta.description} theme="light" journey="home">
  <section class="h3-hero home-entry" aria-labelledby="home-title">
    <picture class="home-entry__background">
      <source media="(max-width: 55.99rem)" srcset="/photos/editorial/city-courtyard-mobile.webp" type="image/webp" />
      <img src="/photos/editorial/city-courtyard-desktop.webp" alt={t.hero.photoAlt} width="1536" height="1024" decoding="async" fetchpriority="high" />
    </picture>
    <div class="h3-wrap">
      <div class="home-entry__intro h3-hero__copy">
          <p class="h3-eyebrow">{t.hero.eyebrow}</p>
          <h1 class="h3-hero__h1" id="home-title">{t.hero.headline}</h1>
          <p class="h3-hero__sub">{t.hero.sub}</p>
        <nav class="home-paths" id="choose-your-path" aria-label={t.hero.choose}>
          <a class="home-path" href={PAGE_COMPANIES} data-cta="home-choose-companies">
            <span>{t.hero.companies.label}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
          <a class="home-path" href={PAGE_TALENT} data-cta="home-choose-talent">
            <span>{t.hero.talent.label}</span>
            <span class="home-path__arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <section class="home-proof" id="clients" aria-labelledby="home-proof-label">
    <div class="h3-wrap home-proof__grid">
      <h2 class="h3-h2" id="home-proof-label">{t.proof.eyebrow}</h2>
        <ClientLogoReel id="home-clients" />
    </div>
  </section>

  <section class="home-kate" id="kate" aria-labelledby="kate-title">
    <div class="h3-wrap">
      <div class="home-kate__grid">
        <figure class="home-kate__portrait">
          <picture>
            <source srcset="/brand/kate.webp" type="image/webp" />
            <img src="/brand/kate.jpg" alt="Kate Forero" width="900" height="1124" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div class="home-kate__copy">
          <p class="h3-eyebrow">{t.kate.eyebrow}</p>
          <h2 class="h3-h2" id="kate-title">{t.kate.headline}</h2>
          <p class="h3-body">{t.kate.body}</p>
          <a href="https://www.linkedin.com/in/kathforero/" target="_blank" rel="noopener noreferrer" class="h3-link home-kate__meet" data-cta="home-meet-kate">Meet Kate <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Shell>

<style>
  .home-entry { isolation: isolate; min-height: 56rem; padding-top: var(--space-hero-top); }
  .home-entry__background { display: block; position: absolute; inset: 0; z-index: -3; }
  .home-entry__background img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; }
  .home-entry::before { content: ''; position: absolute; inset: 0; z-index: -2; background: linear-gradient(rgba(247,246,243,.65),rgba(247,246,243,.5) 48%,transparent 72%); }
  .home-entry::after { content: ''; position: absolute; inset: 0 0 auto; height: 9rem; z-index: -1; background: linear-gradient(rgba(247,246,243,.96),rgba(247,246,243,.76) 50%,transparent); }
  .home-entry__intro { max-width: 40rem; }
  .home-entry .h3-hero__h1 { max-width: 18ch; }
  .home-entry .h3-hero__sub { max-width: 43ch; margin-top: var(--space-stack); color: var(--text); }
  .home-entry .h3-eyebrow { color: var(--text); }
  .home-paths { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); scroll-margin-top: var(--space-stack); }
  .home-path { display: inline-flex; align-items: center; justify-content: space-between; gap: var(--space-stack); min-height: 3rem; padding: .75rem var(--space-stack); border: 1px solid rgba(20,22,31,.55); border-radius: 999px; background: rgba(247,246,243,.94); font-size: var(--type-ui); font-weight: 500; line-height: 1.4; transition: color .2s ease, background-color .2s ease; }
  .home-path:hover { background: var(--midnight); color: var(--sand); }
  .home-path:active { opacity: .8; }
  .home-path__arrow { font-size: var(--type-subheading); line-height: 1; }
  @media (max-width: 37.49rem) { .home-path { width: 100%; } }
  .home-proof, .home-kate { background: var(--sand); padding-block: var(--space-section); }
  .home-proof__grid { display: grid; align-items: center; gap: var(--space-grid); }
  .home-proof .h3-h2 { max-width: 18ch; }
  .home-kate__grid { display: grid; gap: var(--space-grid); align-items: center; }
  .home-kate__portrait { width: 100%; max-width: 10rem; margin: 0; border-radius: var(--radius-card); overflow: hidden; }
  .home-kate__portrait img { display: block; width: 100%; height: auto; }
  .home-kate__copy { min-width: 0; }
  .home-kate__copy .h3-body { max-width: 52ch; }
  .home-kate__meet { margin-top: var(--space-stack); }
  @media (min-width: 56rem) {
    .home-entry { min-height: 54rem; padding-top: calc(var(--space-hero-top) + var(--space-8)); }
    .home-entry::before { background: linear-gradient(90deg,rgba(247,246,243,.7),rgba(247,246,243,.38) 37%,transparent 63%); }
    .home-proof__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-section); }
    .home-kate__grid { grid-template-columns: minmax(0, .65fr) minmax(0, 1.35fr); }
    .home-kate__portrait { justify-self: center; }
  }
  @media (min-width: 90rem) { .home-entry__intro { max-width: 42.5rem; } }
  @media (min-width: 112rem) { .home-entry { min-height: 60rem; } }
  @media (prefers-reduced-motion: reduce) { .home-path { transition: none; } }
</style>
