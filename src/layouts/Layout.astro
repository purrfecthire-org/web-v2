---
import '../styles/tailwind.css';
import '../styles/global.scss';
import { SOCIAL_LINKS } from '../content/links';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  /** Design-test pages: keep out of search results */
  noindex?: boolean;
  /**
   * The four commercial pages ship Fraunces + Inter from their own shell.
   * Only the pages still on the previous system need Schibsted Grotesk, so
   * they are the only ones that pay for the request.
   */
  legacyFonts?: boolean;
  /** Set only on pages that genuinely exist in both languages. */
  hasAlternateLang?: boolean;
  /**
   * Absolute URL for og:image / twitter:image. B2C pages (career-sessions,
   * momentum, /kate) must pass the Kate photo: shared over WhatsApp they
   * should show her face, not the logo (visual spec §5).
   */
  ogImage?: string;
}

const {
  title = 'Purrfect Hire | Senior hires for YC, a16z and Sequoia founders',
  description = 'Senior hires for startups between seed and Series B. Evidence on every candidate.',
  lang = 'en',
  canonicalUrl,
  noindex = false,
  legacyFonts = true,
  hasAlternateLang = false,
  ogImage = 'https://purrfecthire.com/brand/og-default.png',
} = Astro.props;

const siteUrl = 'https://purrfecthire.com';
const currentUrl = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
const alternateLang = lang === 'en' ? 'es' : 'en';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Purrfect Hire', legalName: 'Purrfect Hire OÜ', url: siteUrl, email: 'go@purrfecthire.com', logo: `${siteUrl}/brand/logo/logo-horizontal-midnight.svg`, sameAs: SOCIAL_LINKS.map((social) => social.href) },
    { '@type': 'ProfessionalService', '@id': `${siteUrl}/#search-service`, name: 'Purrfect Hire Search', url: `${siteUrl}/for-companies`, parentOrganization: { '@id': `${siteUrl}/#organization` }, description: 'Senior and executive search for venture-backed companies.', areaServed: ['United States', 'Europe', 'Latin America'] },
  ],
};
// Point at the same document in the other language, not at the other home page.
const path = Astro.url.pathname;
const alternateUrl =
  lang === 'en'
    ? `${siteUrl}/es${path}`
    : `${siteUrl}${path.replace(/^\/es/, '') || '/'}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical, and hreflang only where a translation really exists -->
    <link rel="canonical" href={currentUrl} />
    {hasAlternateLang && (
      <Fragment>
        <link rel="alternate" hreflang={lang} href={currentUrl} />
        <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
      </Fragment>
    )}
    {hasAlternateLang && <link rel="alternate" hreflang="x-default" href={lang === 'en' ? currentUrl : alternateUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content="Purrfect Hire" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon-optical.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    {legacyFonts && (
      <Fragment>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500&display=swap"
          rel="stylesheet"
        />
      </Fragment>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema).replace(/</g, '\\u003c')} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      // Analytics — flag-gated by PUBLIC_ANALYTICS_SRC. Unset (the default)
      // means no analytics script or measurement requests are added.
      //
      // Plausible now issues a snippet per site, so the script URL comes from
      // Site Installation in the account and is pasted into the env var: it
      // cannot be hardcoded here. The newer script also exposes plausible.init()
      // and no longer documents data-domain, while the older one reads
      // data-domain and drains a window.plausible queue. This handles both:
      // init() is called when it exists, data-domain is only set when the env
      // var provides one, and queued clicks are flushed by us on script load
      // rather than relying on the provider draining them.
      //
      // Pageviews are captured by the script. On top of that, every primary
      // action carries data-cta and every page carries data-journey, so
      // Companies, Talent and Offer are counted apart. Only those two values
      // are ever sent: no emails, no form fields, no advisory data.
      const A_SRC = import.meta.env.PUBLIC_ANALYTICS_SRC;
      const A_DOMAIN = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
      if (A_SRC) {
        try {
          type Ev = [string, { props: Record<string, string> }];
          const pending: Ev[] = [];
          const w = window as unknown as {
            plausible?: { (...a: unknown[]): void; init?: (o?: unknown) => void; q?: unknown[] };
          };

          const send = (...e: Ev) => {
            if (typeof w.plausible === 'function') w.plausible(...e);
            else pending.push(e);
          };

          const el = document.createElement('script');
          el.defer = true;
          el.src = String(A_SRC);
          if (A_DOMAIN) el.setAttribute('data-domain', String(A_DOMAIN));
          el.addEventListener('load', () => {
            try {
              // Present on the per-site script, absent on the older one.
              w.plausible?.init?.();
            } catch {
              /* init is optional */
            }
            try {
              while (pending.length) w.plausible?.(...(pending.shift() as Ev));
            } catch {
              /* a dropped metric is not worth an error */
            }
          });
          document.head.appendChild(el);

          const journey =
            document.querySelector('[data-journey]')?.getAttribute('data-journey') ?? 'unknown';

          if (journey === 'companies') send('company_page_view', { props: { journey } });
          window.addEventListener('purrfect:funnel', (event) => {
            const name = (event as CustomEvent<{ name: string }>).detail?.name;
            if (['search_form_started', 'search_form_submitted', 'calendar_viewed', 'offer_inquiry_started', 'offer_inquiry_submitted'].includes(name)) send(name, { props: { journey } });
          });

          document.addEventListener('click', (e) => {
            try {
              const a = (e.target as HTMLElement)?.closest?.('[data-cta]');
              if (!a) return;
              const name = a.getAttribute('data-cta');
              if (!name) return;
              send('cta', { props: { cta: name, journey } });
              if (a instanceof HTMLAnchorElement && new URL(a.href).pathname === '/search-read') send('search_read_cta_click', { props: { cta: name, journey } });
            } catch {
              /* measurement must never break a click */
            }
          });
        } catch {
          /* analytics must never break the page */
        }
      }
    </script>
    <script>
      const campaign = new URLSearchParams(location.search);
      const allowed = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        const url = new URL(link.href);
        if (url.origin !== location.origin || url.pathname === location.pathname) continue;
        let copied = false;
        for (const key of allowed) { const value = campaign.get(key); if (value && /^[a-zA-Z0-9_. -]{1,100}$/.test(value)) { url.searchParams.set(key, value); copied = true; } }
        if (copied) url.searchParams.set('entry_path', campaign.get('entry_path') || location.pathname);
        if (copied) link.href = url.href;
      }
    </script>
    <script>
      // Shared scroll-reveal: a single observer toggles `.visible` on every
      // `.reveal` element on the page, so individual sections no longer ship
      // their own IntersectionObserver. Honors prefers-reduced-motion via CSS.
      const revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length) {
        const io = new IntersectionObserver((entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              obs.unobserve(entry.target);
            }
          }
        }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
    <script>
      // Client-side error reporter — flag-gated by PUBLIC_LOG_ENDPOINT.
      // When the env var is unset/empty (the default) this whole block no-ops:
      // no listeners do network work and the site stays 100% static/offline.
      // Contract: POST {PUBLIC_LOG_ENDPOINT}/logs/client with
      // { entries: [{ level, message, source: "portal", context?, url?, occurred_at? }] }
      // Fire-and-forget; max 5 reports per page load; dedups identical messages.
      // No PII, no cookies, no form data — only error metadata + userAgent.
      const LOG_ENDPOINT = import.meta.env.PUBLIC_LOG_ENDPOINT;
      if (LOG_ENDPOINT) {
        const seen = new Set<string>();
        let sent = 0;
        const report = (message: unknown, context: Record<string, unknown>) => {
          try {
            if (sent >= 5) return;
            const msg = String(message ?? 'Unknown error').slice(0, 2000);
            if (seen.has(msg)) return;
            seen.add(msg);
            sent++;
            const body = JSON.stringify({
              entries: [
                {
                  level: 'error',
                  message: msg,
                  source: 'portal',
                  url: `${location.origin}${location.pathname}`,
                  occurred_at: new Date().toISOString(),
                  context: { ...context, userAgent: navigator.userAgent },
                },
              ],
            });
            const url = `${String(LOG_ENDPOINT).replace(/\/+$/, '')}/logs/client`;
            const beaconOk =
              typeof navigator.sendBeacon === 'function' &&
              navigator.sendBeacon(url, new Blob([body], { type: 'application/json' }));
            if (!beaconOk) {
              fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body,
                keepalive: true,
              }).catch(() => {});
            }
          } catch {
            /* reporter must never break the page */
          }
        };
        window.addEventListener('error', (e) => {
          try {
            const err = e.error;
            report(err instanceof Error ? err.message : e.message, {
              filename: e.filename,
              lineno: e.lineno,
              colno: e.colno,
              stack:
                err instanceof Error && typeof err.stack === 'string'
                  ? err.stack.slice(0, 1500)
                  : undefined,
            });
          } catch {
            /* no-op */
          }
        });
        window.addEventListener('unhandledrejection', (e) => {
          try {
            const r = e.reason;
            report(r instanceof Error ? r.message : String(r), {
              stack:
                r instanceof Error && typeof r.stack === 'string'
                  ? r.stack.slice(0, 1500)
                  : undefined,
            });
          } catch {
            /* no-op */
          }
        });
      }
    </script>
  </body>
</html>
